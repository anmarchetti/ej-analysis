<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Cake.Services</id>
    <version>1.0.1</version>
    <title>Cake.Services</title>
    <authors>Phillip Sharpe</authors>
    <owners>Phillip Sharpe</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/SharpeRAD/Cake.Services/LICENSE</licenseUrl>
    <projectUrl>https://github.com/SharpeRAD/Cake.Services</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/cake-contrib/graphics/png/cake-contrib-medium.png</iconUrl>
    <description>Cake Build addon for Windows services.</description>
    <summary>Windows services addon for cake build.</summary>
    <releaseNotes>Initial Release[Improvement] Add cake tag</releaseNotes>
    <copyright>Copyright (c) 2015 - 2021 Phillip Sharpe</copyright>
    <tags>Cake cake-addin Script Build WindowsService</tags>
    <dependencies>
      <group>
        <dependency id="Cake.Powershell" version="1.0.0" />
      </group>
      <group targetFramework=".NETCoreApp3.1">
        <dependency id="System.ServiceProcess.ServiceController" version="6.0.0-preview.1.21102.12" />
      </group>
      <group targetFramework="net5.0">
        <dependency id="System.ServiceProcess.ServiceController" version="6.0.0-preview.1.21102.12" />
      </group>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="System.ServiceProcess.ServiceController" version="6.0.0-preview.1.21102.12" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework=".NETFramework4.6">
        <frameworkReference name="System.ServiceProcess" />
      </group>
    </frameworkReferences>
  </metadata>
</package>