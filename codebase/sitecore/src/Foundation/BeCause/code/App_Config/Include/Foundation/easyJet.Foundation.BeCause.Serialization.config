<?xml version="1.0" encoding="utf-8" ?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/"
               xmlns:role="http://www.sitecore.net/xmlconfig/role/"
               xmlns:unicorn="http://www.sitecore.net/xmlconfig/unicorn/">
    <sitecore role:require="Standalone or ContentManagement" unicorn:require="On">
        <unicorn>
            <configurations>
                <configuration name="Foundation.BeCause" dependencies="Foundation.Serialization" extends="Helix.Foundation">
                    <predicate type="Unicorn.Predicates.SerializationPresetPredicate, Unicorn" singleInstance="true">
                        <include database="master" name="BeCause.Templates" path="/sitecore/templates/Foundation/BeCause"/>
                        <include name="Core.ContextMenues.EcoCertificateSynchronisation" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Eco Certificates" />
                        <include name="Core.ContextMenues.EcoCertificateSynchronisation.Devider4" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Divider 4" />
                        <include name="BeCause.Tasks.Commands" database="master" path="/sitecore/system/Tasks/Commands/Foundation/BeCause"/>
                        <include name="BeCause.Tasks.Schedules" database="master" path="/sitecore/system/Tasks/Schedules/Foundation/BeCause"/>
                    </predicate>
                </configuration>
            </configurations>
        </unicorn>
    </sitecore>
</configuration>
