<?xml version="1.0" encoding="utf-8" ?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/"
               xmlns:role="http://www.sitecore.net/xmlconfig/role/"
               xmlns:unicorn="http://www.sitecore.net/xmlconfig/unicorn/">
    <sitecore role:require="Standalone or ContentManagement" unicorn:require="On">
        <unicorn>
            <configurations>
                <configuration name="Foundation.Atcom" dependencies="Foundation.Serialization" extends="Helix.Foundation">
                    <predicate type="Unicorn.Predicates.SerializationPresetPredicate, Unicorn" singleInstance="true">
                        <include name="Core.ContextMenues.Default.SyncRoomTypesAtcom" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Room Types Atcom" />
                        <include name="Core.ContextMenues.Default.SyncRoomFacilities" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Room Facilities" />
                        <include name="Core.ContextMenues.Default.SyncStarRatings" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Star Ratings" />
                        <include name="Core.ContextMenues.Default.SyncAccommodations" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Accommodations" />
                        <include name="Core.ContextMenues.Default.SyncAirports" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Airports" />
                        <include name="Core.ContextMenues.Default.SyncLocations" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Locations" />
                        <include name="Core.ContextMenues.Default.SyncResorts" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Resorts" />
                        <include name="Core.ContextMenues.Default.SyncSpecialRequests" database="core" path="/sitecore/content/Applications/Content Editor/Context Menues/Default/Sync Special Requests" />
                    </predicate>
                </configuration>
            </configurations>
        </unicorn>
    </sitecore>
</configuration>