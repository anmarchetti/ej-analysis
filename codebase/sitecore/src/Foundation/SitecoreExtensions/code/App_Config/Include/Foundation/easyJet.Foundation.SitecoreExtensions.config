<?xml version="1.0" encoding="utf-8" ?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:role="http://www.sitecore.net/xmlconfig/role/">
    <sitecore role:require="Standalone or ContentManagement">
        <settings>
            <setting name="AwsSecretsManager.CacheExpiredInMinutes" value="1440" />   <!-- 24h -->
            <setting name="AwsSecretsManager.ServiceURL" value="#{Sitecore.Aws.SecretsManagerEndpoint}" />
            <setting name="AwsSecretsManager.SecretId" value="#{Sitecore.SecretsManager.SecretName}" />
            <setting name="easyJet.CacheName" value="easyJet.Cache" />
            <setting name="easyJet.CacheSize" value="#{Sitecore.Cache.Custom.Size}" />
            <setting name="easyJet.CacheExpiredInMinutes" value="30" />
            <setting name="AutomaticUnlockOnSaved" value="true" />
            <setting name="SitecoreExtensions.WebRequestTimeout" value="300000" />
            <setting name="easyJet.SimpleCacheExpiredInMinutes" value="60" />
        </settings>
        <pipelines role:require="ContentManagement or ContentDelivery or Standalone">
            <renderField>
                <processor patch:before="*[@type='Sitecore.Pipelines.RenderField.RenderWebEditing, Sitecore.Kernel']"
                           type="easyJet.Foundation.SitecoreExtensions.Pipelines.renderField.DisableWebEditingProcessor, easyJet.Foundation.SitecoreExtensions" resolve="true" />
            </renderField>
        </pipelines>
    </sitecore>
</configuration>
