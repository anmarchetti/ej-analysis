<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:role="http://www.sitecore.net/xmlconfig/role/" xmlns:search="http://www.sitecore.net/xmlconfig/search/">
    <sitecore role:require="Standalone or ContentDelivery or ContentManagement" search:require="solr">
        <contentSearch>
            <indexConfigurations>
                <indexUpdateStrategies>
                    <onPublishEndWithAncestorAsynchronousSingleInstance type="easyJet.Foundation.Indexing.OnPublishEndWithAncestorAsynchronousSingleInstanceStrategy, easyJet.Foundation.Indexing">
                        <param desc="database">web</param>
                        <AncestorTemplateId>{28E5E169-8F72-4F90-A277-280A8302B607}</AncestorTemplateId>
                        <DescendantsTemplateIds>{5C397782-6810-460A-AB57-84E9AB67514C}|{803E75ED-804E-4900-97D6-7BCC046C8385}|{AA2B6E6C-AE94-4E48-AE95-D77DA154FE9B}|{B1E9284E-A714-45EE-84CB-0A1ADB630306}|{1762DFC8-B872-41A2-A7C1-A54B93DD6CCD}|{BA1EC5C3-14C7-40B3-8B69-D020590DA1F3}|{EA39971C-094D-4BEC-A479-9171279553C0}|{1EC134E4-4753-498E-9D1A-6DC67A8975BE}|{AF7DAAA8-8099-4F22-A607-F0E1FBA6AD0D}|{E4B3BB73-22AB-4843-A816-3AA32EDDC7DC}|{D91DEBBE-FF68-4C69-AA6E-2425451C2786}</DescendantsTemplateIds>
                    </onPublishEndWithAncestorAsynchronousSingleInstance>
                </indexUpdateStrategies>
                <solrManagedSchemaConfigurations>
                    <fieldSerializers>
                        <fieldSerializer type="easyJet.Foundation.Indexing.Schema.Serializers.SolrSchemaFieldSerializer, easyJet.Foundation.Indexing"/>
                        <copyFieldSerializer type="easyJet.Foundation.Indexing.Schema.Serializers.SolrCopyFieldSerializer, easyJet.Foundation.Indexing"/>
                    </fieldSerializers>
                </solrManagedSchemaConfigurations>
            </indexConfigurations>
        </contentSearch>

        <pipelines>
            <contentSearch.PopulateSolrSchema>
                <processor type="easyJet.Foundation.Indexing.Schema.CustomSchemaPopulator, easyJet.Foundation.Indexing"
                           patch:instead="*[@type='Sitecore.ContentSearch.SolrProvider.Pipelines.PopulateSolrSchema.PopulateFields, Sitecore.ContentSearch.SolrProvider']">
                    <param type="easyJet.Foundation.Indexing.Schema.ConfigurationDrivenPopulateHelperFactory, easyJet.Foundation.Indexing"
                           patch:instead="param[@type='Sitecore.ContentSearch.SolrProvider.Factories.DefaultPopulateHelperFactory']" resolve="true"/>
                </processor>
            </contentSearch.PopulateSolrSchema>
        </pipelines>
        <settings>
            <setting name="Indexing.Solr.ManagedSchema.SupportedIndexes" value="sitecore_destinations_master_index|sitecore_destinations_web_index" />
        </settings>
    </sitecore>
</configuration>