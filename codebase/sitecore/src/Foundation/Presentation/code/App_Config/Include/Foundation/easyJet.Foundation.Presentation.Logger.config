<?xml version="1.0"?>
<configuration>
    <sitecore>
        <log4net>
            <appender name="PresentationFileAppender" type="log4net.Appender.SitecoreLogFileAppender, Sitecore.Logging">
                <file value="$(dataFolder)/logs/easyJet.Foundation.Presentation.log.{date}.{time}.txt" />
                <appendToFile value="true" />
                <layout type="log4net.Layout.PatternLayout">
                    <conversionPattern value="%4t %d{ABSOLUTE} %-5p %m%n" />
                </layout>
                <encoding value="utf-8" />
            </appender>
            <logger name="easyJet.Foundation.Presentation.Logger" additivity="false">
                <level value="INFO" />
                <appender-ref ref="PresentationFileAppender" />
            </logger>
        </log4net>
    </sitecore>
</configuration>
