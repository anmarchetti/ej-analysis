<?xml version="1.0" encoding="utf-8" ?>
<!--
  Workaround for Sitecore KB1003590:
  "Job execution might get interrupted if an exception occurs on job:starting event"

  JobSubscriptionEventEmitter hooks into job:starting / job:ended events. When any scheduled
  agent runs, InMemoryPubSub.SendAsync throws InvalidMessageTypeException, which can propagate
  unhandled through DefaultScheduler.Execute() and permanently kill the scheduler thread.

  Sitecore support recommendation: disable GraphQL Subscriptions on CM until the fix in
  Sitecore 10.4.2 rev. 013983 PRE (KB1003424) is applied.

  Scoped to ContentManagement role only — CD instances are not affected.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/"
               xmlns:role="http://www.sitecore.net/xmlconfig/role/">
  <sitecore role:require="ContentManagement or Standalone">
    <settings>
      <setting name="GraphQL.Subscription.Enabled">
        <patch:attribute name="value">false</patch:attribute>
      </setting>
    </settings>
  </sitecore>
</configuration>
