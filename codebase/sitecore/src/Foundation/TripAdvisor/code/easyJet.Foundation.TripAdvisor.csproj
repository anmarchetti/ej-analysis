<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
    <ItemGroup>
        <PackageReference Include="Sitecore.ContentSearch" />
        <PackageReference Include="Sitecore.ContentSearch.Linq" />
    </ItemGroup>
    <Import Project="$(SolutionDir)SitecoreProject.props" />
    <PropertyGroup>
        <TargetFramework>$(FrameworkVersion)</TargetFramework>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GeneratedAssemblyInfoFile>Properties\Assemblyinfo.cs</GeneratedAssemblyInfoFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)src\Foundation\Destinations\code\easyJet.Foundation.Destinations.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="App_Config\Include\Foundation\easyJet.Foundation.TripAdvisor.config">
            <TransformOnBuild>true</TransformOnBuild>
        </Content>
        <None Include="App_Config\Include\Foundation\easyJet.Foundation.TripAdvisor.CI.config">
            <DependentUpon>easyJet.Foundation.TripAdvisor.config</DependentUpon>
            <IsTransformFile>true</IsTransformFile>
        </None>
        <None Include="App_Config\Include\Foundation\easyJet.Foundation.TripAdvisor.Debug.config">
            <DependentUpon>easyJet.Foundation.TripAdvisor.config</DependentUpon>
            <IsTransformFile>true</IsTransformFile>
        </None>
        <None Include="App_Config\Include\Foundation\easyJet.Foundation.TripAdvisor.Release.config">
            <DependentUpon>easyJet.Foundation.TripAdvisor.config</DependentUpon>
            <IsTransformFile>true</IsTransformFile>
        </None>
    </ItemGroup>
</Project>