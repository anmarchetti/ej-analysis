<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Sitecore.Analytics" />
    <PackageReference Include="Sitecore.Analytics.Model" />
    <PackageReference Include="Sitecore.CES" />
    <PackageReference Include="Sitecore.CES.GeoIp" />
    <PackageReference Include="Sitecore.CES.GeoIp.Core" />
    <PackageReference Include="Sitecore.CES.GeoIp.IpFiltering" />
    <PackageReference Include="Sitecore.Cintel" />
    <PackageReference Include="Sitecore.Marketing" />
    <PackageReference Include="Sitecore.XConnect" />
    <PackageReference Include="Sitecore.XConnect.Client" />
    <PackageReference Include="Sitecore.XConnect.Client.Configuration" />
    <PackageReference Include="Sitecore.XConnect.Collection.Model" />
    <PackageReference Include="Sitecore.XConnect.Core" />
    <PackageReference Include="Sitecore.JavaScriptServices.Configuration" />
  </ItemGroup>
  <Import Project="$(SolutionDir)SitecoreProject.props" />
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratedAssemblyInfoFile>Properties\Assemblyinfo.cs</GeneratedAssemblyInfoFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\Foundation\Multisite\code\easyJet.Foundation.Multisite.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\XConnect\code\easyJet.Foundation.XConnect.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Config\Include\Foundation\easyJet.Foundation.Analytics.config">
      <TransformOnBuild>true</TransformOnBuild>
    </Content>
    <None Include="App_Config\Include\Foundation\easyJet.Foundation.Analytics.CI.config">
      <DependentUpon>easyJet.Foundation.Analytics.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
    <None Include="App_Config\Include\Foundation\easyJet.Foundation.Analytics.Debug.config">
      <DependentUpon>easyJet.Foundation.Analytics.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
    <None Include="App_Config\Include\Foundation\easyJet.Foundation.Analytics.Release.config">
      <DependentUpon>easyJet.Foundation.Analytics.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
  </ItemGroup>
</Project>