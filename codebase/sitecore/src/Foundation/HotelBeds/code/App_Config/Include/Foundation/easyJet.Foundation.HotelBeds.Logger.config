<?xml version="1.0"?>
<configuration xmlns:role="http://www.sitecore.net/xmlconfig/role/">
    <sitecore role:require="Standalone or ContentManagement">
        <log4net>
            <appender name="HotelBedsFileAppender" type="log4net.Appender.SitecoreLogFileAppender, Sitecore.Logging">
                <file value="$(dataFolder)/logs/easyJet.Foundation.HotelBeds.log.{date}.{time}.txt" />
                <appendToFile value="true" />
                <layout type="log4net.Layout.PatternLayout">
                    <conversionPattern value="%4t %d{ABSOLUTE} %-5p %m%n" />
                </layout>
                <encoding value="utf-8" />
            </appender>
            <logger name="easyJet.Foundation.HotelBeds.Logger" additivity="false">
                <level value="DEBUG" />
                <appender-ref ref="HotelBedsFileAppender" />
            </logger>
        </log4net>
    </sitecore>
</configuration>
