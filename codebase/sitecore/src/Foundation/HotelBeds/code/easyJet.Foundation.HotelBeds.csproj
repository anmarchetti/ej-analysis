<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Sitecore.ContentSearch" />
    <PackageReference Include="Sitecore.ContentSearch.Linq" />
  </ItemGroup>
  <Import Project="$(SolutionDir)SitecoreProject.props" />
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratedAssemblyInfoFile>Properties\Assemblyinfo.cs</GeneratedAssemblyInfoFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\Foundation\AmazonS3\code\easyJet.Foundation.AmazonS3.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\Multisite\code\easyJet.Foundation.Multisite.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\Destinations\code\easyJet.Foundation.Destinations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Config\Include\Foundation\easyJet.Foundation.HotelBeds.config">
      <TransformOnBuild>true</TransformOnBuild>
    </Content>
    <Content Include="App_Config\Include\Foundation\easyJet.Foundation.HotelBeds.Serialization.config">
      <TransformOnBuild>true</TransformOnBuild>
    </Content>
    <None Include="App_Config\Include\Foundation\easyJet.Foundation.HotelBeds.Serialization.CI.config">
      <DependentUpon>easyJet.Foundation.HotelBeds.Serialization.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
    <None Include="App_Config\Include\Foundation\easyJet.Foundation.HotelBeds.Serialization.Debug.config">
      <DependentUpon>easyJet.Foundation.HotelBeds.Serialization.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
    <None Include="App_Config\Include\Foundation\easyJet.Foundation.HotelBeds.Serialization.Release.config">
      <DependentUpon>easyJet.Foundation.HotelBeds.Serialization.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
  </ItemGroup>
</Project>
