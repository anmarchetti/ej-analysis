<?xml version="1.0"?>
<configuration xmlns:role="http://www.sitecore.net/xmlconfig/role/">
    <sitecore role:require="Standalone or ContentManagement">
        <log4net>
            <appender name="GlobalLinkFileAppender" type="log4net.Appender.SitecoreLogFileAppender, Sitecore.Logging">
                <file value="$(dataFolder)/logs/GlobalLink.log.{date}.txt" />
                <appendToFile value="true"/>
                <layout type="log4net.Layout.PatternLayout">
                    <conversionPattern value="%d{DATE} %-5p %m%n" />
                </layout>
            </appender>
            <logger name="GlobalLink" additivity="false">
                <level value="Debug"/>
                <appender-ref ref="GlobalLinkFileAppender"/>
            </logger>
        </log4net>
    </sitecore>
</configuration>
