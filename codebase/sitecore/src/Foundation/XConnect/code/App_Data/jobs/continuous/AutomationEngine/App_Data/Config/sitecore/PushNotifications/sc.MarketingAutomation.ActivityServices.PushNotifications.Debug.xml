<?xml version="1.0" encoding="utf-8"?>
<!--For more information on using transformations see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<Settings xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <Sitecore>
        <XConnect>
            <MarketingAutomation>
                <Engine>
                    <Services>
                        <easyJet.PushNotificationService>
                            <Options>
                                <Endpoint xdt:Transform="Replace">http://localhost:3030/holidays/_notifications</Endpoint>
                            </Options>
                        </easyJet.PushNotificationService>
                    </Services>
                </Engine>
            </MarketingAutomation>
        </XConnect>
    </Sitecore>
</Settings>
