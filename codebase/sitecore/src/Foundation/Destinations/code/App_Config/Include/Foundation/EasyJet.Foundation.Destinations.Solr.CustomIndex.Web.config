<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/"
               xmlns:role="http://www.sitecore.net/xmlconfig/role/"
               xmlns:search="http://www.sitecore.net/xmlconfig/search/">
    <sitecore search:require="solr">
        <contentSearch>
            <configuration type="Sitecore.ContentSearch.ContentSearchConfiguration, Sitecore.ContentSearch">
                <indexes hint="list:AddIndex">
                    <!-- Content Management Configuration -->
                    <index role:require="Standalone or ContentManagement" id="sitecore_destinations_web_index" type="Sitecore.ContentSearch.SolrProvider.SwitchOnRebuildSolrCloudSearchIndex, Sitecore.ContentSearch.SolrProvider">
                        <param desc="name">$(id)</param>
                        <param desc="mainalias">sc.holidays_destinations_web_MainAlias</param>
                        <param desc="rebuildalias">sc.holidays_destinations_web_RebuildAlias</param>
                        <param desc="collection">sc.holidays_destinations_web_index</param>
                        <param desc="rebuildcollection">sc.holidays_destinations_web_index_rebuild</param>
                        <param desc="propertyStore" ref="contentSearch/indexConfigurations/databasePropertyStore" param1="$(id)" />
                        <configuration ref="contentSearch/indexConfigurations/destinationsIndexConfiguration" />
                        <strategies hint="list:AddStrategy">
                            <strategy ref="contentSearch/indexConfigurations/indexUpdateStrategies/onPublishEndWithAncestorAsynchronousSingleInstance" />
                        </strategies>
                        <locations hint="list:AddCrawler">
                            <crawler type="Sitecore.ContentSearch.SitecoreItemCrawler, Sitecore.ContentSearch">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Home/Destinations</Root>
                            </crawler>
                            <crawler type="Sitecore.ContentSearch.SitecoreItemCrawler, Sitecore.ContentSearch">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Airports</Root>
                            </crawler>
                            <crawler type="Sitecore.ContentSearch.SitecoreItemCrawler, Sitecore.ContentSearch">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Room Types</Root>
                            </crawler>
                            <crawler type="Sitecore.ContentSearch.SitecoreItemCrawler, Sitecore.ContentSearch">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Board Types</Root>
                            </crawler>
                            <crawler type="Sitecore.ContentSearch.SitecoreItemCrawler, Sitecore.ContentSearch">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Facility Types</Root>
                            </crawler>
                            <crawler type="Sitecore.ContentSearch.SitecoreItemCrawler, Sitecore.ContentSearch">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Countries</Root>
                            </crawler>
                            <crawler type="Sitecore.ContentSearch.SitecoreItemCrawler, Sitecore.ContentSearch">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Dialing Codes</Root>
                            </crawler>
                        </locations>
                        <enableItemLanguageFallback>true</enableItemLanguageFallback>
                        <enableFieldLanguageFallback>false</enableFieldLanguageFallback>
                    </index>
                    <!-- Content Delivery Configuration -->
                    <index role:require="ContentDelivery" id="sitecore_destinations_web_index" type="Sitecore.ContentSearch.SolrProvider.SolrSearchIndex, Sitecore.ContentSearch.SolrProvider">
                        <param desc="name">$(id)</param>
                        <param desc="core">sc.holidays_destinations_web_MainAlias</param>
                        <param desc="propertyStore" ref="contentSearch/indexConfigurations/databasePropertyStore" param1="$(id)" />
                        <configuration ref="contentSearch/indexConfigurations/destinationsIndexConfiguration" />
                        <strategies hint="list:AddStrategy">
                            <strategy ref="contentSearch/indexConfigurations/indexUpdateStrategies/manual" />
                        </strategies>
                        <locations hint="list:AddCrawler">
                            <crawler type="easyJet.Foundation.Translation.ContentSearch.LanguageFallbackContextItemCrawler, easyJet.Foundation.Translation">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Home/Destinations</Root>
                            </crawler>
                            <crawler type="easyJet.Foundation.Translation.ContentSearch.LanguageFallbackContextItemCrawler, easyJet.Foundation.Translation">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Airports</Root>
                            </crawler>
                            <crawler type="easyJet.Foundation.Translation.ContentSearch.LanguageFallbackContextItemCrawler, easyJet.Foundation.Translation">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Room Types</Root>
                            </crawler>
                            <crawler type="easyJet.Foundation.Translation.ContentSearch.LanguageFallbackContextItemCrawler, easyJet.Foundation.Translation">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Board Types</Root>
                            </crawler>
                            <crawler type="easyJet.Foundation.Translation.ContentSearch.LanguageFallbackContextItemCrawler, easyJet.Foundation.Translation">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Facility Types</Root>
                            </crawler>
                            <crawler type="easyJet.Foundation.Translation.ContentSearch.LanguageFallbackContextItemCrawler, easyJet.Foundation.Translation">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Countries</Root>
                            </crawler>
                            <crawler type="easyJet.Foundation.Translation.ContentSearch.LanguageFallbackContextItemCrawler, easyJet.Foundation.Translation">
                                <Database>web</Database>
                                <Root>/sitecore/content/EasyJet/Holidays/Data/Dialing Codes</Root>
                            </crawler>
                        </locations>
                        <enableItemLanguageFallback>true</enableItemLanguageFallback>
                        <enableFieldLanguageFallback>false</enableFieldLanguageFallback>
                    </index>
                </indexes>
            </configuration>
        </contentSearch>
    </sitecore>
</configuration>