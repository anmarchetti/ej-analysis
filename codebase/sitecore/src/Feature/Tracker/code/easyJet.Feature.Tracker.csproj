<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" />
    <PackageReference Include="EntityFramework" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Sitecore.Analytics" />
    <PackageReference Include="Sitecore.Analytics.Core" />
    <PackageReference Include="Sitecore.Analytics.Model" />
    <PackageReference Include="Sitecore.Analytics.XConnect" />
    <PackageReference Include="Sitecore.Cintel" />
    <PackageReference Include="Sitecore.Cintel.Client" />
    <PackageReference Include="Sitecore.Framework.Conditions" />
    <PackageReference Include="Sitecore.Marketing" />
    <PackageReference Include="Sitecore.XConnect" />
    <PackageReference Include="Sitecore.XConnect.Client" />
    <PackageReference Include="Sitecore.XConnect.Collection.Model" />
    <PackageReference Include="Sitecore.XConnect.Core" />
  </ItemGroup>
  <Import Project="$(SolutionDir)SitecoreProject.props" />
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratedAssemblyInfoFile>Properties\Assemblyinfo.cs</GeneratedAssemblyInfoFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\Foundation\Analytics\code\easyJet.Foundation.Analytics.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\Destinations\code\easyJet.Foundation.Destinations.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\DynamoDb\code\easyJet.Foundation.DynamoDb.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\PushNotification\code\easyJet.Foundation.PushNotifications.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\XConnect\code\easyJet.Foundation.XConnect.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <WCFMetadata Include="Connected Services\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Config\Include\Feature\easyJet.Feature.Tracker.config">
      <TransformOnBuild>true</TransformOnBuild>
    </Content>
    <None Include="App_Config\Include\Feature\easyJet.Feature.Tracker.CI.config">
      <DependentUpon>easyJet.Feature.Tracker.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
    <None Include="App_Config\Include\Feature\easyJet.Feature.Tracker.Debug.config">
      <DependentUpon>easyJet.Feature.Tracker.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
    <None Include="App_Config\Include\Feature\easyJet.Feature.Tracker.Release.config">
      <DependentUpon>easyJet.Feature.Tracker.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
    <Content Include="sitecore modules\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>