<?xml version="1.0" encoding="utf-8" ?> 
<control xmlns:def="Definition" xmlns="http://schemas.sitecore.net/Visual-Studio-Intellisense">
    <SyncEskelData>
        <FormDialog Header="Sync Eskel Data" Text="Select data period from which you want to be data synced. Preferable time span - 1 year." CancelButton="false" OKButtonClass="scButton" OKButton="Submit">
            <CodeBeside Type="easyJet.Feature.Tracker.Controls.SyncEskelDataForm, easyJet.Feature.Tracker" />

            <Stylesheet Key="inline">
                .scBar {
                float: left;
                margin:2px 0;
                }

                .scDates {
                display: none;
                }

                .scViewer{
                position:absolute;
                top:330px;
                bottom:0;
                left:0;
                right:0;
                margin:10px;
                height:auto !important;
                }
            </Stylesheet>
      
            <Border Width="100%" Height="100%"> 
                <Border Align="Center" Padding="0px 0px 8px 0px">
                    <GridPanel Columns="3">
                        <Literal Text="Start date:" Click="Refresh" GridPanel.VAlign="top"/>
                        <Space Width="32"/>
                        <Literal Text="End date:" Click="Refresh" GridPanel.VAlign="top"/>

                        <DateCalendar ID="StartDate"/>
                        <Space Width="32"/>
                        <DateCalendar ID="EndDate"/>
                    </GridPanel>
                </Border>
      
                <Scrollbox class="scScrollbox scViewer" Height="100%" Padding="0px">      
                    <GridPanel ID="Viewer" Columns="2" Width="100%"/>      
                </Scrollbox>
        
            </Border>  
        </FormDialog>
    </SyncEskelData>
</control>