<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Sitecore.Publishing.Service" />
    <PackageReference Include="Sitecore.Publishing.Service.Client.Http" />
    <PackageReference Include="AWSSDK.Core" />
    <PackageReference Include="AWSSDK.SQS" />
  </ItemGroup>
  <Import Project="$(SolutionDir)SitecoreProject.props" />
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="App_Config\Include\Feature\easyJet.Feature.ScrappingTrigger.Debug.config" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Config\Include\Feature\easyJet.Feature.ScrappingTrigger.config">
      <TransformOnBuild>true</TransformOnBuild>
    </Content>
    <None Include="App_Config\Include\Feature\easyJet.Feature.ScrappingTrigger.Debug.config">
      <DependentUpon>easyJet.Feature.ScrappingTrigger.config</DependentUpon>
      <IsTransformFile>true</IsTransformFile>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\Foundation\AmazonSqs\code\easyJet.Foundation.AmazonSqs.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\AmazonSecurityToken\code\easyJet.Foundation.AmazonSecurityToken.csproj" />
  </ItemGroup>
</Project>