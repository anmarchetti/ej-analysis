<?xml version="1.0" encoding="utf-8"?>
<!--For more information on using transformations see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:role="http://www.sitecore.net/xmlconfig/role/" xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <sitecore role:require="Standalone or ContentManagement">
        <settings>
            <setting xdt:Transform="SetAttributes" xdt:Locator="Match(name)" name="EnvironmentHint.Font.Color" value="#ffffff" />
            <setting xdt:Transform="SetAttributes" xdt:Locator="Match(name)" name="EnvironmentHint.Background.Color" value="#622386" />
            <setting xdt:Transform="SetAttributes" xdt:Locator="Match(name)" name="EnvironmentHint.EnvironmentName" value="local" />
            <setting xdt:Transform="SetAttributes" xdt:Locator="Match(name)" name="Jss.ExcludedFieldNames" value="LanguagesWithDisabledFallback;SkipTranslate;AutoTranslate;UpdatesBoardsFolder;UpdatesImagesFolder;UpdatesRoomsFolder;UpdatesFacilitiesFolder" />
            <setting xdt:Transform="SetAttributes" xdt:Locator="Match(name)" name="GenerateContentSyncScripts.IsEnabled" value="True" />
        </settings>
    </sitecore>
</configuration>