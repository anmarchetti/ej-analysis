<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Scriban" />
    <PackageReference Include="Sitecore.Services.Infrastructure" />
    <PackageReference Include="Sitecore.XConnect" />
    <PackageReference Include="Sitecore.XConnect.Client" />
    <PackageReference Include="Sitecore.XConnect.Collection.Model" />
    <PackageReference Include="Sitecore.XConnect.Core" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Sitecore.Buckets" />
    <PackageReference Include="Sitecore.Cintel" />
    <PackageReference Include="Sitecore.Cintel.Client" />
    <PackageReference Include="Sitecore.Client" />
    <PackageReference Include="Sitecore.ContentSearch" />
    <PackageReference Include="Sitecore.ContentTesting" />
    <PackageReference Include="Spe" />
    <PackageReference Include="Spe.Abstractions" />
  </ItemGroup>
  <Import Project="$(SolutionDir)SitecoreProject.props" />
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratedAssemblyInfoFile>Properties\Assemblyinfo.cs</GeneratedAssemblyInfoFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\Foundation\XConnect\code\easyJet.Foundation.XConnect.Common.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\DynamoDb\code\easyJet.Foundation.DynamoDb.csproj" />
    <ProjectReference Include="$(SolutionDir)src\Foundation\Destinations\code\easyJet.Foundation.Destinations.csproj" />
	<ProjectReference Include="$(SolutionDir)src\Foundation\Presentation\code\easyJet.Foundation.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="holidays\layouts\system\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="layouts\system\VisitorIdentification.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="sitecore\shell\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="sitecore modules\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="sitecore modules\RenderingMappingEditor\RenderingMappingEditor.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="sitecore modules\RenderingMappingEditor\RenderingMappingEditor.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Remove="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.CI.config" />
    <Content Remove="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.Debug.config" />
    <Content Remove="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.LayoutService.CI.config" />
    <Content Remove="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.LayoutService.Debug.config" />
    <Content Remove="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.LayoutService.Release.config" />
    <Content Remove="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.Release.config" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.config">
      <TransformOnBuild>true</TransformOnBuild>
    </Content>
    <Content Update="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.LayoutService.config">
      <TransformOnBuild>true</TransformOnBuild>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.CI.config">
      <IsTransformFile>true</IsTransformFile>
      <DependentUpon>easyJet.Feature.SitecoreEnhancment.config</DependentUpon>
    </None>
    <None Update="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.Debug.config">
      <IsTransformFile>true</IsTransformFile>
      <DependentUpon>easyJet.Feature.SitecoreEnhancment.config</DependentUpon>
    </None>
    <None Update="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.LayoutService.CI.config">
      <IsTransformFile>true</IsTransformFile>
      <DependentUpon>easyJet.Feature.SitecoreEnhancment.LayoutService.config</DependentUpon>
    </None>
    <None Update="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.LayoutService.Debug.config">
      <IsTransformFile>true</IsTransformFile>
      <DependentUpon>easyJet.Feature.SitecoreEnhancment.LayoutService.config</DependentUpon>
    </None>
    <None Update="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.LayoutService.Release.config">
      <IsTransformFile>true</IsTransformFile>
      <DependentUpon>easyJet.Feature.SitecoreEnhancment.LayoutService.config</DependentUpon>
    </None>
    <None Update="App_Config\Include\Feature\easyJet.Feature.SitecoreEnhancment.Release.config">
      <IsTransformFile>true</IsTransformFile>
      <DependentUpon>easyJet.Feature.SitecoreEnhancment.config</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="sitecore\api\" />
  </ItemGroup>
  <ItemGroup>
    <!-- HTML templates as embedded resources (needed at runtime) -->
    <EmbeddedResource Include="sitecore modules\RenderingMappingEditor\RenderingMappingEditor.Row.html">
      <LogicalName>easyJet.Feature.SitecoreEnhancment.Resources.RenderingMappingEditor.Row.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="sitecore modules\RenderingMappingEditor\RenderingMappingEditor.RenderingDisplay.html">
      <LogicalName>easyJet.Feature.SitecoreEnhancment.Resources.RenderingMappingEditor.RenderingDisplay.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="sitecore modules\RenderingMappingEditor\RenderingMappingEditor.Dropdown.html">
      <LogicalName>easyJet.Feature.SitecoreEnhancment.Resources.RenderingMappingEditor.Dropdown.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="sitecore modules\RenderingMappingEditor\RenderingMappingEditor.Header.html">
      <LogicalName>easyJet.Feature.SitecoreEnhancment.Resources.RenderingMappingEditor.Header.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>