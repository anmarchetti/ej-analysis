<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:set="http://www.sitecore.net/xmlconfig/set/" xmlns:role="http://www.sitecore.net/xmlconfig/role/" xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <sitecore>
        <sites>
            <site name="TradePortal" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" database="master" enableTracking="false"/>
        </sites>
        <javaScriptServices>
            <apps>
                <app name="TradePortal"
                     xdt:Transform="SetAttributes"
                     xdt:Locator="Match(name)"
                     serverSideRenderingEngineEndpointUrl="http://localhost:3000/api/editing/render"
                     serverSideRenderingEngineApplicationUrl="http://localhost:3000" />
            </apps>
        </javaScriptServices>
    </sitecore>
</configuration>