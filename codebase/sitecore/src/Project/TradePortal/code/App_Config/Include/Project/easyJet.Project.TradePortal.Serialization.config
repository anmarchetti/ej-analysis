<?xml version="1.0" encoding="utf-8" ?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/"
               xmlns:role="http://www.sitecore.net/xmlconfig/role/"
               xmlns:unicorn="http://www.sitecore.net/xmlconfig/unicorn/">
    <sitecore role:require="Standalone or ContentManagement" unicorn:require="On">
        <unicorn>
            <configurations>
                <configuration name="Project.TradePortal" dependencies="Foundation.*, Feature.*" extends="Helix.Project">
                    <predicate type="Unicorn.Predicates.SerializationPresetPredicate, Unicorn" singleInstance="true">
                        <include name="TradePortal.Templates" database="master" path="/sitecore/templates/Project/Trade Portal"/>
                        <include name="TradePortal.BranchTemplates" database="master" path="/sitecore/templates/Branches/Project/Trade Portal"/>
                        <include name="TradePortal.Layouts" database="master" path="/sitecore/layout/Layouts/Project/Trade Portal"/>
                        <include name="TradePortal.Renderings" database="master" path="/sitecore/layout/Renderings/Project/Trade Portal"/>
                        <include name="TradePortal.PlaceholderSettings" database="master" path="/sitecore/layout/Placeholder Settings/Project/Trade Portal"/>
                        <!-- Media Library - Default -->
                        <include name="TradePortal.Media.Default" database="master" path="/sitecore/media library/Project/Trade Portal" />
                        <!-- Settings -->
                        <include name="TradePortal.Settings" database="master" path="/sitecore/system/Settings/Project/Trade Portal" />
                    </predicate>
                </configuration>
            </configurations>
        </unicorn>
    </sitecore>
</configuration>