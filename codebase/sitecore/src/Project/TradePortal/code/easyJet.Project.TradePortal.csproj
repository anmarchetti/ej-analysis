<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" />
    </ItemGroup>
    <Import Project="$(SolutionDir)SitecoreProject.props" />
    <PropertyGroup>
        <TargetFramework>$(FrameworkVersion)</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="App_Config\Include\Project\easyJet.Project.TradePortal.JavaScriptServices.config">
            <TransformOnBuild>true</TransformOnBuild>
        </Content>
        <None Include="App_Config\Include\Project\easyJet.Project.TradePortal.JavaScriptServices.Debug.config">
            <DependentUpon>easyJet.Project.TradePortal.JavaScriptServices.config</DependentUpon>
            <IsTransformFile>true</IsTransformFile>
        </None>
        <None Include="App_Config\Include\Project\easyJet.Project.TradePortal.JavaScriptServices.Release.config">
            <DependentUpon>easyJet.Project.TradePortal.JavaScriptServices.config</DependentUpon>
            <IsTransformFile>true</IsTransformFile>
        </None>
        <Content Include="App_Config\Include\Project\easyJet.Project.TradePortal.Serialization.config">
            <TransformOnBuild>true</TransformOnBuild>
        </Content>
    </ItemGroup>
</Project>