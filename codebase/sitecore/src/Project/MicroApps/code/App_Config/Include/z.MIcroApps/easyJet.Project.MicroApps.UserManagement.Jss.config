<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/"
    xmlns:set="http://www.sitecore.net/xmlconfig/set/"
    xmlns:role="http://www.sitecore.net/xmlconfig/role/">
    <sitecore>
        <sites>
            <site patch:before="site[@name='website']" inherits="website" name="UserManagement" hostName="*" rootPath="/sitecore/content/EasyJet/UserManagement" startItem="/manage-account" database="#{Sitecore.Jss.Website.Database}" enableTracking="false" htmlCacheSize="300MB" cacheHtml="true" alwaysIncludeServerUrl="false" />
        </sites>
        <javaScriptServices>
            <apps>
                <app name="UserManagement" sitecorePath="/sitecore/content/EasyJet/UserManagement" useLanguageSpecificLayout="true" inherits="defaults" serverSideRenderingEngine="http" serverSideRenderingEngineEndpointUrl="#{Sitecore.Jss.RendeningEngine}/api/editing/render" serverSideRenderingEngineApplicationUrl="#{Sitecore.Jss.RendeningEngine}" serverSideRenderingEngineEditOnly="false" />
            </apps>
        </javaScriptServices>
    </sitecore>
</configuration>