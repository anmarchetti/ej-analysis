        <None Include="App_Config\Include\z.MicroApps\easyJet.Project.MicroApps.Shared.Jss.Debug.config">
            <DependentUpon>zDevSettings.config</DependentUpon>
            <IsTransformFile>true</IsTransformFile>
        </None>
    </ItemGroup>
</Project>