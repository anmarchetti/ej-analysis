@model easyJet.Holidays.IntegrationTests.TestApi.Models.Voucher
@{
    ViewData["Title"] = "TestAPI - Vouchers";
}

<div class="text-center">
    @using (Html.BeginForm("Voucher", "BookingUi", FormMethod.Post))
    {
        <table cellpadding="5" cellspacing="5" width="100%">
            <tr>
                <th colspan="2" align="center">Voucher</th>
            </tr>
            <tr>
                <td style="text-align:right">Amount: </td>
                <td style="text-align:left">
                    @Html.TextBoxFor(m => m.Amount)
                </td>
            </tr>
            <tr>
                <td style="text-align:right">Currency: </td>
                <td style="text-align:left">
                    @Html.TextBoxFor(m => m.Currency)
                </td>
            </tr>
            <tr>
                <td style="text-align:right">Reason: </td>
                <td style="text-align:left">
                    @Html.TextBoxFor(m => m.ReasonCode) onetimeuse, goodwill, refund, giftcard, Promotion - Staff credit 24-25, Promotion - Marketing
                </td>
            </tr>
            <tr>
                <td style="text-align:right">Market code: </td>
                <td style="text-align:left">
                    @Html.TextBoxFor(m => m.MarketCode)
                </td>
            </tr>
            <tr>
                <td style="text-align:right">Metadata: </td>
                <td style="text-align:left">
                    @Html.TextAreaFor(m => m.MetaData, new { style = "width: 100%; height: 100px;" })
                    example -> key1:value1;key2:value2;key3:value3
                </td>
            </tr>
            <tr>
                <td style="text-align:right">Authentication method: </td>
                <td style="text-align:left">
                    <input type="radio" value="GenerateRandomUser" id="AuthenticationMethod" name="AuthenticationMethod" />Generate random user<br />
                    <input type="radio" value="UseExistingUser" id="AuthenticationMethod" name="AuthenticationMethod" />Use existing user<br />
                </td>
            </tr>
            <tr class="authenticationMethod">
                <td style="text-align:right">Email: </td>
                <td style="text-align:left">
                    @Html.TextBoxFor(m => m.Email)
                </td>
            </tr>
            <tr class="authenticationMethod">
                <td style="text-align:right">Password: </td>
                <td style="text-align:left">
                    @Html.PasswordFor(m => m.Password)
                    <input type="checkbox" id="showPassword" />
                    <label for="showPassword">Show Password</label>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center"><input id="submitButton" type="submit" value="Submit" /></td>
            </tr>
            <tr>
                <td colspan="2" id="response">@Html.Raw(Model?.Vouchers)</td>
            </tr>
            <tr>
                <td colspan="2" id="logs">
                    <textarea readonly="readonly" style="height:200px; width:75%; ">@Model?.Logs</textarea>
                </td>
            </tr>
        </table>
    }
</div>
@section Scripts {
    <script>
        $(document).ready(function(){
                $('input[type=radio][name=AuthenticationMethod]').change(function () {
                    if (this.value == 'GenerateRandomUser') {
                        $(".authenticationMethod").hide();
                    }
                    else {
                        $(".authenticationMethod").show();
                    }
                });

        });

        document.getElementById('showPassword').addEventListener('change', function () {
            var passwordField = document.getElementById('Password');
            if (this.checked) {
                passwordField.type = 'text'; // Show password
            } else {
                passwordField.type = 'password'; // Mask password
            }
        });

    </script>
}