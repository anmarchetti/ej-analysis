			<xs:documentation>MultiCentre Method. Used to state how Items to book.
			MANY Multiple             -- applicable for each property /location
			PB   Per Booking          -- once per booking
			PP   Per Person           -- once per person per booking</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="MANY"/>
				<xs:enumeration value="PB"/>
				<xs:enumeration value="PP"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Min_Adt_Age" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Min Adult Age</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Max_Adt_Age" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Max Adult Age</xs:documentation>
		</xs:annotation>
	</xs:element>
