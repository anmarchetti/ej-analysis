	<xs:element name="PackageNo" type="xs:string">
		<xs:annotation>
			<xs:documentation>Package Number</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Search_Results">
		<xs:annotation>
			<xs:documentation>Search results</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Extras" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="COM:Item_Set" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Flt_Extras" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="COM:Flt_Extra_Cat_List" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Car_Rentals" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="COM:Car_Rental" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Disc_Code" type="xs:string">
		<xs:annotation>
			<xs:documentation>promotional Discount Code</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Misc_Cost">
		<xs:annotation>
			<xs:documentation>Miscellaneous Cost</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:float">
					<xs:attribute name="Cd" type="xs:string">
						<xs:annotation>
							<xs:documentation>Misc cost code</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Name" type="xs:string"/>
					<xs:attribute name="CurISO" type="xs:string">
						<xs:annotation>
