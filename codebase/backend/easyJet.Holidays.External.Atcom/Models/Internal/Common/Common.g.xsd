		<xs:annotation>
			<xs:documentation>
				valid values are are:
				EMBK - Embark,
				DEBK - Disembark,
				CALL - Call at a port,
				ATSE - At Sea
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="EMBK"/>
				<xs:enumeration value="DEBK"/>
				<xs:enumeration value="CALL"/>
				<xs:enumeration value="ATSE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Point">
		<xs:complexType>
			<xs:attribute name="Cd" type="xs:string"/>
			<xs:attribute name="Name" type="xs:string"/>
		</xs:complexType>
	</xs:element>
