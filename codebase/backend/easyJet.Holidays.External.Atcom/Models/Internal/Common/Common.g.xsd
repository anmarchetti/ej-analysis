		<xs:annotation>
			<xs:documentation>Staff</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Cd" type="xs:string"/>
			<xs:attribute name="Name" type="xs:string"/>
		</xs:complexType>
	</xs:element>
