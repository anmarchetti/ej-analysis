		<xs:annotation>
			<xs:documentation>Is_Loyalty_Card</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Ship_Name" type="xs:string">
		<xs:annotation>
			<xs:documentation>Ship's name</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Ship_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Ship Code</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Fetch_Rm_Cost_Prices" type="xs:boolean">
