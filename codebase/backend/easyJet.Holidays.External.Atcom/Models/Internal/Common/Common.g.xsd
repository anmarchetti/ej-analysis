						<xs:documentation>Another alternate ref e.g. Airline Locator </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="System" type="xs:string">
					<xs:annotation>
						<xs:documentation>System the reference belongs to</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
