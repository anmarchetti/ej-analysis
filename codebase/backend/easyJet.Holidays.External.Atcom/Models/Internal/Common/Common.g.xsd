					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Cd" type="xs:string"/>
			<xs:attribute name="Name" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Shop_Agents">
		<xs:annotation>
			<xs:documentation>Shop Agents</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Shop_Agent" maxOccurs="unbounded"/>
