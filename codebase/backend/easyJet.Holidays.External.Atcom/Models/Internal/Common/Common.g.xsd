<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2016 (http://www.altova.com) by trhodes (ATCORE Technology Ltd) -->
<xs:schema xmlns:COM="AtComRes/Common" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="AtComRes/Common" elementFormDefault="qualified">
	<!--
      definition of base elements for request and responses
    -->
	<xs:complexType name="AtcomresBaseRequest" abstract="false">
		<xs:annotation>
			<xs:documentation>Common base request complex type to be included/extended inside each specific request. The AtcomresBaseRequest
       covers the structure and those elements which are to be common throughout all requests.
    </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DiscardSession" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Discards session after request - optional</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Adm" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Administration:Each request covers at least an administration tag.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:CltInfo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Client Information describing the requesting client</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Offer_Ctl" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Offer control - Offer control for controlling how offers are to be calculated in @ComRes</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--
    definition of base response class
  -->
	<xs:complexType name="AtcomresBaseResponse">
		<xs:annotation>
			<xs:documentation>Common base response complex type to be included/extended inside each specific response. The AtcomresBaseResponse
       covers the structure and those elements which are to be common throughout all responses.
  </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="COM:Adm" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Administration:Each response covers at least an administration tag.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:CltInfo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Client Information describing the client which has send the request</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Offer_Ctl" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Offer control for controlling how offers were calculated in @ComRes</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:ApplicationEvent" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>optional performance statistics</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--
      booking base request
     -->
	<xs:complexType name="AtcomresBookingBaseRequest" abstract="false" mixed="false">
		<xs:annotation>
			<xs:documentation>Base request for (re-)booking/display.
     </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="COM:AtcomresBaseRequest">
				<xs:sequence>
					<xs:element ref="COM:BkgNum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>BookingNumber:Booking Id and Version of this booking. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:BkgSts" minOccurs="0">
						<xs:annotation>
							<xs:documentation>BookingState:Actual booking state for the whole booking to achieve or current.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:ResSts" minOccurs="0"/>
					<xs:element ref="COM:Is_Prebooking" minOccurs="0">
						<xs:annotation>
							<xs:documentation>If true, indicates a prebooking request.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Bkg_Ent" minOccurs="0">
						<xs:annotation>
							<xs:documentation>BookingEntries:container with all the accommodations, flights and relationships to the participants for this booking</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Agt_No" minOccurs="0"/>
					<xs:element ref="COM:Cus" minOccurs="0">
						<xs:annotation>
							<xs:documentation>customer of this booking</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:CusDet" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>CustomerDetails:List of persons with KUBA customer number referred in this response</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:TrvDox" minOccurs="0">
						<xs:annotation>
							<xs:documentation>TravelDocuments:travel documents related information, e.g. where documents are to be send to</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:PayData" minOccurs="0">
						<xs:annotation>
							<xs:documentation>all information about the payment to be used for this booking</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Pax" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Participants - List of all relevant participants for this booking (without canceled participants)</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Group_Travel" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Group travel related information that can be sent in a request</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:NewPayments" minOccurs="0">
						<xs:annotation>
							<xs:documentation>New Payments to be Applied to the Booking</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Prices" minOccurs="0">
						<xs:annotation>
							<xs:documentation>prices</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:AgtContact" minOccurs="0"/>
					<xs:element ref="COM:Source" minOccurs="0"/>
					<xs:element ref="COM:Sub_Source" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<!--
    definition of booking base response class
  -->
	<xs:complexType name="AtcomresBookingBaseResponse" mixed="false">
		<xs:annotation>
			<xs:documentation>Common booking base response complex type to be included/extended inside each specific booking response. The AtcomresBookingBaseResponse
       covers the structure and those elements which are to be common throughout all (re-)booking/display/cancellation responses.
       All fields in here are optional, because they may not appear in case of an error.
  </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="COM:AtcomresBaseResponse">
				<xs:sequence>
					<xs:element ref="COM:BkgNum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>BookingNumber:Booking Id and Version of this booking. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:BkgSts" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Actual booking state for the whole booking. Missing in case of a booking error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:BkgSts_2" minOccurs="0">
						<xs:annotation>
							<xs:documentation>booking status 2, usually indicates on FIXED/ONREQUEST booking</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:ResSts" minOccurs="0">
						<xs:annotation>
							<xs:documentation>if missing, CONFIRMED is assumed.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Is_Prebooking" minOccurs="0">
						<xs:annotation>
							<xs:documentation>if missing, false is assumed.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="HasAgt_Notice" type="xs:boolean" default="false" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Flag to indicate whether agency notices for this booking exist.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:StsExpDate" minOccurs="0">
						<xs:annotation>
							<xs:documentation>State expiry date and time: Is applicable for option bookings only.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="StsExpDateMax" type="xs:dateTime" minOccurs="0"/>
					<xs:element ref="COM:His" minOccurs="0">
						<xs:annotation>
							<xs:documentation>History:Information about creating/changing date and time, user who changed, ... for this booking. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Bkg_Ent" minOccurs="0">
						<xs:annotation>
							<xs:documentation>container with all the accommodations, flights and relationships to the participants for this booking. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Agt_No" minOccurs="0">
						<xs:annotation>
							<xs:documentation>AgencyNo - AGENDA agency number of the agency responsible of this booking. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Agt_Mth" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Returned in DisplayResponse if request Trk@From='retailbrowser' or 'AtcomWeb'.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Cus" minOccurs="0">
						<xs:annotation>
							<xs:documentation>customer of this booking. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:CusDet" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>CustomerDetails:List of persons with Kuba customer number referred in this response. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:TrvDox" minOccurs="0">
						<xs:annotation>
							<xs:documentation>TravelDocuments:Where the travel documents of this booking have to be send to. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:PayData" minOccurs="0" maxOccurs="3">
						<xs:annotation>
							<xs:documentation>List of paid and outstanding payments for this booking. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Pax" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Participants - List of all participants for this booking. Is missing in case of an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Prom" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Default promotion of the booking</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Group_Travel" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Group travel related information that can be sent in a request</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:AgtContact" minOccurs="0"/>
					<xs:element ref="COM:Source" minOccurs="0"/>
					<xs:element ref="COM:Sub_Source" minOccurs="0"/>
					<xs:element ref="COM:Incident_Sts" minOccurs="0"/>
					<xs:element ref="COM:Reservation_Locked" minOccurs="0"/>
					<xs:element ref="COM:Retail_Bkg_Id" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<!--
    definition of the base search request
  -->
	<xs:complexType name="AtcomresBaseOfferSearchRequest" mixed="false">
		<xs:annotation>
			<xs:documentation>Base request for searching different product types</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="COM:AtcomresBaseRequest">
				<xs:sequence>
					<xs:element ref="COM:St_Dt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>start date for the search</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Date_Range" minOccurs="0"/>
					<xs:element ref="COM:End_Dt" minOccurs="0"/>
					<xs:element ref="COM:Prc_Range" minOccurs="0" maxOccurs="unbounded"/>
					<xs:choice minOccurs="0">
						<xs:element ref="COM:Prom" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>List of Promotions where offers are searched</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Prom_Grp" maxOccurs="unbounded"/>
					</xs:choice>
					<xs:element ref="COM:Prd_Cd" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>offers for this list of product codes are searched</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Loc" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>offers for products in the given list of locations are searched</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Occs" minOccurs="0">
						<xs:annotation>
							<xs:documentation>occupancies for which offers are searched</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Catalog" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>List of catalogs for which offers are searched</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Search_Category" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>list of search criteria. If more than one Search_Category is specified, they represent an OR-relationship.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<!--     Route Type-->
	<xs:complexType name="Route_Tp">
		<xs:annotation>
			<xs:documentation>Route Type</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="COM:Route_Id" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Route id, specifying a unique id throughout all routes inside a result list to allow
            a pointer on this.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:RouteCd" minOccurs="0"/>
			<xs:element ref="COM:Flt_Inv_Id" minOccurs="0"/>
			<xs:element name="Rt_InvState" default="INTERNAL" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Flag if product is from internal or external inventory. Default value is INTERNAL</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="INTERNAL">
							<xs:annotation>
								<xs:documentation>Internal inventory service</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="EXTERNAL">
							<xs:annotation>
								<xs:documentation>External inventory service</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element ref="COM:Ext_Ref_Id" minOccurs="0">
				<xs:annotation>
					<xs:documentation>External reference id for external inventory services (flight was booked in IRIS or AMADEUS e.g.)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Dep_Air_Cd" minOccurs="0"/>
			<xs:element name="Dep_Air_Cd_Tp" type="COM:Air_Cd_Tp" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Departure airport Code type</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Arr_Air_Cd" minOccurs="0"/>
			<xs:element name="Arr_Air_Cd_Tp" type="COM:Air_Cd_Tp" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Arrival Airport Code type</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Flt_Dt_Tm" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>FlightDate - start and end date of this flight in local time (depending on its type). If there
        is any flight data, it always has to be one DEPARTURE and one ARRIVAL type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Duration" minOccurs="0"/>
			<xs:element ref="COM:Cycle_Dt" minOccurs="0"/>
			<xs:element name="Chk_In_Tm" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
          Check-in time as local time in the same xs:dateTime format as departure time, for example 2012-06-01T12:00:00.000+02:00
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:JnyDur" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Journey duration: The time how long the flight (sum of sectors) takes including stays</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Route_Cat" minOccurs="0"/>
			<xs:choice minOccurs="0">
				<xs:element ref="COM:Prom">
					<xs:annotation>
						<xs:documentation>internal @comRes promotion code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Prom_Grp">
					<xs:annotation>
						<xs:documentation>@comRes promotion group code</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<xs:element ref="COM:Car_Cd" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Main carrier code:2 or 3LC IATA code for the main airline</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Cd_Shr_Cd" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Code share carrier code. If this is a code share flight.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Flt_No" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Flight number - 4 digit flight number without carrier code</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Cd_Shr_Flt_No" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Flight number - 4 digit flight number for code share flight without carrier code</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Bkg_Cls" minOccurs="0">
				<xs:annotation>
					<xs:documentation>booking class definition. The airlines definition of the class within the aircraft</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Cab_Cls" minOccurs="0">
				<xs:annotation>
					<xs:documentation>CabinClass - cabin class for booking</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Flt_Seq_Cd" minOccurs="0">
				<xs:annotation>
					<xs:documentation>FlightSeqCode - describes whether there are multiple flights on the same day for the same sector.
        Normally the first flight on the same day creates a "A", where the second one is the "B" flight and so on...</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Qty" minOccurs="0">
				<xs:annotation>
					<xs:documentation>describes quantity related information about this route, e.g. how many seats are available</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:EqmtAvl" minOccurs="0">
				<xs:annotation>
					<xs:documentation>describes class-independent availability information for the plane</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Sec" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>sectors - describes the sectors (also known as physical flights) underneath the current route (logical flight)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Ser_Sts" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>service booking states - defines the possible target booking states for this route</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:SubServPaxs" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines which passengers are allocated to this flight concerning the current context.
        This is necessary in case of a booking/display context.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Prices" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Participant related prices.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Misc_Cost" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element ref="COM:SrcData" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Information needed to fulfill search and booking process in external systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Adt_Prc" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Price for a passenger which type is adult in context of the room it allocates.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Adt_Fuel" minOccurs="0"/>
			<xs:element ref="COM:Chd_Prc" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Price for a passenger which type is child in context of the room it allocates.
May occur more than once if there are different price codes (for example normal/RCP)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Adt_Flt_Rate" minOccurs="0"/>
			<xs:element ref="COM:Chd_Flt_Rate" minOccurs="0"/>
			<xs:element ref="COM:Total_3PF_Rate" minOccurs="0"/>
			<xs:element ref="COM:Flt_Prc_Inc" minOccurs="0"/>
			<xs:element ref="COM:Chd_Fuel" minOccurs="0"/>
			<xs:element ref="COM:Free_Chd_Prc" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Price for a passenger which type is free child in context of the room it allocates.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Red_Prc_Ratio" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Determines, how many adults are required to be eligible for a reduction for the specified number of children</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Adu" type="xs:integer">
							<xs:annotation>
								<xs:documentation>number of adults</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Chd" type="xs:integer">
							<xs:annotation>
								<xs:documentation>number of children</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element ref="COM:Inf_Prc" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Price for a passenger which type is infant in context of the room it allocates.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Inf_Fuel" minOccurs="0"/>
			<xs:element ref="COM:Memo" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Potential list of memo information (comment, remarks,...) concerning this route (including erratas). The
        actual type and its meaning depends on the memo types the customers configure in their booking system instance. Normally on
        this level only errata are required for serving IRIS.plus needs.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Only_Direct_Flight" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Flag (in package search) whether to search and return 'only' direct flights</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Seat_Res_Possible" type="xs:boolean" default="false" minOccurs="0"/>
            <xs:element name="Tot_Prc_Ex">
                <xs:annotation>
                    <xs:documentation>Route total price without any fees and charges.</xs:documentation>
                </xs:annotation>
            </xs:element>
			<xs:element name="ETicket_Possible" type="xs:boolean" default="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Flag to indicate whether eticket is possible for this route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Is_Return_Priced" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>indicates whether this internal flight is priced on a two-way basis</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Check_In" minOccurs="0" maxOccurs="2"/>
			<xs:element ref="COM:Loc" minOccurs="0" maxOccurs="2"/>
			<xs:element ref="COM:Adhoc_Ser" minOccurs="0"/>
			<xs:element ref="COM:Adt_Bag" minOccurs="0"/>
			<xs:element ref="COM:Chd_Bag" minOccurs="0"/>
			<xs:element ref="COM:Inf_Bag" minOccurs="0"/>
			<xs:element ref="COM:Yield_Late_Sup" minOccurs="0"/>
			<xs:element ref="COM:Sell_Prom" minOccurs="0"/>
			<xs:element ref="COM:Atol_Mth" minOccurs="0"/>
			<xs:element ref="COM:Ref_Prd_Id" minOccurs="0"/>
			<xs:element ref="COM:Ext_Payment" minOccurs="0">
				<xs:annotation>
					<xs:documentation>External flight  payment details
Note, If both outbound and inbound flights are external, then this node will only be present on Outbound			 </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Dpt" minOccurs="0"/>
			<xs:element ref="COM:Markup_Amt" minOccurs="0"/>
			<xs:element ref="COM:Fare_Tp" minOccurs="0"/>
			<xs:element ref="COM:Tkt_By_Dt" minOccurs="0"/>
			<xs:element ref="COM:Info" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="Rt_Dir" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>route direction - the direction attribute can be "inbound" or "outbound" or some kind of stopover indicator (for example 1, 2,...)</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Is_Adhoc" type="xs:boolean" default="false">
			<xs:annotation>
				<xs:documentation>if true, indicates that the route is stored as adhoc item in @comRes. Used for flights booked in external repositories.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Error" type="xs:boolean" default="false">
			<xs:annotation>
				<xs:documentation>Set to true if service has an error and can not be booked</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="Info">
		<xs:annotation>
			<xs:documentation>
				Present if reservation promotion's parameter STC = Y. InfoBooking, Booking, InfoModify, Modify, Display.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Taxes" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Tax" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Prc_Cd" type="xs:string"/>
										<xs:element name="Prc_Cd_Name" type="xs:string"/>
										<xs:element name="Qty" type="xs:integer"/>
										<xs:element ref="COM:Amt"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:annotation>
		<xs:documentation>Car hire location type</xs:documentation>
	</xs:annotation>
	<xs:complexType name="Car_Rental_Loc_Tp">
		<xs:annotation>
			<xs:documentation>Car hire Location Type</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="COM:Depot"/>
			<xs:element ref="COM:Time" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--Flight Number type-->
	<xs:complexType name="Flt_No_Tp">
		<xs:annotation>
			<xs:documentation>carrier code and flight number</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="COM:Car_Cd"/>
			<xs:element ref="COM:Flt_No"/>
		</xs:sequence>
	</xs:complexType>
	<!--
      Administration element definition
    -->
	<xs:element name="Adm">
		<xs:annotation>
			<xs:documentation>Administration:container for administrative data
    </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:SessId" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Session identification. The session is used inside different transaction holding collected data. In fact, for a new
          search the server system (@ComRes) provides a new sessionId. This sessionId must be passed on in case of making paging requests.
          Each time a sessionId is not contained inside the request, a new sessionId is to be created by @ComRes. If there is a sessionId
          inside the request, then either the data stored for this id is reused, overridden or answered by an error, if the session timed out.
          Therefore if the session is not available (any longer) an error is to be returned by the backend system providing some information
          that the sessionId is invalid.
          A sessionId must also be used for booking transactions where an info-requested is followed up by a confirm request
          (like InfoBooking and Booking).
          </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:ReqId" minOccurs="0">
					<xs:annotation>
						<xs:documentation>RequestId:
          The request id is a tracing id from the IRIS.plus front end, passed through the VRP server layers into the @ComRes system. @ComRes
          is expected to return the same request id inside the corresponding response. @ComRes can use it for tracing (performance issues)
          and debugging a running transaction so that a problem manager can analyze the way the request went through the different
          application layers to @ComRes (and maybe in the different layers inside it) and back to the client. @ComRes is responsible for
          passing the request id onto those systems which support the same monitoring logic. For the moment this will be at least the
          hotel platform (HOPLA).
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Tm">
					<xs:annotation>
						<xs:documentation>
          timestamp - The time stamp is the time stamp in time where the request was sent by the client (inside a request) or the server returned
          the answer (response). In fact each tier provides a local time stamp (depending on its current clock and timezone).
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Trk">
					<xs:annotation>
						<xs:documentation>
          Tracking - The tracking defines the direction of communication and the participating system names. In case of a Musyk/VRP to @ComRes communication
          this is actually "musyk" to "atcomres" on the request and vice versa on its response way. As we talk about a synchronous communication
          between these to business systems, the communication is always done in synchronous manner.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ser_Msg" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>
            List of server messages, sent in the response by the server to inform the client about successful
          as well as failed actions/transactions.
         </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Debug" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>flag to indicate a test request, where mock data is requested. This response will always be the same
       and is used for continuous testing of the API from the client perspective.
      </xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="IncludeDetailedPerfStats" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>flag to indicate that detailed performance statistics are requested (to be returned in a ApplicationEvent element).</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Xsd_Ver" default="5.44.0" type="xs:string">
				<xs:annotation>
					<xs:documentation>the version number of the xsd files. Each change made on any of the xsd files
        leads to a new version number here. Where we define the different version levels as follows:
        MAJOR VERSION: there is a new (incremented) major version if the new xsd contract makes the interface
        incompatible to the old one (e.g. removing an element/attribute or renaming an element/attribute,
        making a tag mandatory that was optional before, adding a mandatory element/attribute).
        MINOR VERSION: there is a new (increased) minor version if the new xsd contract extends the
        old one (e.g. adding a new element/attribute as long as they are optional!)
        <br/>MICRO VERSION: there is a new (increased) micro version if the new xsd contract is the same as
        the old one except for changes either in the documentation (annotations, XML comments,...) or
        in the implementation of the interface (the business logic applied by @ComRes for the fulfilling the
        transactions). The last one is an optional change to the API version.
                The highest change level overrides all lower ones. So e.g. if there is one MAJOR change and two
        MINOR changes a version 1.1.5 changes to 2.0.0 (not to 2.3.5).
        </xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="AtcomResURL" type="xs:string">
				<xs:annotation>
					<xs:documentation>the responding @comRes VRP web service instance</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="AtcomResVersion" type="xs:string">
				<xs:annotation>
					<xs:documentation>version number of the @comRes system</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
       SessionId definition
  -->
	<xs:element name="SessId" type="xs:string">
		<xs:annotation>
			<xs:documentation>Session identification. The session is used inside different transaction holding collected data. In fact, for a new
          search the server system (@ComRes) provides a new sessionId. This sessionId must be passed on in case of making paging requests.
          Each time a sessionId is not contained inside the request, a new sessionId is to be created by @ComRes. If there is a sessionId
          inside the request, then either the data stored for this id is reused, overridden or answered by an error, if the session timed out.
          A sessionId must also be used for booking transactions where an info-requested is followed up by a confirm request
          (like InfoBooking and Booking).
          </xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      request id definition
    -->
	<xs:element name="ReqId" type="xs:string">
		<xs:annotation>
			<xs:documentation>
          RequestId: the request id is a tracking id from the IRIS.plus front end, passed through the VRP server layers onto the @ComRes system. @ComRes
          is expected to return the same request id inside the corresponding response. @ComRes can use it for tracing (performance issues)
          and debugging a running transaction so that a problem manager can analyze the way the request went through the different
          application layers to @ComRes (and maybe in the different layers inside it) and back to the client. @ComRes is responsible for
          passing the request id onto those systems which support the same monitoring logic. For the moment this will be at least the
          hotel platform (HOPLA).
        </xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      time stamp definition
    -->
	<xs:element name="Tm" type="xs:dateTime">
		<xs:annotation>
			<xs:documentation>time stamp - time when request or response was created</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      tracking definition
    -->
	<xs:element name="Trk">
		<xs:annotation>
			<xs:documentation>tracking - Tracking defines route or direction on which the XML request is send and the participating systems like "musyk" and "atcomres"</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="From" use="required">
				<xs:annotation>
					<xs:documentation>System name, sending the request.
        Is normally "musyk" on the first request and "atcomres" on its answer.
        Other systems were introduced for future use in upcoming releases/packages.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="musyk">
							<xs:annotation>
								<xs:documentation>Musyk system (client) - Multiple System Link</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="vrp-b2c">
							<xs:annotation>
								<xs:documentation>B2C VRP Web application (client)</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="ltur">
							<xs:annotation>
								<xs:documentation>L'Tur client.</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="hopla">
							<xs:annotation>
								<xs:documentation>HOPLA client.</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="bistro">
							<xs:annotation>
								<xs:documentation>Bistro frontend</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="mercado">
							<xs:annotation>
								<xs:documentation>Mercado</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="atcomres">
							<xs:annotation>
								<xs:documentation>hosting @ComRes system</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="tas"/>
						<xs:enumeration value="tracs"/>
						<xs:enumeration value="vision"/>
						<xs:enumeration value="atcomweb"/>
						<xs:enumeration value="tosca"/>
						<xs:enumeration value="multicom"/>
						<xs:enumeration value="phoenix"/>
						<xs:enumeration value="nordic"/>
						<xs:enumeration value="retailbrowser"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="To" use="required">
				<xs:annotation>
					<xs:documentation>System name, sending the request. Is "atcomres" on the first request and "musyk" on its answer normally.
                         Other systems were introduced for future use in upcoming releases/packages.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="musyk">
							<xs:annotation>
								<xs:documentation>Musyk system (client) - Multiple System Link</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="vrp-b2c">
							<xs:annotation>
								<xs:documentation>B2C VRP Web application (client)</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="ltur">
							<xs:annotation>
								<xs:documentation>L'Tur client.</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="hopla">
							<xs:annotation>
								<xs:documentation>HOPLA client.</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="bistro">
							<xs:annotation>
								<xs:documentation>Bistro frontend</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="mercado">
							<xs:annotation>
								<xs:documentation>Mercado</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="atcomres">
							<xs:annotation>
								<xs:documentation>hosting @ComRes system</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="tas"/>
						<xs:enumeration value="tracs"/>
						<xs:enumeration value="vision"/>
						<xs:enumeration value="atcomweb"/>
						<xs:enumeration value="tosca"/>
						<xs:enumeration value="multicom"/>
						<xs:enumeration value="phoenix"/>
						<xs:enumeration value="nordic"/>
						<xs:enumeration value="retailbrowser"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
      offer control definition
    -->
	<xs:element name="Offer_Ctl">
		<xs:annotation>
			<xs:documentation>OfferControl: container for control information like sort order, number of offers, number of requested or sent page</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="NextPage" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
          use in request to get the next result set, used for flight time variant search.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MorePages" type="xs:boolean" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
          use in response, if there more results available, used for flight time variant search.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Page" minOccurs="0">
					<xs:annotation>
						<xs:documentation>requested or sent page number</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Sort" minOccurs="0" maxOccurs="3">
					<xs:annotation>
						<xs:documentation>sort order - sort information, used as a container, if requesting multiple results and want to give them an order.
        If the element is missing then the sort order is undefined and up to the server system.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="NumOfResPerPage" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
           Defines the number of results to be returned in one answer. This is applicable for PackagetourSearchRequests as
           well as AllotmentRequests and PackagePageRequest only. In all other cases the total number of results is to be returned.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Tot_Page" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Total number of pages. Can only be defined by the @Comres system. In some cases the total number of
        offers cannot be determined. In this case either all results are returned or the response indicated further results by
        a more-pages-flag.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Tot_Offer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>total number of offers - Total number of offers returned inside a search response by @ComRes. Can only be defined by the backend system.
        The (((total number of pages) - 1) * (result per page) + (result number on last page)) = total number of offers.
        What is expected as an "offer" depends on the type of request/response pair and describes there.
        Not applicable for booking/display/re-booking/cancel ...</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Num_Arr_Air" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Number of results per arrival airport - List of arrival airports and corresponding number of results within the whole result for a search.
        Can only be defined by the @ComRes system. The sum of all result counts defines the totalNumberOfOffers as well.
        So if an accommodation is reachable by/assigned to different airports, it counts multiple times cause it is shown multiple
        times in the result list.<br/>
        The list is sorted by the passed 3LC in alphabetic ascending order.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Arr_Air_Cd" type="xs:string" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Arrival airport 3LC - defines the arrival airport IATA 3LC to filter the result set. The filter can be applied on an executed
        search result (a session) only. If the session is not available (any longer) an error is to be returned by the backend system
        providing some information that the sessionId is invalid. Is applicable in PackagePageRequests only.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<!--
        Number per arrival airport definition
      -->
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      total number of pages definition
    -->
	<xs:element name="Tot_Page" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Total number of pages. Can only be defined by the @Comres system.
          The (((total number of pages) - 1) * (result per page) + (result number on last page)) = total number of offers.
          If this is not a search response, the totalNumberOfPages element can be skipped.
          In some cases the total number of offers cannot be determined. In this case either all results are returned or the response indicated further results by a more-pages-flag.
        </xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      total number of offers definition
    -->
	<xs:element name="Tot_Offer" type="xs:integer">
		<xs:annotation>
			<xs:documentation>total number of offers - Total number of offers returned inside a search response by @ComRes. Can only be defined by the backend system.
        Not applicable for booking/display/rebooking/cancel ...</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      page definition
    -->
	<xs:element name="Page" type="xs:integer">
		<xs:annotation>
			<xs:documentation>actual number of required or sent page. So inside a paging request for an already existing session id this
      page number defines the page to be retrieved out of the session. If the session is invalid (e.g. timed out) or the page is not
      available, the server system has to return an error message. On successful retrieval the server system returns the number of the
      page it return. On a first search request the resulting page inserted here by the server is always 1 as long as results could
      be retrieved. In cases where a page information is not available, a NEXT PAGE flag might indicate to switch to the next page of results.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      sort definition
    -->
	<xs:element name="Sort">
		<xs:annotation>
			<xs:documentation>
      Sort order - The sort order defines a number of order conditions on which the result list should be ordered. Normally one criteria is at
      least the price, if a price is applicable for the result (applicable for standard searches, not applicable for matrix/allotment
      responses). The sequence in which the order conditions are enlisted in the sort order elements defines their priority.<br/>
      The sort order is to be skipped in a paging request were the page is changed. Changing the sort order means stepping back to
      page number 1.<br/>
      The sort order can be but must not be returned by the answering backend. If the sort order could not be applied (unknown sort
      criteria, unknown sessionId,...) an error message is expected by the server.<br/>

      Further definition of search for PackageSearchResponse:
       for the package search response, the sort order defines the order in which Accom accommodation objects are to be returned. In
       a standard package tour search result the results must be sorted by price. In this case the total sum of prices for all participants
       inside the same accommodation defines the search order.
       The same applies for the other search criteria like arrival airports, city or hotel names. They always refer to the Accom they
       belong to.

          PRICE: means total price (as sum for all participants) for an offer. <br/>
      ARRIVALAIRPORT3LC: the destination area airport (the arrival airport of the outbound flight) is sorted by its IATA 3LC.<br/>
          REGIONNAME: the name of the region in locale defined by client.<br/>
      CITYNAME: the name of the city in the language passed in the Locale field of the request defines the alphabetical sort order.<br/>
          STAR_RATING: the star rating defines the sort order, where no stars define the lowest value, half stars define a value between to
                   integer stars and the limit is unbound. Example for ascending: [no stars] [1*] [2*] [2.5*] [4*] [5*] [5.5*].<br/>
      HOTELNAME: the name of the hotel in alphabetical order.<br/>
          PROMOTIONNAME: the long name of the promotion of the corresponding accommodation inside one offer entry defines the order parameter.<br/>
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Sort_Dir" default="ascending">
					<xs:annotation>
						<xs:documentation>
           direction - Sort direction. Valid values are "ascending" and "descending" where "ascending" is the default value in this case.
        </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="ascending"/>
							<xs:enumeration value="descending"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Order">
					<xs:annotation>
						<xs:documentation>
              Order in which the results are to be presented. The first order attribute
            is the first occurring in the whole list of elements.
           </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="PRICE">
								<xs:annotation>
									<xs:documentation>means total price (as sum for all participants) for an offer.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="ARRIVALAIRPORT3LC">
								<xs:annotation>
									<xs:documentation>the destination area airport (the arrival airport of the outbound flight) is sorted by its IATA 3LC.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="CITYNAME">
								<xs:annotation>
									<xs:documentation>the name of the city in the language passed in the Locale field of the request defines the alphabetical sort order.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="STAR_RATING">
								<xs:annotation>
									<xs:documentation>the star rating defines the sort order, where no stars define the lowest value, half stars define a value between to
                   integer stars and the limit is unbound. Example for ascending: [no stars] [1*] [2*] [2.5*] [4*] [5*] [5.5*].</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="HOTELNAME">
								<xs:annotation>
									<xs:documentation>the name of the hotel in alphabetical order.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="PROMOTIONNAME">
								<xs:annotation>
									<xs:documentation>the long name of the promotion of the corresponding accommodation inside one offer entry defines the order parameter.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="REGIONNAME">
								<xs:annotation>
									<xs:documentation>the name of the region in locale defined by client</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="ST_DT">
								<xs:annotation>
									<xs:documentation>sorting by start date</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="BOOKING_DATE">
								<xs:annotation>
									<xs:documentation>sorting by booking date and time</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="RANKING">
								<xs:annotation>
									<xs:documentation>sorting by product ranking (currently only for items)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="SEARCHPROMGROUPNAME">
								<xs:annotation>
									<xs:documentation>sorting by Search Promotion Group Name</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      Number per arrival airport definition
    -->
	<xs:element name="Num_Arr_Air">
		<xs:annotation>
			<xs:documentation>Number of results per arrival airport: Defines the number of results for one IATA airport.
    Can only be defined by the @ComRes system. The sum of all result counts defines the totalNumberOfOffers as well.
    So if an accommodation is reachable by/assigned to different airports, it counts multiple times cause it is shown multiple
    times in the result list.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Arr_Air_Cd" type="xs:string">
					<xs:annotation>
						<xs:documentation>ArrAir3LC - the IATA 3LC airport code related to the accommodation </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="NumOfOffers" type="xs:integer">
					<xs:annotation>
						<xs:documentation>total number of accommodations available according to the search request and the corresponding location</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      client info element definition
    -->
	<xs:element name="CltInfo">
		<xs:annotation>
			<xs:documentation>ClientInfo:container for some general client related attributes, defining the client system as well as the calling user</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Locale">
					<xs:annotation>
						<xs:documentation>Current locale, the locale defines the language results (payload of XML) should be presented in, if they are
        available in multiple languages. If the language defined here is not supported by the @ComRes system, the system must return an
        error message indicating that the locale is unknown.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:CltSysContext" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
        The client system context defines the context/configuration in which the client system (Musyk) is at the time
        the request is performed. It is reasonable and in use in those case where special business logic is to be applied
        in the backend system to properly serve the response. In fact e.g. if a description of a room requires a special
        ordering of values then the functionality is covered by @ComRes. In this case the client send it's configuration
        information. The value stays the same as long as the client is running. In case of Musyk server combined with an
        IRIS.plus client the current value valid here is "3" only.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Agt_No" minOccurs="0">
					<xs:annotation>
						<xs:documentation>AGENDA agency number of the currently calling expedient/user if known to the client system (Musyk).
                          May be unknown for internal users.
                        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Agt_Pwd" minOccurs="0"/>
				<xs:element ref="COM:TermCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>current terminal code identifying the users workstation/terminal.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:User_Name">
					<xs:annotation>
						<xs:documentation>User name.
        The user name is defined for all inhouse users of IRIS.plus.
        In all search requests it is unknown for external channel users whose requests are passed on to the Musyk system via an AMADEUS channel e.g.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Exp_No" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Expedient number sent in booking/rebooking/cancellation requests. The expedient number must be returned
        for all redisplays of an existing booking.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Chan" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
         FrontendChannel - Frontend channel defining the channel through which the request was received by the Musyk system.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Channel_Type" default="VRP" minOccurs="0">
					<xs:annotation>
						<xs:documentation>indicates the type of the channel for which the channel code is sent.
This may influence the processing in @comRes</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="VRP">
								<xs:annotation>
									<xs:documentation>channel if of type VRP.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="TOMA">
								<xs:annotation>
									<xs:documentation>channel if of type TOMA.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="TOMA_IBE">
								<xs:annotation>
									<xs:documentation>channel if of type TOMA and is IBE (internat booking engine) booking(ANI3387)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="LTUR">
								<xs:annotation>
									<xs:documentation>Channel if of type L'TUR.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="HOPLA">
								<xs:annotation>
									<xs:documentation>Channel if of type HOPLA.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="SMART_IBE">
								<xs:annotation>
									<xs:documentation>channel if of type SMARTXML and is IBE (internet booking engine) booking(ANI3705)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="User_Role" default="INTERNAL" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
          Describes the role of the user, whether it is an internal VRP user or not. Allowed values are "INTERNAL" or "EXTERNAL".
          This information is e.g. needed for defining whether booking memos are to be returned by @ComRes in the response.
          Therefore it is applicable for DisplayBookingRequest as well as for ModifyBookingRequest. The user role can be omitted
          in responses from @ComRes if reasonable.
        </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="INTERNAL">
								<xs:annotation>
									<xs:documentation>
                Defines an internal (inhouse) user making a request against the @ComRes system and has special priviledges
              because of this.
                </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="EXTERNAL">
								<xs:annotation>
									<xs:documentation>External user (e.g. from an agency) making a request against the @ComRes system.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Bus_Unit_No" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>identifies a business unit of an agency. German: Betriebsstelle</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      Locale definition
  -->
	<xs:element name="Locale" type="COM:Locale_Type"/>
	<xs:simpleType name="Locale_Type">
		<xs:annotation>
			<xs:documentation>code like "de_DE" or "en_GB", language code as ISO-639-1, country code defined by ISO-3166-1.
        Current locale, the locale defines the language results (payload of XML) should be presented in, if they are
        available in multiple languages. If the language defined here is not supported by the @ComRes system, the system must return an
        error message indicating that the locale is unknown.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<!--
      client system context
    -->
	<xs:element name="CltSysContext" type="xs:string">
		<xs:annotation>
			<xs:documentation>
        The client system context defines the context/configuration in which the client system (Musyk) is at the time
        the request is performed. It is reasonable and in use in those case where special business logic is to be applied
        in the backend system to properly serve the response. In fact e.g. if a description of a room requires a special
        ordering of values then the functionality is covered by @ComRes. In this case the client send it's configuration
        information. The value stays the same as long as the client is running. In case of Musyk server combined with an
        IRIS.plus client the current value valid here is "3" only.
        </xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      agency number definition
    -->
	<xs:element name="Agt_No" type="xs:string">
		<xs:annotation>
			<xs:documentation>Agt_No - Agency number defining the current requesting agency. See value domain in external AGENDA system.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      terminal code definition
    -->
	<xs:element name="TermCode" type="xs:string">
		<xs:annotation>
			<xs:documentation>Terminal code defining a terminal from which an expedient sends in a request. The domain is depending on the front end channel.
      It's normally a 4 character value for inhouse usage and 6 digits for channels like START/AMADEUS GERMANY.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      user name definition
    -->
	<xs:element name="User_Name" type="xs:string">
		<xs:annotation>
			<xs:documentation>User name or code if available. This is normally true for all TUI internal (Inhouse) users.
      For all other channels this field is left empty until the booking is made. Inside the booking the expedient code
      (formerly known as expedient number is the user principal).</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      expedient number definition
    -->
	<xs:element name="Exp_No" type="xs:string">
		<xs:annotation>
			<xs:documentation>Expedient number served in booking requests only. A redisplay of an existing booking must always return
      the expedient number.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--booking expedient number definition for history-->
	<xs:element name="Bkg_Exp_No" type="xs:string">
		<xs:annotation>
			<xs:documentation>Expedient number served in history tag only. A redisplay of an existing booking must always return
      this expedient number in the history tag.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      front end channel definition
    -->
	<xs:element name="Chan">
		<xs:annotation>
			<xs:documentation>Frontend channel - Channel through which a request were passed on to the requesting client system (normally Musyk). The following values are known currently:
CHANNEL_CODE_START = "IPLUSST" - Request coming in through Amadeus Germany/Start System
CHANNEL_CODE_SABREDCS = "IPLUSDCS" - Request coming in through Sabre MerlinX / DCS System
CHANNEL_CODE_GALILEO = "IPLUSGAL" - Request coming in through Galileo
CHANNEL_CODE_TRAFFICS = "IPLUSTRA" - Request coming in through Traffics Austria
CHANNEL_CODE_TRAVEL_IT = "IPLUSTIT" - Request coming in through Travel IT
CHANNEL_CODE_RB_BLUM = "IPLUSRBB" - Request coming in through agency Blum
CHANNEL_CODE_WORLDSPAN = "IPLUSWOL" - Request coming in through Worldspan
CHANNEL_CODE_AIROB = "IPLUSAIR" - Request coming in through Air Ob
CHANNEL_CODE_BOSYS = "IPLUSBOS" - Request coming in through Bosys
CHANNEL_CODE_LTUR = "LTUR" - Request coming in through L'Tur
CHANNEL_CODE_HOPLA = "HOPLA" - Request coming in through Hopla
CHANNEL_CODE_INHOUSE = "inhouse" - Request coming in from TUI Inhouse workstation (special privileges)
CHANNEL_CODE_INHOUSE = "internet" - Request coming in from Internet-Channel (special privileges)
CHANNEL_CODE_B2C_WEB = "B2C_WEB" - Request coming in from VRP Web brand</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<!--
    Booking channel
  -->
	<xs:element name="Bkg_Chan">
		<xs:annotation>
			<xs:documentation>Frontend channel - Channel through which a request was passed requesting client system (normally Musyk).
The following values are known currently:
CHANNEL_CODE_START = "IPLUSST" - Request coming in through Amadeus Germany/Start System
CHANNEL_CODE_SABREDCS = "IPLUSDCS" - Request coming in through Sabre MerlinX / DCS System
CHANNEL_CODE_GALILEO = "IPLUSGAL" - Request coming in through Galileo
CHANNEL_CODE_TRAFFICS = "IPLUSTRA" - Request coming in through Traffics Austria
CHANNEL_CODE_TRAVEL_IT = "IPLUSTIT" - Request coming in through Travel IT
CHANNEL_CODE_RB_BLUM = "IPLUSRBB" - Request coming in through agency Blum
CHANNEL_CODE_WORLDSPAN = "IPLUSWOL" - Request coming in through Worldspan
CHANNEL_CODE_AIROB = "IPLUSAIR" - Request coming in through Air Ob
CHANNEL_CODE_BOSYS = "IPLUSBOS" - Request coming in through Bosys
CHANNEL_CODE_LTUR = "LTUR" - Request coming in through L'Tur
CHANNEL_CODE_HOPLA = "HOPLA" - Request coming in through Hopla
CHANNEL_CODE_INHOUSE = "inhouse" - Request coming in from TUI Inhouse workstation (special privileges)
CHANNEL_CODE_INHOUSE = "internet" - Request coming in from Internet-Channel (special privileges)
CHANNEL_CODE_B2C_WEB = "B2C_WEB" - Request coming in from VRP Web brand</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<!--
    Amendment channel
  -->
	<xs:element name="Amd_Chan">
		<xs:annotation>
			<xs:documentation>Frontend channel - Channel through which a request was passed requesting client system (normally Musyk).
The following values are valid in this case
CHANNEL_CODE_START = "IPLUSST" - Request coming in through Amadeus Germany/Start System
CHANNEL_CODE_SABREDCS = "IPLUSDCS" - Request coming in through Sabre MerlinX / DCS System
CHANNEL_CODE_GALILEO = "IPLUSGAL" - Request coming in through Galileo
CHANNEL_CODE_TRAFFICS = "IPLUSTRA" - Request coming in through Traffics Austria
CHANNEL_CODE_TRAVEL_IT = "IPLUSTIT" - Request coming in through Travel IT
CHANNEL_CODE_RB_BLUM = "IPLUSRBB" - Request coming in through agency Blum
CHANNEL_CODE_WORLDSPAN = "IPLUSWOL" - Request coming in through Worldspan
CHANNEL_CODE_AIROB = "IPLUSAIR" - Request coming in through Air Ob
CHANNEL_CODE_BOSYS = "IPLUSBOS" - Request coming in through Bosys
CHANNEL_CODE_LTUR = "LTUR" - Request coming in through L'Tur
CHANNEL_CODE_HOPLA = "HOPLA" - Request coming in through Hopla
CHANNEL_CODE_INHOUSE = "inhouse" - Request coming in from TUI Inhouse workstation (special privileges)
CHANNEL_CODE_INHOUSE = "internet" - Request coming in from Internet-Channel (special privileges)
CHANNEL_CODE_B2C_WEB = "B2C_WEB" - Request coming in from VRP Web brand</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<!--
    Cancellation channel
  -->
	<xs:element name="Cnx_Chan">
		<xs:annotation>
			<xs:documentation>Frontend channel - Channel through which a request was passed requesting client system (normally Musyk).
The following values are valid in this case
CHANNEL_CODE_START = "IPLUSST" - Request coming in through Amadeus Germany/Start System
CHANNEL_CODE_SABREDCS = "IPLUSDCS" - Request coming in through Sabre MerlinX / DCS System
CHANNEL_CODE_GALILEO = "IPLUSGAL" - Request coming in through Galileo
CHANNEL_CODE_TRAFFICS = "IPLUSTRA" - Request coming in through Traffics Austria
CHANNEL_CODE_TRAVEL_IT = "IPLUSTIT" - Request coming in through Travel IT
CHANNEL_CODE_RB_BLUM = "IPLUSRBB" - Request coming in through agency Blum
CHANNEL_CODE_WORLDSPAN = "IPLUSWOL" - Request coming in through Worldspan
CHANNEL_CODE_AIROB = "IPLUSAIR" - Request coming in through Air Ob
CHANNEL_CODE_BOSYS = "IPLUSBOS" - Request coming in through Bosys
CHANNEL_CODE_LTUR = "LTUR" - Request coming in through L'Tur
CHANNEL_CODE_HOPLA = "HOPLA" - Request coming in through Hopla
CHANNEL_CODE_INHOUSE = "inhouse" - Request coming in from TUI Inhouse workstation (special privileges)
CHANNEL_CODE_INHOUSE = "internet" - Request coming in from Internet-Channel (special privileges)
CHANNEL_CODE_B2C_WEB = "B2C_WEB" - Request coming in from VRP Web brand</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<!--
      start date definition
    -->
	<xs:element name="St_Dt">
		<xs:annotation>
			<xs:documentation>start date - begin date of the offer.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      end date definition
  -->
	<xs:element name="End_Dt">
		<xs:annotation>
			<xs:documentation>end date - end date of the offer.  Optional for insurance items ONLY (because @comRes calculates them while booking)!</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      price range definition
  -->
	<xs:element name="Prc_Range">
		<xs:annotation>
			<xs:documentation>price range - required price range for search, type can be "MIN" or "MAX". Total prices of an offer presented
    in a result list must match these price ranges exactly, were MIN and MAX are defined as included boundaries of the
    results. So e.g. a price range of [1000 - 2000] includes [1000, 1500, 1750, 2000], excluding [999, 2001]. Float
    values are not allowed as results. Defining an insane search like [MIN 1000] [MAX 500] leads to an empty result
    without further warnings or errors.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Value" type="xs:integer">
					<xs:annotation>
						<xs:documentation>
           Integer value of the boundary of a price range part.
        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Currency ISO code for the price range information</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="LimitType" use="required">
				<xs:annotation>
					<xs:documentation>upper (MAX) or lower limit (MIN) of the corresponding elements border.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="MIN">
							<xs:annotation>
								<xs:documentation>included minimum limit</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="MAX">
							<xs:annotation>
								<xs:documentation>included maximum limit</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
      currency code definition
    -->
	<xs:element name="CurISO" default="EUR">
		<xs:annotation>
			<xs:documentation>CurrencyISO: alphabetic 3LC code define by ISO-4217. Definition according defined by ISO. http://www.xe.com/iso4217.htm
      </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[A-Z]{3}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      promotion definition
    -->
	<xs:element name="Prom">
		<xs:annotation>
			<xs:documentation>Promotion:internal @comRes promotion code</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Nls_Errata" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Contains errata text, potentially in different locales.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="COM:Locale" minOccurs="0">
								<xs:annotation>
									<xs:documentation>locale of the errata text, may be empty if only one locale available</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Errata" type="xs:string">
								<xs:annotation>
									<xs:documentation>errata text</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Code" type="xs:string" use="required">
				<xs:annotation>
					<xs:documentation>Promotion code by @ComRes (4 characters?)</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Issue" type="xs:string" use="optional" default="1">
				<xs:annotation>
					<xs:documentation>issue/version info of the brochure for this promotion. Currently expected as always "1"</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Name" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>optional promotion description/name</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Prom_Group_Code" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>code of the promotion group to which this promotion belongs, e.g. the code for group TUI-D for the Promotion Vital</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Search_Category" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>the search category of this promotion, for example YIELD, CATALOG, AGT_OFFERS</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Is_Prebooking" type="xs:boolean" use="optional">
				<xs:annotation>
					<xs:documentation>indicates whether the promotion is a prebooking promotion or not.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--      Selling Promotion-->
	<xs:element name="Sell_Prom">
		<xs:annotation>
			<xs:documentation>Selling promotion</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Code" use="required">
				<xs:annotation>
					<xs:documentation>Selling promotion Code</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Issue"/>
			<xs:attribute name="Is_Prebooking" type="xs:boolean"/>
		</xs:complexType>
	</xs:element>
	<!--
      reference type definition
    -->
	<xs:element name="Ref">
		<xs:annotation>
			<xs:documentation>Reference: specify, which product type is referenced</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="FLIGHT">
					<xs:annotation>
						<xs:documentation>flight in a package</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="ROOMCODE">
					<xs:annotation>
						<xs:documentation>returns accos with rooms in packages.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="RT_ROOMCODE">
					<xs:annotation>
						<xs:documentation>returns roundtrips with rooms in packages.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="COMP_ROOMCODE">
					<xs:annotation>
						<xs:documentation>returns accos with rooms as components.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="COMP_RT_ROOMCODE">
					<xs:annotation>
						<xs:documentation>returns roundtrips with rooms as components.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="COMP_FLIGHT"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      accommodation stock code definition
    -->
	<xs:element name="Acc_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Accommodation stock code - specific accommodation key, @comRes stock code. The stock code is unique for an accommodation within one promotion. Therefore stock code
      together with promotion code build a unique identifier for an accommodation inside @ComRes (database).</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      location definition
    -->
	<xs:element name="Loc">
		<xs:annotation>
			<xs:documentation>location - location code and type for city, region or country</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Loc_Cd" type="xs:string">
					<xs:annotation>
						<xs:documentation>Location code - unique code of this geographical location. Can be City, Region or Country.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Loc_Tp">
					<xs:annotation>
						<xs:documentation>Location type - Type definition of the location id passed. Normally the location code by itself should already be unique here.
         </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="CITY">
								<xs:annotation>
									<xs:documentation>Send location id is expected to be a city.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="REGION">
								<xs:annotation>
									<xs:documentation>Send location id is expected to be a region.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="COUNTRY">
								<xs:annotation>
									<xs:documentation>Send location id is expected to be a country.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="AIRPORT"/>
							<xs:enumeration value="OTHER">
								<xs:annotation>
									<xs:documentation>the location type is not defined explicitly.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Loc_Name" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Optional description name of this location. Is not a primary key to identify the location.
         The language depends on the locale send in the request or is defined in the annotation of the request type for
         this field.
         Currenlty this field is in use for accommodation header data exports only.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      route list definition
    -->
	<xs:element name="Route_List">
		<xs:annotation>
			<xs:documentation>route list - Defines a list of routings related to the current request/response</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Routing" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>List of all route elements (outbound/inbound).</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      routing definition
    -->
	<xs:element name="Routing">
		<xs:annotation>
			<xs:documentation>Defines a set of corresponding outbound-inbound routes related to the current request/response</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Routing_Id" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Specify the routing element in a list.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:ByPass_Ext" minOccurs="0"/>
				<xs:element ref="COM:Include_WaitList" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Specify whether search for flights with the status 'Wait List'</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Car_Cd" minOccurs="0" maxOccurs="3">
					<xs:annotation>
						<xs:documentation>List of carrier codes (2 or 3LC IATA code) for the main airline</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:choice maxOccurs="unbounded">
					<xs:element ref="COM:Free_Chd_Avl" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Free child availability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Route" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>List of all route elements (outbound/inbound).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Train" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element ref="COM:Ferry" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element ref="COM:Coach" minOccurs="0" maxOccurs="unbounded"/>
				</xs:choice>
				<xs:element ref="COM:SubServPaxs" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Defines which passengers are allocated to this flight concerning the current context.
        This is necessary in case of a booking/display context.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Adt_Prc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Price for a passenger which type is adult</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Adt_Fuel" minOccurs="0"/>
				<xs:element ref="COM:Chd_Prc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Price for a passenger which type is child</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Chd_Fuel" minOccurs="0"/>
				<xs:element ref="COM:Inf_Prc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Price for a passenger which type is infant</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Inf_Fuel" minOccurs="0"/>
				<xs:element ref="COM:Tariff" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Price(s) applicable on the entire routing</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ext_Baggage" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Routing_Type" use="optional">
				<xs:annotation>
					<xs:documentation>tariff type</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="OW">
							<xs:annotation>
								<xs:documentation>indicates routing contains OW flights</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="OWR">
							<xs:annotation>
								<xs:documentation>indicates routing contains OWR flights</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="RT">
							<xs:annotation>
								<xs:documentation>indicates routing contains RT flights</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
    routing id definition
  -->
	<xs:element name="Routing_Id" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Specifier to identify a routing element in a list.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
    free child availability
  -->
	<xs:element name="Free_Chd_Avl" type="xs:integer">
		<xs:annotation>
			<xs:documentation>free child availability.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
    route id definition
  -->
	<xs:element name="Route_Id" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Specifier to identify a route element in a list.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
    Definition of Include_WaitList
  -->
	<xs:element name="Include_WaitList" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>Search parameter to specify whether to search for flights with status 'Wait List'</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      route definition
    -->
	<xs:simpleType name="Air_Cd_Tp">
		<xs:annotation>
			<xs:documentation>airport Code type: Airport, Area or Country</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIR"/>
			<xs:enumeration value="AREA"/>
			<xs:enumeration value="CTY1"/>
			<xs:enumeration value="CTY2"/>
			<xs:enumeration value="CTY3"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Route" type="COM:Route_Tp">
		<xs:annotation>
			<xs:documentation>one route defines the logical flight(s)</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     sector definition
    -->
	<xs:element name="Sec">
		<xs:annotation>
			<xs:documentation>sector - defines a physical flight</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Id" minOccurs="0"/>
				<xs:element name="SecId" type="xs:string" minOccurs="0"/>
				<xs:element name="SecCd" minOccurs="0">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="COM:RouteCd"/>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="Dep_Air_Cd">
					<xs:annotation>
						<xs:documentation>DepartureAirport3LC:
            IATA specific airport code for an departure airport. City codes as well as train stations are not supported here.
          See http://www.airlinecodes.co.uk/ for domain values.
         </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[A-Z]{3}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Arr_Air_Cd">
					<xs:annotation>
						<xs:documentation>
            ArrAir3LC - IATA specific airport code for an arrival airport. city codes as well as train stations are not supported here.
          See http://www.airlinecodes.co.uk/ for domain values.
         </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[A-Z]{3}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="COM:Flt_Dt_Tm" minOccurs="2" maxOccurs="2">
					<xs:annotation>
						<xs:documentation>FlightDate - flight date information. There has to be one for the ARRIVAL and one of type DEPARTURE.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:JnyDur" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Journey length in hours and minutes for this sector flight. If the flight stops somewhere, the stay time is not
         to be included into this journey duration.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Car_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>MainCarrierCode:2 or 3LC IATA code for the main airline. See http://www.airlinecodes.co.uk/ for domain values.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Cd_Shr_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>OperatingCarrierCode/Code Share Code - 2 or 3LC IATA code for the operating airline, if distinct to MainCarrierAirline</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Flt_No">
					<xs:annotation>
						<xs:documentation>Flight number - 4 digit flight number without carrier code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Cd_Shr_Flt_No" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Flight number - 4 digit flight number for code share flight without carrier code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Bkg_Cls" minOccurs="0">
					<xs:annotation>
						<xs:documentation>booking class definition. The airlines definition of the class within the aircraft</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Cab_Cls" minOccurs="0">
					<xs:annotation>
						<xs:documentation>cabin class definition (the main type like first class/business class/economy class)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Flt_Seq_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>FlightSeqCode - describes whether there are multiple flights on the same day for the same sector.
        Normally the first flight on the same day creates a "A", where the second one is the "B" flight and so on...</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Eqmt" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Equipment:code/abbreviation of aircraft type (e.g. "B737/8" or "H74" depending on the source system
        the code comes from. IATA-specific codes are preferred, since other codes are not mappable and can potentially not processed.
        See: http://www.airlinecodes.co.uk/arctypes.asp</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="EqmtDescription" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Equipment description (long text for the Eqmt code) (e.g. "Boeing 737-800" depending on the source system
        the code comes from.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Qty" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Quantity of available sector seats</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Seat_Res_Possible" type="xs:boolean" default="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Flag to indicate if seat reservations are possible.
This shall also be sent in the DisplaySeatMap- and ModifySeatReservationRequest because for external flights @comRes does not have this information.
</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ser_Sts" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Ser_Sts on Sec level is currently only used to indicate that a scheduled flight is on waitlist.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Check_In" minOccurs="0" maxOccurs="2"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      definition of TUI specific flight sequence cd
    -->
	<xs:element name="Flt_Seq_Cd">
		<xs:annotation>
			<xs:documentation>FlightSeqCode - describes whether there are multiple flights on the same day for the same sector.
        Normally the first flight on the same day creates a "A", where the second one is the "B" flight and so on...</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[A-Z0-9]"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!-- definition of route code -->
	<xs:simpleType name="RouteCd">
		<xs:annotation>
			<xs:documentation>Route code consisting of the departure airport/arrival airport + flight sequence character information.
                If possible, this information is to be re-send in booking requests.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<!--
     definition of main carrier code
    -->
	<xs:element name="Car_Cd">
		<xs:annotation>
			<xs:documentation>MainCarrierCode:2 or 3LC IATA code for the main airline. See http://www.airlinecodes.co.uk/ for value domain. For prebookings, to special codes can also be returned:IN? and EX? They can be ignored.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[A-Z0-9?]{2,3}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
    Definition of Only_Direct_Flight
  -->
	<xs:element name="Only_Direct_Flight" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>Search criteria to search AND return 'only' the 'Direct flights'.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     definition of journey duration
    -->
	<xs:element name="JnyDur">
		<xs:annotation>
			<xs:documentation>JourneyDuration:defines the duration of the journey in hours and minutes</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[0-9]{2}:[0-9]{2}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      booking class definition
   -->
	<xs:element name="Bkg_Cls">
		<xs:annotation>
			<xs:documentation>booking class - airline/aircraft related internal booking class abbreviation</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Code" type="xs:string">
				<xs:annotation>
					<xs:documentation>booking class code abbreviation, normally one character/digit</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
       cabin class definition
     -->
	<xs:element name="Cab_Cls">
		<xs:annotation>
			<xs:documentation>Cabin Class - Definition of a cabin class. A cabin class is defining a group of booking classes for one carrier,
    and is therefore something like a marketing separation. Normally one will find here concepts like "first class, business
    class, economy class".
    </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Code" type="xs:string">
				<xs:annotation>
					<xs:documentation>Cabin class abbreviation code, normally one character/digit</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Name" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>Cabin class long name description in specified request Locale</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
       occupancies block
     -->
	<xs:element name="Occs">
		<xs:annotation>
			<xs:documentation>list of all occupancies for package search</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Occ" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of occupancies to be held for this search</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      occupancy definition
  -->
	<xs:element name="Occ">
		<xs:annotation>
			<xs:documentation>Occupancy:defines a list of participants staying in one room. Each room definition
    contains information about adults, children as well as possible infants. If a participant's type cannot
    be identified, it is said to be an adult.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Pax" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Participants - Participants staying in the same room</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Rm_No" type="xs:integer" use="optional">
				<xs:annotation>
					<xs:documentation>defines the room number for the occupancy. The value starts with 1 always. Not to be used together with flight-only.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
    pax definition
   -->
	<xs:element name="Pax">
		<xs:annotation>
			<xs:documentation>participant - describe type, age and index of a participant</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Person" minOccurs="0"/>
				<xs:element ref="COM:Pax_Tp" minOccurs="0">
					<xs:annotation>
						<xs:documentation>is mandatory in any case of displaying/redisplaying of current booking</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Lead_Pax" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Age" type="xs:integer" use="optional">
				<xs:annotation>
					<xs:documentation>Participant age.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Index" type="xs:integer" use="required">
				<xs:annotation>
					<xs:documentation>counter for all participants for this booking. Start with 1</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Canceled" type="xs:boolean" use="optional">
				<xs:annotation>
					<xs:documentation>Flag to indicate that the participant is canceled. A participant is defined as canceled if he or
        she had a service association in a former booking version and now has no service association at all. In this case
        the participant as well as its information is considered as fix and not modifiable anymore. The participant is
        canceled.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Travel_Dox_Prt_Loc" type="xs:string">
				<xs:annotation>
					<xs:documentation>Travel documents printing location</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
     offers definition
    -->
	<xs:element name="Offers">
		<xs:annotation>
			<xs:documentation>container with all accommodation offers, flight offers and correlation to the participants to build up package tour offers</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Currency for the whole offer list</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element ref="COM:Accom">
						<xs:annotation>
							<xs:documentation>list of all accommodation offers</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Roundtrip">
						<xs:annotation>
							<xs:documentation>list of all roundtrip offers</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Complex_Offer">
						<xs:annotation>
							<xs:documentation>list of complex offers</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
				<xs:element ref="COM:Package" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of all packagetour offers</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Item_Set" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>A list of item sets that can be booked. The reason for suppling this is advise VRP the min and max items that must be booked from within this set</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Route_List" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of all routing offers</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:RailJourney" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Flt_Extra_Cat_List" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Car_Rental" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      accommodation definition
    -->
	<xs:element name="Accom">
		<xs:annotation>
			<xs:documentation>Accommodation: container for all attributes qualifying one accommodation offer</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Id" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the id of this service within the booking.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:St_Dt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>start date - start date of the accommodation stay. Is obsolete for allotment searches.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:End_Dt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>end date of the accommodation stay. Is obsolete for allotment searches.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Bkg_Level_Discount" minOccurs="0"/>
				<xs:element ref="COM:HtlPrd">
					<xs:annotation>
						<xs:documentation>hotel product of this accommodation</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Rm_Cd" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Room code - Room type definition. Type of current room defined here as code abbreviation.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ext_Ref_Id" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              In case the booking of this accommodation was created in an external system other than @ComRes, HOPLA or Mercado - e.g.
            HOPLA booked an IRIS hotel. An external reference id identifies the source for it.
           </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ext_Inv_Id" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              In case of external inventory hotels there is a need to show their reference id for B2C brands. So this is the
            original code from external inventories, where the acco stock code is the code under which @ComRes stores the
            accommodation.
           </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:SrcData" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Additional internal information for @ComRes for qualifying an offer
          of an external system.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Routing_Id" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Specifies the routing related to this accom to define one package.
          The passenger types from this accom define the passenger types (and their prices) to be applied in
          context of routes. Deprecated since replaced by route id? (LW, 2009-09-09)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Route_Id" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Specifies the possible routes to be combinable with the accom offer to define one package.
            These can be multiple outbound and multiple inbounds (see FlightVariants example 6).</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Memo" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>
            Potential memos (remarks, comments) bound to the accommodation. In this case erratas are expected to show up here.
            Which kind of memos exist and what are their meanings depends on the customer's configuration of the @ComRes system
            instance.
          </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Tot_Pck_Prc" type="COM:Prc_Type" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
             Total package price. Reserved element for @ComRes only. Not for VRP purposes!
           </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Tot_Acc_Prc" type="COM:Prc_Type" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Total accommodation price. Price for all rooms/participants for the accommodation (including any supplements, fees, discounts, etc.).</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Arrangement" minOccurs="0">
					<xs:annotation>
						<xs:documentation>description missing :-( Type not specified</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Forced_To_Top" type="xs:boolean" default="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>true, if the offer was forced to the top of the list ignoring the sort criteria.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Transfer_Info" minOccurs="0" maxOccurs="2">
					<xs:annotation>
						<xs:documentation>Information about the kind of transfer that is included.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Loc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the resort of the accom, only used for adhoc accoms</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Ref_Prd_Id" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
               linked to id
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:ServiceBreakDown" minOccurs="0"/>
				<xs:element ref="COM:Adhoc_Ser" minOccurs="0"/>
				<xs:element ref="COM:Adhoc_Name_List" minOccurs="0" maxOccurs="3"/>
				<xs:element ref="COM:Free_Car_Rental_Poss" minOccurs="0"/>
				<xs:element ref="COM:Boards" minOccurs="0">
					<xs:annotation>
						<xs:documentation>List of boards. Used only in RoomTypeVariantResponse</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Child_Price_Reduction" minOccurs="0"/>
				<xs:element ref="COM:Atol_Mth" minOccurs="0"/>
				<xs:element ref="COM:ByPass_Ext" minOccurs="0"/>
				<xs:element ref="COM:Dpt" minOccurs="0"/>
				<xs:element ref="COM:ByPass_Inv_Chk" minOccurs="0"/>
				<xs:element ref="COM:Override_Occ_Check" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Is_Adhoc" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>if true, indicates that the Accom is an Adhoc accom. If just the room is an adhoc room, the Accom is not an Adhoc accom (Is_Adhoc=false)</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Error" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>Set to true if service has an error and can not be booked</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
    Cruise Definition
  -->
	<xs:element name="Cruise">
		<xs:annotation>
			<xs:documentation>Cruise: container for all attributes qualifying one cruise offer</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Id" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the id of this service within the booking.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:St_Dt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>start date - start date of the cruise stay. Is obsolete for allotment searches.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:End_Dt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>end date of the cruise stay. Is obsolete for allotment searches.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:HtlPrd">
					<xs:annotation>
						<xs:documentation>hotel product of this cruise</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Dep_Port_Cd" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>departure port code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Arr_Port_Cd" type="xs:string" minOccurs="0"/>
				<xs:element name="Ship_Name" type="xs:string" minOccurs="0"/>
				<xs:element ref="COM:Rm_Cd" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Room code - Room type definition. Type of current room defined here as code abbreviation.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ext_Ref_Id" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              In case the booking of this cruise was created in an external system other than @ComRes, HOPLA or Mercado - e.g.
            HOPLA booked an IRIS hotel. An external reference id identifies the source for it.
           </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ext_Inv_Id" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              In case of external inventory hotels there is a need to show their reference id for B2C brands. So this is the
            original code from external inventories, where the acco stock code is the code under which @ComRes stores the
            accommodation.
           </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:SrcData" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Additional internal information for @ComRes for qualifying an offer
          of an external system.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Routing_Id" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Specifies the routing related to this cruise to define one package.
          The passenger types from this accom define the passenger types (and their prices) to be applied in
          context of routes. Deprecated since replaced by route id? (LW, 2009-09-09)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Route_Id" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Specifies the possible routes to be combinable with the cruise offer to define one package.
            These can be multiple outbound and multiple inbounds (see FlightVariants example 6).</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Memo" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>
            Potential memos (remarks, comments) bound to the cruise. In this case erratas are expected to show up here.
            Which kind of memos exist and what are their meanings depends on the customer's configuration of the @ComRes system
            instance.
          </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Tot_Pck_Prc" type="COM:Prc_Type" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
             Total package price. Reserved element for @ComRes only. Not for VRP purposes!
           </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Tot_Cru_Prc" type="COM:Prc_Type" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Total cruise price. Price for all rooms/participants for the accommodation (including any supplements, fees, discounts, etc.).</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Forced_To_Top" type="xs:boolean" default="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>true, if the offer was forced to the top of the list ignoring the sort criteria.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Transfer_Info" minOccurs="0" maxOccurs="2">
					<xs:annotation>
						<xs:documentation>Information about the kind of transfer that is included.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Loc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the resort of the accom, only used for adhoc accoms</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Ref_Prd_Id" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
               linked to id
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Adhoc_Ser" minOccurs="0"/>
				<xs:element ref="COM:Adhoc_Name_List" minOccurs="0" maxOccurs="3"/>
				<xs:element ref="COM:Boards" minOccurs="0"/>
				<xs:element ref="COM:Dpt" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Is_Adhoc" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>if true, indicates that the cruise is an Adhoc cruise</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Error" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>Set to true if service has an error and can not be booked</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
     participant type definition
   -->
	<xs:element name="Pax_Tp">
		<xs:annotation>
			<xs:documentation>ParticipantType - Definition of a participant type. The type depends on the age of a participant
      when doing the actual travel and it depends on the type of service (which accommodation normally).
      Therefore a type is applicable only if there is a relationship between a participant, a time stamp
      and a service.
      </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="ADULT">
					<xs:annotation>
						<xs:documentation>Adult type</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="CHILD">
					<xs:annotation>
						<xs:documentation>Child type</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="INFANT">
					<xs:annotation>
						<xs:documentation>Infant type</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<!--xs:enumeration value="YOUTH">
          <xs:annotation>
            <xs:documentation>Youth type</xs:documentation>
          </xs:annotation>
        </xs:enumeration-->
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      Lead Passenger
    -->
	<xs:element name="Lead_Pax" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>Lead Passenger</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      Passenger service allocation definition
    -->
	<!--
     Passenger Service Allocation (Links pax to rooms/service) Correlation
    -->
	<!--
      price definition
    -->
	<xs:complexType name="Prc">
		<xs:annotation>
			<xs:documentation>
            Definition of a price, containing a currency code and an amount
        </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="COM:CurISO" minOccurs="0">
				<xs:annotation>
					<xs:documentation>currency code for current price</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Amt">
				<xs:annotation>
					<xs:documentation>amount of price</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--
      booking state
    -->
	<xs:element name="BkgSts">
		<xs:annotation>
			<xs:documentation>BookingState:Booking state (target or current depending on context)</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="BOOKING">
					<xs:annotation>
						<xs:documentation>Depending on Res_Sts either fixed booked or on request booked.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="OPTION">
					<xs:annotation>
						<xs:documentation>Booking is to be booked as an option reservation or was booked as an option (depending on the perspective).</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="CANCELED">
					<xs:annotation>
						<xs:documentation>The booking was canceled and cannot be modified in terms of services, participants or relationships between both anymore.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="QUOTE">
					<xs:annotation>
						<xs:documentation>Internal state of @ComRes for a persistent but not reserved state of service. The allotments of the services
          are not changed for quotes.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="FIX">
					<xs:annotation>
						<xs:documentation>Only for compatibility with interface version 2, not used in version 3.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="PREBOOKING">
					<xs:annotation>
						<xs:documentation>status indicating a prebooking</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      booking state 2
    -->
	<xs:element name="BkgSts_2">
		<xs:annotation>
			<xs:documentation>BookingState2: Additional booking state information</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="BOOKING">
					<xs:annotation>
						<xs:documentation>Option Booking  (Should only be set if BKG_STS = OPT)</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="OPTION">
					<xs:annotation>
						<xs:documentation>Cancelled Option  (Should only be set if BKG_STS = CNX)</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      commit state
    -->
	<xs:element name="ResSts" default="CONFIRMED">
		<xs:annotation>
			<xs:documentation>Commit state of a booking. Can be confirmed or requested.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="CONFIRMED">
					<xs:annotation>
						<xs:documentation>confirmed</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="REQUESTED">
					<xs:annotation>
						<xs:documentation>requested</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="DENIED">
					<xs:annotation>
						<xs:documentation>requested booking was denied</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      service booking state
    -->
	<xs:element name="Ser_Sts">
		<xs:annotation>
			<xs:documentation>
         Service states - Booking state for one service (room code or route),target or current depending on context
       If it is a target booking state (e.g. service can be booked as option or fix booking) multiple states can appear
       for the same service. Fix and option bookings normally appear together, if option is possible. There is no case
       where option will occur standalone. On request state cannot be mixed with option or fix on the same service.
       The states ONREQUEST and QUOTE do never occur together with other states for the same service.
      </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="FIX">
					<xs:annotation>
						<xs:documentation>Defines a fix booking. The service can either be booked fix (means deposit is due)
or was booked as fix (cancellation or modifications fees might apply for removal).</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="OPTION">
					<xs:annotation>
						<xs:documentation>Defines an option booking. This is a reservation for a fix duration.
Depending on the behavior of @ComRes the service will become fix or canceled after a while.
For option booking normally no amount has to be paid.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="ONREQUEST">
					<xs:annotation>
						<xs:documentation>Service is on request or can only be booked on request. This normally means
the allotment has expired or the service is sold out and can be requested by the tour operator.
An on request booking can either fail or transformed to a fix booking.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="CANCELLED">
					<xs:annotation>
						<xs:documentation>The service was canceled.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="QUOTE">
					<xs:annotation>
						<xs:documentation>Internal state of a booking in @ComRes which is a not reserved but simply
stored state of a booking in the backend system.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="WAITLIST">
					<xs:annotation>
						<xs:documentation>Booking state for wait list bookings</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="UNAVAILABLE">
					<xs:annotation>
						<xs:documentation>indicates that this service is not available and can't be booked.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="ONREQUEST_CONFIRMED">
					<xs:annotation>
						<xs:documentation>Booking state for requested services that are confirmed</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value=""/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      amount definition
  -->
	<xs:element name="Amt">
		<xs:annotation>
			<xs:documentation>Definition of an amount. The currency code is set only once for the whole result.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      hotel product definition
    -->
	<xs:element name="HtlPrd">
		<xs:annotation>
			<xs:documentation>HotelProduct: describe the accommodation with it static attributes</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Name" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Hotel product name might be season dependent. If the information will be in a VRP product database there is no need to send</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Prom" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Promotion the hotel is related to</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Acc_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Stock code for accommodation, optional for Adhoc accom items</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Acc_InvState" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Flag if product is from internal or external inventory</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Hotel" minOccurs="0">
					<xs:annotation>
						<xs:documentation>If all the information will be in a VRP product database there is no need to sent in response</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Cat_Page" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of catalog pages where this product is described</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Promo_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>List of product flags, e.g. Topseller</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Sort_Prio" minOccurs="0"/>
				<xs:element ref="COM:Sort_No" minOccurs="0"/>
				<xs:element ref="COM:Ship_Cd" minOccurs="0"/>
				<xs:element ref="COM:Ship_Name" minOccurs="0"/>
				<xs:element ref="COM:Ext_Acc_Cd" minOccurs="0"/>
				<xs:element ref="COM:Ext_Acc_Name" minOccurs="0"/>
				<xs:element ref="COM:Legacy_Acc_Cd" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      hotel definition
    -->
	<xs:element name="Hotel">
		<xs:annotation>
			<xs:documentation>Information about hotel's address, communication and attributes.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Add" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Hotel's address. Can be normally skipped inside a response, if this information
            is stored in the VRP database also.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Comm" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Communication (telephone, fax, mail, ...) of the hotel.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Star_Rating" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number of stars for this hotel.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Loc" minOccurs="0" maxOccurs="2">
					<xs:annotation>
						<xs:documentation>Location of this hotel</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Htl_Chain_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the hotel chain for which products are searched</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--hotel chain definition-->
	<xs:element name="Htl_Chain_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>the hotel chain code of the hotel chain to which this hotel belongs</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      room code definition
    -->
	<xs:element name="Rm_Cd">
		<xs:annotation>
			<xs:documentation>Room code - For each room code inside an accommodation that is
      referenced in use by a traveler, there is an own room element.
      E.g. two double rooms for four participants in total leads to two
      room code element referenced by four persons where each of them references two paxs.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Rm_No" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Room number. The room number corresponds to the requested
          occupancy.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Code" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>@ComRes room type code to identify the type of the room</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Desc" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>description - describes the room type like "Twin" or "Suite"</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Fac_List" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>FacilityList - describes the room facilities according to VRP requirements (storyboards)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Facility_List" minOccurs="0">
					<xs:annotation>
						<xs:documentation>List of Room Facilities (Code and Name</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="StopSaleOverridden" type="xs:boolean" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Stop Sale Overridden</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Qty" minOccurs="0">
					<xs:annotation>
						<xs:documentation>room type related quantity. If the quantity is irrelevant (e.g. for package tour result
            where the rooms related are expected to be available anyway) the field is optional</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Inf_Inc_Occ" type="xs:boolean" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Are Infants allowed to occupy the Room?</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Min_Pax" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Minimum number of participants (excluding infants) which can stay in this room.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Max_Pax" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Maximum number of participants (excluding infants) which can stay in this room.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Max_Adu" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Maximum number of adults which can stay in this room.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Max_Chd" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Maximum number of children which can stay in this room.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Max_Inf" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number Of Cots</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Std_Pax" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Standard Occupancy</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Min_Adu" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Minimum Adults</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Min_Chd" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Minimum Children</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:BB_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Board base code - @ComRes board base code. We expect the same board base for all participants inside this room.
            This matches our current customer requirements. Otherwise we would have to introduce a separate board base
            element beside the existing room element.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:BB_Name" minOccurs="0"/>
				<xs:element name="Alt_BB_Cd" type="xs:string" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>AlternateBoardingCode - @ComRes board base code. This is an alternative to the BoardingCode for this room.
            Is is applicable only in Booking-, Display- and ModifyingResponses as well as AllotmentResponses for
            accommodations. It is not applicable for variant searches on hotels cause there the client needs a
            separate price for each room/board base combination. AlternateBoardingCodes do not influence the price
            of the room code which is build up by the standard boarding code.
            It is used to avoid to count the same room type multiple times. Inside an offer there is always one
            boarding code, alternatives are optional. When doing the actual booking the alternatives can be left
            empty inside the request (not the response!) where the boarding code field must be filled.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Meal_Sitting" type="xs:string" minOccurs="0"/>
				<xs:element ref="COM:Ser_Sts" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Service states - In the search results the possible target booking state(s),
           for booking/modify -request/response the required/actual booking state</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:SubServPaxs" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Persons assigned to this room</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Prices" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
                Prices bound to this room.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Misc_Cost" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Tot_Prc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
                Total price for whole room.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:No_Adt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
               Number of adults from @ComRes point of view.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:No_Chd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number of children from @ComRes point of view.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:No_Inf" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number of infants from @ComRes point of view.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:choice minOccurs="0">
					<xs:annotation>
						<xs:documentation>No_Free_Chd will be returned when exact pax details are known within each room (Occ contains Rm_No attribute)  and Free_Chd_Poss node will be returned when only total party is known and not assigned to each room</xs:documentation>
					</xs:annotation>
					<xs:element ref="COM:No_Free_Chd" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Number of free children</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Free_Chd_Poss" minOccurs="0"/>
				</xs:choice>
				<xs:element ref="COM:No_Adt_Prc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number of adults the pricing algorithm uses when calculation the total price. Note some children may priced as adults</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:No_Chd_Prc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number of children the pricing algorithm uses when calculation the total price. Note some children may priced as adults</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:No_Inf_Prc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number of infants the pricing algorithm uses when calculation the total price.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Adt_Prc" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Price of an adult served by the @ComRes cache. There can be as many adult prices as the No_Adt_Prc indicates.
             Because @ComRes is limited to serve up to three adult prices only the No_Adt_Prc can be potentially higher than the number
             of Adt_Prc elements. Each price element must exactly define one price for one passenger where the price/passenger association
             is unique throughout the whole accommodation element.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Adt_Prc_Ex" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Chd_Prc" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Price of a child served by the @ComRes cache. There can be as many child prices as the No_Chd_Prc indicates.
             Because @ComRes is limited to serve up to three child prices only the No_Chd_Prc can be potentially higher than the number
             of Chd_Prc elements. Each price element must exactly define one price for one passenger where the price/passenger association
             is unique throughout the whole accommodation element.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Chd_Prc_Ex" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Inf_Prc" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Price of an infant served by the @ComRes cache. There can be as many infant prices as the No_Inf_Prc indicates.
             Because @ComRes is limited to serve one infant prices only the No_Inf_Prc can be potentially higher than the number
             of Inf_Prc elements. Each price element must exactly define one price for one passenger where the price/passenger association
             is unique throughout the whole accommodation element.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Inf_Prc_Ex" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:SrcData" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Information needed to fulfill search and booking process in external systems.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Avail" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Rooms Available</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Request" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Rooms Available to request</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Yield_Late_Sup" minOccurs="0"/>
				<xs:element ref="COM:Inv_Min_Chd_Age" minOccurs="0"/>
				<xs:element ref="COM:Inv_Max_Chd_Age" minOccurs="0"/>
				<xs:element ref="COM:Prc_Min_Chd_Age" minOccurs="0"/>
				<xs:element ref="COM:Prc_Max_Chd_Age" minOccurs="0"/>
				<xs:element ref="COM:Prc_Mth" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Price method - PP Per person, RM - Room Price IF PP the Adt_Prc is a per person price, If RM, then Adt_Prc is the total room price.
								Only applicable for accom only.
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Comparison_Price" minOccurs="0"/>
				<xs:element ref="COM:Ext_Ref_Id" minOccurs="0"/>
				<xs:element ref="COM:Ext_Rm_Cd" minOccurs="0"/>
				<xs:element ref="COM:Ext_Rm_Name" minOccurs="0"/>
				<xs:element ref="COM:Ext_BB_Cd" minOccurs="0"/>
				<xs:element ref="COM:Ext_BB_Name" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Is_Adhoc" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>if true, indicates that the Room is an Adhoc room.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!-- room number definition
  -->
	<xs:element name="Rm_No" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Specifier to identify the room number. The room number is corresponding between occupancy tag in request and room code tag in response.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      inventory state definition
    -->
	<xs:element name="Acc_InvState">
		<xs:annotation>
			<xs:documentation>Flag to specify if the product are listed in the internal or an external inventory</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="INTERNAL">
					<xs:annotation>
						<xs:documentation>Internal inventory where accommodation comes from.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="EXTERNAL">
					<xs:annotation>
						<xs:documentation>External inventory where accommodation comes from.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      quantity definition
  -->
	<xs:element name="Qty">
		<xs:annotation>
			<xs:documentation>Quantity of an element for a special allotment type</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Avl" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      flight date definition
    -->
	<xs:element name="Flt_Dt_Tm">
		<xs:annotation>
			<xs:documentation>date and time for arrival or departure in local and UTC format</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Local" type="xs:string">
					<xs:annotation>
						<xs:documentation>
            Flight time definition as local time in the format YYYY-MM-DDTHH:MM:SS.mmm(+/-)(Timezone-diff), like
            2008-01-01T12:00:00.000+02:00
            </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="DirType">
				<xs:annotation>
					<xs:documentation>Direction type, can be ARRIVAL or DEPARTURE</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ARRIVAL">
							<xs:annotation>
								<xs:documentation>This is the flight time for the arrival</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="DEPARTURE">
							<xs:annotation>
								<xs:documentation>This is the flight time for the departure</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="TimeFilter">
				<xs:annotation>
					<xs:documentation>Flag to suggest whether to interpret the given time as AT or AFTER or BEFORE</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="AT_OR_AFTER">
							<xs:annotation>
								<xs:documentation>Flag to interpret the time as exactly AT or AFTER (but before 0:00 of the next day) the given time</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="AT_OR_BEFORE">
							<xs:annotation>
								<xs:documentation>Flag to interpret the time as AT or BEFORE (but starting at 0:00:00 of the specified day) the given time</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
     server message definition
    -->
	<xs:element name="Ser_Msg">
		<xs:annotation>
			<xs:documentation>ServerMessage:
      Message sent by the server only for information purposes to the client. This can
      be any kind of information (e.g. warnings cause external systems were not available
      or result couldn't be retrieved before timeout occurred) or error/fatal message
      (e.g. parsing of XML failed, missing fields in XML, database not available,...).
      We distinguish three kinds of severity here:
      INFO - this is only an information by the backend system, the transaction were successfully
      executed until the message was added to the result (e.g. "100 results retrieved from database").
      WARN - there was a problem performing the transaction. The reason was e.g. a missing value in the
      XML send by the client, but a default value could be applied or a backend system did not respond
      but other systems did.
               ERROR - the transaction execution failed cause of e.g. validation problem, invalid data send in,
      wrong XML version, accommodation is sold out or other reasons that lead to a rollback in
      the backend system. In case of an error the request was not successfully executed. All other
      data (e.g. offers) contained in the response is invalid.
    </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Severity">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="INFO">
								<xs:annotation>
									<xs:documentation>Message with severity info</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="WARN">
								<xs:annotation>
									<xs:documentation>Message with severity warning</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="ERROR">
								<xs:annotation>
									<xs:documentation>Message with severity error</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Code" type="xs:string">
					<xs:annotation>
						<xs:documentation>internal number or internal code to identify the message</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Desc" type="xs:string">
					<xs:annotation>
						<xs:documentation>description - static part of the message description. Could contain placeholder for dynamic parts.
          Definition of the placeholder: {}. E.g. "The accommodation {name} is no longer available". There can be up to 9 placeholders in one static
          description. The values for the placeholders are in this case to be located in the optional parameters
          elements.
          </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:KeyValuePair" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>
          optional list of dynamic values to be combined with the static part placeholders in the message
          description. There have to be as much parameters as there are placeholders inside the description
          element, but there can be even more if needed.
          E.g. key="name", value="1234". So the
          </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:System" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The Identity of the System that raised the error</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
     key value pair definition
    -->
	<xs:element name="KeyValuePair">
		<xs:annotation>
			<xs:documentation>general key/value pair definition for multiple purposes</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Key" type="xs:string" use="required">
						<xs:annotation>
							<xs:documentation>key for key value pair, must not be null</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<!--
      travel documents definition
    -->
	<xs:element name="TrvDox">
		<xs:annotation>
			<xs:documentation>TravelDocuments:Describes information related to travel documents</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="DocumentReceiver">
					<xs:annotation>
						<xs:documentation>Flag whether the documents will send to customer or agency</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="PAYER">
								<xs:annotation>
									<xs:documentation>Documents go to the payer of the journey (payment owner)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="AGENCY">
								<xs:annotation>
									<xs:documentation>Documents go to the agency selling the journey</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DoxLang" type="COM:Locale_Type">
					<xs:annotation>
						<xs:documentation>Language in which the travel documents are to be created.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Travel_Dox_Prt_Dt" type="xs:dateTime" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Travel documents print date - Date when then travel documents were printed</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Next_Travel_Dox_Prt_Dt" type="xs:dateTime" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The next travel document print date. Never sent by VRP.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Travel_Dox_Dep_Dt" type="xs:dateTime" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The virtual departure date for calculate the travel documents print date - Date when the printing of travel documents should be performed</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Travel_Dox_Prt_Loc" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Travel documents printing location - The location (Airport IATA code) where the travel documents will be printed (if never printed before) or where they have been printed the last time.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Next_Travel_Dox_Prt_Loc" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the location where the travel documents will be printed when they are printed the next time. Only returned by @comRes when a print is pending.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ConfPrt" type="xs:boolean" default="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Flag if the client will print the confirmation. Information about this will be stored at @comRes</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Conf_Prt_Dt" type="xs:dateTime" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Confirmation print date - Date when the confirmation was printed. Ever the last date will be stored, no history</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Conf_Prt_Usr" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Confirmation print user - Terminal code or user of the executing expedient</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Conf_Prt_Place" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Confirmation print place - describe the place, where the confirmation was printed</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Travel_Dox_Stop" type="xs:boolean" default="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>'stop voucher' - Information voucher print is stopped in @comres</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Conf_Stop" type="xs:boolean" default="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>'Stop confirmation' - Information if print of confirmation is stopped in @comres</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Travel_Dox_No_Price" type="xs:boolean" default="true" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Indicates if the travel docs shall contain prices</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Travel_Dox_Per_Person" type="xs:boolean" default="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Indicates if the travel docs are printed once per booking or once for each person.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Control_Cd" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>a document control code, for example Q (=RBE an Abteilung Gruppenreisen)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Print_Voucher_Immed" type="xs:boolean" default="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Flag to indicate that the voucher is printed together with the Travel confirmation. If true, displays the message "Unterlagen am TUI Schalter, Berechtigungsschein bitte ausdrucken" in IRIS.plus</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Conf_Prt_Tp" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="EMAIL"/>
							<xs:enumeration value="PRINT"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
     payer definition
    -->
	<xs:element name="Payer">
		<xs:annotation>
			<xs:documentation>The owner of a payment used in the payment process of the booking</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Person" minOccurs="0">
					<xs:annotation>
						<xs:documentation>credit card number without spaces</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="CusId" type="xs:string">
				<xs:annotation>
					<xs:documentation>The KUBA customer id, is unique in combination with SysId and MandatorId only.
           For Musyk front end the defaults are: T and MUSY, for B2C-VRP-brands the defaults are: T and IRIS</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="SysId" type="xs:string" use="optional" default="MUSY">
				<xs:annotation>
					<xs:documentation>System id as used to store the customer in KUBA. Will be MUSY for Musyk and
          IRIS for B2C brands.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="MandatorId" type="xs:string" use="optional" default="T">
				<xs:annotation>
					<xs:documentation>Mandator id as used to store the customer in KUBA. Will be "T" normally for Musyk as
          well as for B2C brands.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
       credit card payment definition
   -->
	<xs:element name="CCPay">
		<xs:annotation>
			<xs:documentation>CreditCardPayment: Definition of a credit card payment with which services are paid</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CNum" minOccurs="0">
					<xs:annotation>
						<xs:documentation>credit card number without spaces</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9A-Z*]{7,}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ExpDate" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Expiration date of credit card in form of MM/YY</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-2][0-9]/[0-9][0-9]"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="COM:Payer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Owner of the payment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="PayAmt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Payent Amount</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Card_Secur_Num" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Card security number - last digits from the back of the card</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="8"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Card_Valid_From_Dt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Card valid from date
              Format MM/DD
            </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-2][0-9]/[0-1][0-9]"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Card_Issue_Num" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Card issue number</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:FeeAmt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Credit card fee. This needs to be returned in the BookingRequest and ModifyCustPayment if a CC Fee is to be applied to teh booking</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Is_Loyalty_Card" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Is_Loyalty_Card</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="CCType" type="xs:string">
				<xs:annotation>
					<xs:documentation>Official type name of credit card.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Card_Issuer" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>Optional information about the issuer. For TUI Cards this is always TUI</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Card_Cd" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>Issuer credit card code - Optional information about the issuer code. For TUI Cards this can be e.g. TKK, TGC,...</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Card_Desc" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>Issuer credit card description - Name how the issuer names its credit card</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
       account payment
     -->
	<xs:element name="AccPay">
		<xs:annotation>
			<xs:documentation>German bank account data for paying with a bank account (Lastschrift)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="AccNum" type="xs:string">
					<xs:annotation>
						<xs:documentation>Current account number for this bank account</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="BankCode" type="xs:string">
					<xs:annotation>
						<xs:documentation>Bank code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Payer">
					<xs:annotation>
						<xs:documentation>Owner of this bank account</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
       bank transfer (Ueberweisung) payment
     -->
	<xs:element name="Bank_Trans_Pay">
		<xs:annotation>
			<xs:documentation>bank transfer payment (Uberweisung)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Payer">
					<xs:annotation>
						<xs:documentation>payer of this payment</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
       agency payment definition
     -->
	<xs:element name="Agt_Pay">
		<xs:annotation>
			<xs:documentation>AgencyPay - Booking will be paid in the agency. The tour operator will charge the agency.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence minOccurs="0"/>
		</xs:complexType>
	</xs:element>
	<!--
       payment form (Zahlschein/Überweisungsträger/UET) payment
     -->
	<xs:element name="Payment_Form_Pay">
		<xs:annotation>
			<xs:documentation>Booking will be paid via a payment form (Zahlschein/Überweisungsträger/UET)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Payer"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
       New Payments to be Applied to the Booking
     -->
	<xs:element name="NewPayments">
		<xs:annotation>
			<xs:documentation>New Payments to be Applied to the Booking</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Pay" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
       payment data definition
     -->
	<xs:element name="PayData">
		<xs:annotation>
			<xs:documentation>Payment data describes all payment related information for the current booking.
    The payment information consists of fees, credit advices, current payment types and so on.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Dpt" minOccurs="0" maxOccurs="2">
					<xs:annotation>
						<xs:documentation>Deposit - Deposit payment data</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Bkg_Prc_Ex" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Total price of booking excluding fees. So this is the actual current sum of all active service prices for all active participants.
This element may occur only once per CurISO! It may occur more than once to indicate prices in different currencies.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Bkg_Prc_Inc" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Total price of booking including fees.
This element may occur only once per CurISO! It may occur more than once to indicate prices in different currencies.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Pay" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Payment - Current payment. The current payment is the payment to be used for charge when the next amount to be paid is due.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Payment" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Information about one payment, either from the payer or to the payer in case of a reimbursement</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Tot_Amt" minOccurs="0">
					<xs:annotation>
						<xs:documentation/>
					</xs:annotation>
				</xs:element>
				<xs:element name="Agt_Com" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="COM:Comm_Inc_VAT" minOccurs="0">
					<xs:annotation>
						<xs:documentation/>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:VAT" minOccurs="0">
					<xs:annotation>
						<xs:documentation/>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Payment_Received" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation/>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Bkg_Cst" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation/>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:TO_Comm_Amt" minOccurs="0"/>
				<xs:element ref="COM:TO_Comm_Amt_Calc" minOccurs="0"/>
				<xs:element ref="COM:Third_Party_CCFee" minOccurs="0"/>
				<!-- ensure this remains last element in PayData else will cause xsd validation errors -->
			</xs:sequence>
			<xs:attribute name="BkgId">
				<xs:annotation>
					<xs:documentation>Booking number this pay data belongs to. Only used when making booking CRS</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Bkg_Cst">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Currency used here</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amt">
					<xs:annotation>
						<xs:documentation>Amount</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
       Dpt definition
    -->
	<xs:element name="Dpt">
		<xs:annotation>
			<xs:documentation>Deposit payment</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Currency to be applied here</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Amount to be paid.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Dep_Dt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Depositdate - date of payment flow</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type">
				<xs:annotation>
					<xs:documentation>Type - LOW or HIGH</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="LOW"/>
						<xs:enumeration value="HIGH"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!-- Bkg_Prc_Ex def. -->
	<xs:element name="Bkg_Prc_Ex">
		<xs:annotation>
			<xs:documentation>Booking price excluding fees/taxes.
       Total price of booking neglecting whether there are any kind of fees.
       So this is the total sum of all active services for all active participants.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Currency used here</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amt">
					<xs:annotation>
						<xs:documentation>Amount to be paid</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- booking price including -->
	<xs:element name="Bkg_Prc_Inc">
		<xs:annotation>
			<xs:documentation>Booking price including fees/taxes.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Currency used here</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amt">
					<xs:annotation>
						<xs:documentation>Amount to be paid</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Bal_Due_Amt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Ba;ance Due amount, i.e. Total amount minus dpt</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Bal_Due_Dt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Balance due date - date of payment flow</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="COM:Next_Amt_Due" minOccurs="0"/>
				<xs:element ref="COM:Next_Amt_Due_Dt" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
       payment definition
     -->
	<xs:element name="Pay">
		<xs:annotation>
			<xs:documentation>
         Payment - Describes one current payment. Only one payment out of the list of payments assignable
       here is allowed inside one payment XML element!
       </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:choice>
					<xs:element ref="COM:Agt_Pay" minOccurs="0">
						<xs:annotation>
							<xs:documentation>agency payment</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:CCPay" minOccurs="0">
						<xs:annotation>
							<xs:documentation>credit card payment</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Payment_Form_Pay" minOccurs="0">
						<xs:annotation>
							<xs:documentation>payment form payment</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Bank_Trans_Pay" minOccurs="0">
						<xs:annotation>
							<xs:documentation>bank transfer (?berweisung) payment</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:AccPay" minOccurs="0">
						<xs:annotation>
							<xs:documentation>bank account payment</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Other_Payment" minOccurs="0">
						<xs:annotation>
							<xs:documentation>other payment</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
				<xs:element ref="COM:Pay_Seq" minOccurs="0">
					<xs:annotation>
						<xs:documentation>sequencet</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the amout of the payment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Exch_Rate" minOccurs="0">
					<xs:annotation>
						<xs:documentation>currency of the payment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>currency of the payment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:AuthCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>auth code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:TransNo" minOccurs="0"/>
				<xs:element ref="COM:PayDtTm" minOccurs="0"/>
				<xs:element ref="COM:PayDetails" minOccurs="0"/>
				<xs:element ref="COM:Pay_Group" minOccurs="0"/>
				<xs:element ref="COM:AuthSys" minOccurs="0"/>
				<xs:element ref="COM:Pay_Type_Code" minOccurs="0"/>
				<xs:element ref="COM:Pay_Method" minOccurs="0"/>
				<xs:element ref="COM:Settle_Method" minOccurs="0"/>
				<xs:element ref="COM:Recon_Type" minOccurs="0"/>
				<xs:element ref="COM:Recon_Method" minOccurs="0"/>
				<xs:element ref="COM:Recon_Reason_Note" minOccurs="0"/>
				<xs:element ref="COM:Payment_User" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--Other_Payment-->
	<xs:element name="Other_Payment">
		<xs:annotation>
			<xs:documentation>Other Payment</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Payer" minOccurs="0"/>
				<xs:element ref="COM:Payment_Number" minOccurs="0"/>
				<xs:element ref="COM:Staff" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AuthSys">
		<xs:annotation>
			<xs:documentation>
				AuthSys. Possible values:
				CPSI - CPS-Integated
                CPSNI - CPS-Non-Integrated
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="CPSI"/>
				<xs:enumeration value="CPSNI"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PayDetails">
		<xs:annotation>
			<xs:documentation>payment details</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="AuthCode">
		<xs:annotation>
			<xs:documentation>auth code</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="16"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TransNo">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="16"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PayDtTm" type="xs:dateTime"/>
	<xs:element name="Tot_Amt">
		<xs:annotation>
			<xs:documentation>Total amount</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Comm_Inc_VAT">
		<xs:annotation>
			<xs:documentation>Commission including VAT</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="VAT">
		<xs:annotation>
			<xs:documentation>VAT</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Payment_Received">
		<xs:annotation>
			<xs:documentation>Payment received</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      due date
    -->
	<xs:element name="Due_Dt">
		<xs:annotation>
			<xs:documentation>Balance due date - date of payment flow</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
      customer definition
    -->
	<xs:element name="Cus">
		<xs:annotation>
			<xs:documentation>Customer is a role of a person. The person inside the booking workflow that
       makes the contract with the tour operator/agency is said to be the customer. The customer can
       but does not have to travel.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="CusId" type="xs:string">
				<xs:annotation>
					<xs:documentation>The KUBA customer id for the mandator T and system MUSY combination.
          There has to be one CustomerDefinition entry for each unique customer id inside a request or response.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="SysId" type="xs:string" use="optional" default="MUSY">
				<xs:annotation>
					<xs:documentation>System id as used to store the customer in KUBA. Will be MUSY for Musyk and IRIS for B2C brands.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="MandatorId" type="xs:string" use="optional" default="T">
				<xs:annotation>
					<xs:documentation>Mandator id as used to store the customer in KUBA. Will be "T"normally for Musyk as well as for B2C brands.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
      person definition
    -->
	<xs:element name="Person">
		<xs:annotation>
			<xs:documentation>A person is a natural human being or a company with its address and telephone/email data</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:annotation>
					<xs:documentation>
              Address information, multiple addresses can potentially stored here. KUBA is
            aware of one address only, where VRP has no limits.
           </xs:documentation>
				</xs:annotation>
				<xs:element ref="COM:Add" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of addresses of the person</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Comm" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Communication - list of contact numbers of the person</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Email" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of email addresses of the person</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:FirstName" minOccurs="0"/>
				<xs:element ref="COM:MiddleName" minOccurs="0"/>
				<xs:element ref="COM:LastName" minOccurs="0"/>
				<xs:element name="DateOfBirth" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Date of birth in format YYYY-MM-DD</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Nobility" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Nobility of this person e.g. BARON, GRAF, ...</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Title" minOccurs="0"/>
				<xs:element name="Sex" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Person's sex.
                        Different gender of person.
                    SEX_MALE for a male person.
                    SEX_FEMALE for a female person.
                  SEX_UNKNOWN for a person with unknown sex / companies
                        </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="SEX_UNKNOWN">
								<xs:annotation>
									<xs:documentation>Gender of person is unknown. This is true e.g. if the person is a company.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="SEX_MALE">
								<xs:annotation>
									<xs:documentation>a male.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="SEX_FEMALE">
								<xs:annotation>
									<xs:documentation>a female.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PersonType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Type of person as defined in enumeration.
                        Different types of person.
                TYPES_UNKNOWN if unknown type,
                TYPE NATURAL if natural person (Mr,Mrs,... no companies),
                TYPE_JUDICAL if judical person (all types of companies).
                        </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="TYPE_UNKNOWN">
								<xs:annotation>
									<xs:documentation>
                     unknown person's type.
                   </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="TYPE_NATURAL">
								<xs:annotation>
									<xs:documentation>
                      natural person
                   </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="TYPE_JUDICAL">
								<xs:annotation>
									<xs:documentation>
                     judical person
                  </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="COM:Marketing" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Marketing. Only have this for the lead passeneger</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
     address definition
    -->
	<xs:element name="Add">
		<xs:annotation>
			<xs:documentation>complete address</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Name" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Optional name of the address. Can be the name of the building or company.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Street" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Street name without house number</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="HouseNo" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>House number</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Co" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>C/o field content</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ZipCode" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>ZIP code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="City" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>City name</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Region" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>@ComRes internal region name</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CountryISOCode" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>country code defined by ISO-3166.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="POBox" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>PO box of person</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="POBoxZipCode" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>PO box zip code</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="POBoxCity" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>PO box city</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
     communication definition
    -->
	<xs:element name="Comm">
		<xs:annotation>
			<xs:documentation>Communication - Communication information for one person</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CommType">
					<xs:annotation>
						<xs:documentation>Different types of contact numbers.
                TYPES_UNKNOWN if unknown type,
                TYPE FAX fax number,
                TYPE_PHONE phone number,
                TYPE_MOBILE mobile phone number,
                TYPE_PAGER pager number.
                </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="TYPE_UNKNOWN">
								<xs:annotation>
									<xs:documentation>
                      communication type is unknown
                  </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="TYPE_FAX">
								<xs:annotation>
									<xs:documentation>
                      communication type is FAX
                  </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="TYPE_PHONE">
								<xs:annotation>
									<xs:documentation>
                      communication type is PHONE
                  </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="TYPE_MOBILE">
								<xs:annotation>
									<xs:documentation>
                      communication type is MOBILE
                  </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="TYPE_PAGER">
								<xs:annotation>
									<xs:documentation>
                      communication type is PAGER
                  </xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="COM:Sphere">
					<xs:annotation>
						<xs:documentation>describing whether it's a private or public/business information</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CountryCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The country code of this phone number, e.g. "49" or "0049" </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9]{2,}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AreaCode" type="xs:string">
					<xs:annotation>
						<xs:documentation>The area code of this phone number.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Num" type="xs:string">
					<xs:annotation>
						<xs:documentation>Number - The number of this phone number.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
     sphere definition
    -->
	<xs:element name="Sphere">
		<xs:annotation>
			<xs:documentation>Different types of spheres like private or business.
        SPHERE_UNKNOWN if unknown type,
        SPHERE_PRIVATE private contact number,
        SPHERE_BUSINESS business contact number
      </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="SPHERE_UNKNOWN">
					<xs:annotation>
						<xs:documentation>Sphere is UNKNOWN</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="SPHERE_PRIVATE">
					<xs:annotation>
						<xs:documentation>Sphere is PRIVATE</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="SPHERE_BUSINESS">
					<xs:annotation>
						<xs:documentation>Sphere is BUSINESS</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--
     email address definition
    -->
	<xs:element name="Email" type="COM:Email_Type"/>
	<xs:complexType name="Email_Type" abstract="false">
		<xs:sequence>
			<xs:element name="Address" type="xs:string">
				<xs:annotation>
					<xs:documentation>Definition of a mail address according to RFC 850 and RFC 1036</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Sphere">
				<xs:annotation>
					<xs:documentation>Sphere for this mail address</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--
      booking entries definition
    -->
	<xs:element name="Bkg_Ent">
		<xs:annotation>
			<xs:documentation>container with all accommodation offers, flight offers and correlation to the participants to build up package tour offers</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Ext_Header" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Accom" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of all accommodation offers</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Route_List" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of all flight-only offers</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Seat_Map" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Seat Maps related to the booking</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Package" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of all packagetour offers.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Roundtrip" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of all roundtrip offers.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<!--
                    to be removed, only needed for backwards compatibility to versions < 4.0.7
                -->
				<xs:element ref="COM:Car_Rental" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Item" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of all extra offers.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Flt_Extra_Cat_List" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Cruise" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Complex_Offer" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>List of all complex offers (acco-item-combination or complex roundtrip)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:RailJourney" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>List of all rail journeys</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Memo" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Memo information elements for the whole booking.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Prices" minOccurs="0">
					<xs:annotation>
						<xs:documentation>List of prices because of fees.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>ISO currency to be applied for the whole booking.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:MktCd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Market for the Booking</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Yield_Late_Sup" minOccurs="0"/>
				<xs:element ref="COM:Fast_Seller" minOccurs="0"/>
				<xs:element ref="COM:Acc_Prc_Zero_Fg" minOccurs="0"/>
				<xs:element ref="COM:Acc_Cost_Zero_Fg" minOccurs="0"/>
				<xs:element ref="COM:Atol_Prot_Tp" minOccurs="0"/>
				<xs:element ref="COM:Atol_Prot_By" minOccurs="0"/>
				<xs:element ref="COM:Atol_Prot_Issuer" minOccurs="0"/>
				<xs:element ref="COM:Summary_Prices" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Summary_Prices">
		<xs:annotation>
			<xs:documentation>Summary of prices grouped by type</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Summary_Price" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Summary of price grouped by type</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Summary_Price">
		<xs:annotation>
			<xs:documentation>Summary of price grouped by type</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Prc_Tp_Cd"/>
				<xs:element ref="COM:Prc_Tp_Name"/>
				<xs:element name="Qty" type="xs:integer"/>
				<xs:element ref="COM:Prc"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Prc_Tp_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Price type code</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Prc_Tp_Name" type="xs:string">
		<xs:annotation>
			<xs:documentation>Price type name</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     history entry definition
    -->
	<xs:element name="His">
		<xs:annotation>
			<xs:documentation>History information about current booking</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Bkg_Dt_Tm" minOccurs="0">
					<xs:annotation>
						<xs:documentation>CreateDateTime - Date and time when booking was initially made</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Bkg_User" minOccurs="0">
					<xs:annotation>
						<xs:documentation>CreateUser - User that initially created the booking, see user_name attribute in client info element</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Bkg_Exp_No" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Expidient number - Expidient number that initially created the booking</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Bkg_Term_Code" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Create Terminal Id - Terminal Id, the user was logged in, when making the booking, see term_code attribute in client info element</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Bkg_Chan" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Booking frontend channel</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amd_Dt_Tm" minOccurs="0">
					<xs:annotation>
						<xs:documentation>ChangeDateTime - Last modification time</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amd_User" minOccurs="0">
					<xs:annotation>
						<xs:documentation>ChangeUser - Last modifying user, see user_name attribute in client info element</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Amd_Term_Code" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Change Terminal Id - Terminal Id, the user was logged in, when making the latest change, see term_code attribute in client info element</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amd_Chan" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Channel through which an amendment request was received</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Cnx_Dt_Tm" minOccurs="0">
					<xs:annotation>
						<xs:documentation>CancelDateTime - Cancellation time</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Cnx_User" minOccurs="0">
					<xs:annotation>
						<xs:documentation>CancelUser - Cancellation user name, see user_name attribute in client info element</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Cnx_Term_Code" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Cancel Terminal Id - Terminal Id, the user was logged in, when canceling the booking, see term_code attribute in client info element</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Cnx_Chan" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Cancellation frontend channel</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
   create def
   -->
	<xs:element name="Bkg_Dt_Tm" type="xs:dateTime">
		<xs:annotation>
			<xs:documentation>CreateDateTime - Date and time of the creation of the booking.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     create user
    -->
	<xs:element name="Bkg_User" type="xs:string">
		<xs:annotation>
			<xs:documentation>CreateUser - User of the creation of the booking.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     change date
    -->
	<xs:element name="Amd_Dt_Tm" type="xs:dateTime">
		<xs:annotation>
			<xs:documentation>ChangeDateTime - Date and time of the last change of the booking.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     change user
    -->
	<xs:element name="Amd_User" type="xs:string">
		<xs:annotation>
			<xs:documentation>ChangeUser - User of the last change of the booking.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     cancel date
    -->
	<xs:element name="Cnx_Dt_Tm" type="xs:dateTime">
		<xs:annotation>
			<xs:documentation>CancelDateTime - Date of the last cancel of the booking.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     cancel user
    -->
	<xs:element name="Cnx_User" type="xs:string">
		<xs:annotation>
			<xs:documentation>Cancel user - User of the last cancel of the booking.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
     booking number
    -->
	<xs:element name="BkgNum">
		<xs:annotation>
			<xs:documentation>booking number</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:BkgId" minOccurs="0"/>
				<xs:element name="CurrentVersion" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Current version from the datahub</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Spnr_Cd" minOccurs="0"/>
				<xs:element name="BookingDate" minOccurs="0">
					<xs:annotation>
						<xs:documentation>If supplied this date is used instead of todays date to calculate prices and check inventory</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9]{4}-[0-1][0-9]-[0-3][0-9]"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="COM:AtcomresBkgVersion" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Current version from @comRes</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
     customer details
    -->
	<xs:element name="CusDet">
		<xs:annotation>
			<xs:documentation>CustomerDetails:container for the customer detail informations to avoid redundant information in the request/response when same customerId is used for customer and payer</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CusId" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Customer id from KUBA for mandator T and MUSY</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SysId" type="xs:string" default="MUSY" minOccurs="0">
					<xs:annotation>
						<xs:documentation>System id as used to store the customer in KUBA. Will be MUSY for Musyk and IRIS for B2C brands.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MandatorId" type="xs:string" default="T" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Mandator id as used to store the customer in KUBA. Will be "T" normally for Musyk as well as for B2C brands.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Person">
					<xs:annotation>
						<xs:documentation>Information about the person</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="New_Cus" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>new Customer.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
      bookable period definition
    -->
	<xs:element name="Bkg_Per">
		<xs:annotation>
			<xs:documentation>BookablePeriod - Defines a period in which bookings for the assigned element are
       potentially possible, ignoring which dates are actually available</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:St_Dt">
					<xs:annotation>
						<xs:documentation>Start date - Start date of the period</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:End_Dt">
					<xs:annotation>
						<xs:documentation>End date of the period</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:StartOutDays">
					<xs:annotation>
						<xs:documentation>Start out date definition</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      start out days definition
    -->
	<xs:element name="StartOutDays">
		<xs:annotation>
			<xs:documentation>Weekdays on which a reservation is possible, defined in a matrix line</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Weekdays"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      source data definition
    -->
	<xs:element name="SrcData">
		<xs:annotation>
			<xs:documentation>Defines the source of an offer in case of external inventories</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:System">
					<xs:annotation>
						<xs:documentation>
                 Inventory system from which information was received or from which an element is provided.
             </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:KeyValuePair" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Single key value pair describing data to be transferred for this
                             offer as hidden information always. Each KeyValuePair has at least one
                     key and one value.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      System definition
    -->
	<xs:element name="Sub_System" type="xs:string">
		<xs:annotation>
			<xs:documentation>Sub system used to book teh service</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="System">
		<xs:annotation>
			<xs:documentation>
             Definition of a system which is involved in the communication between @ComRes and VRP (or another client system).
         </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<!--
      Allotments
    -->
	<xs:element name="Alts">
		<xs:annotation>
			<xs:documentation>Allotments - List of allotments for different types of elements (hotel rooms, flights,...)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Route_List" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>List of routes to be addressed by allotments</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element ref="COM:Accom">
						<xs:annotation>
							<xs:documentation>List of accommodations/rooms</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Roundtrip"/>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      route search pattern
    -->
	<xs:element name="Route_Search_Ptn">
		<xs:annotation>
			<xs:documentation>Route search pattern - Element for route searches and results from outbound departure to inbound arrival airport for requested start and end date</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:St_Dt">
					<xs:annotation>
						<xs:documentation>Start date - Start date of the requested routes.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:End_Dt">
					<xs:annotation>
						<xs:documentation>End date of the requested routes.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Out_Dep_Air_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Outbound departure aiport 3LC - IATA specific 3 letter code for the outbound departure airport of the requested routes.
          City as well as station codes are not acceptable in this field.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[A-Z]{3}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="In_Arr_Air_Cd" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Inbound Arrival Airport 3LC - IATA specific 3 letter code for the inbound arrival airport of the requested routes.
          City as well as station codes are not acceptable in this field.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[A-Z]{3}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Dest_Air_Cd" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>destination airport 3 LC - IATA specific 3 letter code for the destination airport of the requested routes.
          City as well as station codes are not acceptable in this field.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[A-Z]{3}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="StsReq" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Seats required. Number of seats required for this flight. Since the result must only contain
        those flight combinations (route) which offer a matching availability. Can be skipped for the response.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      board base definition
  -->
	<xs:element name="BB_Name" type="xs:string">
		<xs:annotation>
			<xs:documentation>Board Basis Name</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="BB_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Board base code - @ComRes board base code.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="St_Dt_Plus_Days" type="xs:integer">
		<xs:annotation>
			<xs:documentation>start date plus days</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="St_Dt_Minus_Days" type="xs:integer">
		<xs:annotation>
			<xs:documentation>start date minus days</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Stay_Plus_Days" type="xs:integer">
		<xs:annotation>
			<xs:documentation>stay plus days</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Stay_Minus_Days" type="xs:integer">
		<xs:annotation>
			<xs:documentation>stay minus days</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      star_rating definition
  -->
	<xs:element name="Star_Rating" type="xs:string">
		<xs:annotation>
			<xs:documentation>defines the search attribute for the star rating element</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      number of adults
    -->
	<xs:element name="No_Adt" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Number of adults</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      number of children
    -->
	<xs:element name="No_Chd" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Number of children</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      number of infants
    -->
	<xs:element name="No_Inf" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Number of infants</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      total price definition
  -->
	<xs:element name="Tot_Prc" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>total price</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      number of adult prices
    -->
	<xs:element name="No_Adt_Prc" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Number of adult prices</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      number of child prices
    -->
	<xs:element name="No_Chd_Prc" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Number of child prices</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      number of free children
    -->
	<xs:element name="No_Free_Chd" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Number of free children</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      number of infant prices
    -->
	<xs:element name="No_Inf_Prc" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Number of infant prices</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
        definition for the price type
  -->
	<xs:complexType name="Prc_Type">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="Pax_Index" use="optional">
					<xs:annotation>
						<xs:documentation>Specify the participant.Index may not greater then 99.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[0-9]{1,2}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:attribute>
				<xs:attribute name="CurISO" type="xs:string" use="optional" default="EUR">
					<xs:annotation>
						<xs:documentation>currency code for current price. If missing, EUR is assumed.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Cd">
					<xs:annotation>
						<xs:documentation>Price code, for example RCP or FCP1</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Cd_O">
					<xs:annotation>
						<xs:documentation>Price code, for the outbound flight</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Cd_I">
					<xs:annotation>
						<xs:documentation>Price code, for the inbound flight</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Exc_Rate">
					<xs:annotation>
						<xs:documentation>Excahnge Rate</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:element name="Adt_Prc_Ex" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>price for nan adult excluding Yield supplement and Tactical discounts</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Adt_Prc" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>Price for adults</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Chd_Prc_Ex" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>price for children excluding Yield Supplement and tactical discounts</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Chd_Prc" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>Price for children</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Free_Chd_Prc" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>Price for children</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Inf_Prc_Ex">
		<xs:annotation>
			<xs:documentation>price for Infants excluding Yield Supplement and tactical discounts</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Inf_Prc" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>Price for infants</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!-- code share code -->
	<xs:element name="Cd_Shr_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>OperatingCarrierCode/Code Share Code - 2 or 3LC IATA code for the operating airline, if distinct to MainCarrierAirline</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!-- sub service pax allocation -->
	<xs:element name="SubServPaxs">
		<xs:annotation>
			<xs:documentation>Defines which participants are allocated to a sub service (a room here)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:SubServPax" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>List of all related pax indices.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      sub service pax definition -->
	<xs:element name="SubServPax">
		<xs:annotation>
			<xs:documentation>defines the relationship between a pax and his services.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Pax_Id">
					<xs:annotation>
						<xs:documentation>Specify the related pax element</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ext_Ref_Id" minOccurs="0"/>
				<xs:element ref="COM:Pax_Tp" minOccurs="0">
					<xs:annotation>
						<xs:documentation>passenger type like ADULT or CHILD</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Bag_Alloc" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>baggage allowance for this passenger</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Pax_Srv_Prc_Ex" type="COM:Prc_Type" minOccurs="0">
					<xs:annotation>
						<xs:documentation>passenger service price excluding fees</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amendment_Guarantee" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Flag to indicate if the pax has an amendment guaranee insurance.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Rate_Sell_Cur" minOccurs="0"/>
				<xs:element name="Flight_Tax_Rate" type="COM:Prc_Type" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Flight tax per pax</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--
      pax identification
      -->
	<xs:element name="Pax_Id" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Index to specify the related pax element</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      memo information element definition
    -->
	<xs:element name="Memo">
		<xs:annotation>
			<xs:documentation>Defines an information. What kind of information it is depends on where it is used and which codes are used inside the memo element.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Memo_Dt" type="xs:dateTime" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Date this memo was created/modified.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Memo_Cd">
					<xs:annotation>
						<xs:documentation>Internal code of the memo. The meaning depends on the customer's system setup.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Memo_Name" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>name of memo element</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Memo_Des" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>description of memo</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Memo_User_Name" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>name of the user which created the memo; not updated when another user modifies the memo</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Memo_Key" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>unique row_id to identify a memo.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Memo_Rights" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>indicates whether the memo is read only or user (from client info) is allowed to modify or cancel this memo.
                  If no 'Memo_Right' tag available, "READ" is default</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="READ"/>
							<xs:enumeration value="WRITE">
								<xs:annotation>
									<xs:documentation>user can modify or delete this memo</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="DELETE">
								<xs:annotation>
									<xs:documentation>user can modify or delete this memo</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Question_Cd" type="xs:string" minOccurs="0"/>
				<xs:element name="Answer_Cd" type="xs:string" minOccurs="0"/>
				<xs:element ref="COM:Status" minOccurs="0"/>
				<xs:element name="Memo_Seq" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Memo Sequence number</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Ser_Id" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Service ID if memo belongs to a Service rather than Booking level</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Pax_Id" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Passengers assigned to the memo. Only used for Service Memos</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Deleted" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>True, if the </xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--  memo code definition
   -->
	<xs:element name="Memo_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Internal code of the memo. The meaning depends on the customer's system setup.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
      prices definition
    -->
	<xs:element name="Prices">
		<xs:annotation>
			<xs:documentation>Container for multiple collected price information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Price" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Containter for multiple price elements related to the service or to participants allocated to the service</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- price definition -->
	<xs:element name="Price">
		<xs:annotation>
			<xs:documentation>Abstract definition of a price related to a participant and/or service.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Ser_Id" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The Value of Ser_Seq of the @comres Service</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Prc_Cd" type="xs:string">
					<xs:annotation>
						<xs:documentation>Code of this price.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Prc_Cd_Name" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
                Internal description of meaning of price code
             </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Prc_Cd_Tp" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
                Reference of price code (where it belongs to).
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ApplyType" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Used for Applying manual prices Percentage or Amount."</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Qty" type="xs:integer">
					<xs:annotation>
						<xs:documentation>
               Number of times the price information must be applied to get the total price.
             The price per passenger is (  Qty * Prc.Amt / PricePaxs.size ).
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Commission" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Used for Applying manual prices</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Prc" minOccurs="0"/>
				<xs:element ref="COM:Rate" minOccurs="0"/>
				<xs:element name="Prc_Dt" type="xs:dateTime" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
               Date when the price was applied.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:PricePaxs">
					<xs:annotation>
						<xs:documentation>
                 Passengers to which the price is to be applied.
             </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:PriceDetail" minOccurs="0">
					<xs:annotation>
						<xs:documentation/>
					</xs:annotation>
				</xs:element>
				<xs:element name="Visible" type="xs:boolean" minOccurs="0"/>
				<xs:element name="Prc_Sts" minOccurs="0"/>
				<xs:element ref="COM:Pending" minOccurs="0"/>
				<xs:element ref="COM:Rate_Sell_Cur" minOccurs="0"/>
				<xs:element ref="COM:Contract" minOccurs="0"/>
				<xs:element ref="COM:Rate_Full_Fare_Pay_Pax_Qty" minOccurs="0"/>
				<xs:element ref="COM:Rate_Full_Fare_Pay_Pax_Fg" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- price paxs definition -->
	<xs:element name="PricePaxs">
		<xs:annotation>
			<xs:documentation>Price paxs allocation</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Pax_Id" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>
               Id of passenger to which the price is to be applied.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- external reference id definition -->
	<xs:element name="Ext_Ref_Id">
		<xs:annotation>
			<xs:documentation>Describes a reference id of an external system which was connected to @ComRes.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Code" type="xs:string">
					<xs:annotation>
						<xs:documentation>External system booking code like '12345678' or 'X5TTS3'</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:System" minOccurs="0">
					<xs:annotation>
						<xs:documentation>optional information about the system, in which the booking was created</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Alt_Sup_Ref" minOccurs="0"/>
				<xs:element ref="COM:Sub_System" minOccurs="0"/>
				<xs:element ref="COM:Alt_Ref" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- external inventory id definition -->
	<xs:element name="Ext_Inv_Id">
		<xs:annotation>
			<xs:documentation>Describes the external inventory id of this product.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Value" type="xs:string">
					<xs:annotation>
						<xs:documentation>External inventory id.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--Brochure definition-->
	<xs:element name="Catalog">
		<xs:annotation>
			<xs:documentation>Describes a catalog</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Code" type="xs:string" use="required">
				<xs:annotation>
					<xs:documentation>the catalog code</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Name" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<!-- catalog page definition-->
	<xs:element name="Cat_Page">
		<xs:annotation>
			<xs:documentation>Describes a catalog page</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Catalog">
					<xs:annotation>
						<xs:documentation>the catalog where this page is found</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Cat_Page_No">
					<xs:annotation>
						<xs:documentation>Page number in the main catalog.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:integer">
							<xs:minInclusive value="0"/>
							<xs:maxInclusive value="999"/>
							<xs:fractionDigits value="0"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Prc_Cat_Page_No" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Page number in the price catalog.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--round trip product definition-->
	<xs:element name="RT_Prd">
		<xs:annotation>
			<xs:documentation>describes a roundtrip product</xs:documentation>
		</xs:annotation>
		<xs:complexType mixed="false">
			<xs:complexContent>
				<xs:extension base="COM:Prd">
					<xs:sequence>
						<xs:element ref="COM:Loc" minOccurs="0">
							<xs:annotation>
								<xs:documentation>location of this roundtrip product</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Desc" type="xs:string" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Short description of this roundtrip product. Most probably from an attribute in @comRes (which one?)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Stock_Type" minOccurs="0"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<!--product code definition-->
	<xs:element name="Prd_Cd">
		<xs:annotation>
			<xs:documentation>describes a product code</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--base search response-->
	<xs:complexType name="AtcomresBaseOfferSearchResponse" abstract="true" mixed="false">
		<xs:annotation>
			<xs:documentation>describes common search response elements</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="COM:AtcomresBaseResponse">
				<xs:sequence>
					<xs:element ref="COM:Offers" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>list of offers</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<!--
      roundtrip definition
    -->
	<xs:element name="Roundtrip">
		<xs:annotation>
			<xs:documentation>describes roundtrip offers</xs:documentation>
		</xs:annotation>
		<xs:complexType mixed="false">
			<xs:complexContent>
				<xs:extension base="COM:Offer">
					<xs:sequence>
						<xs:element ref="COM:RT_Prd">
							<xs:annotation>
								<xs:documentation>the product of this offer</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Rm_Cd" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>list of room codes contained in this offer</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Routing_Id" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>
                        Specifies the routing related to this roundtrip to define one package.
                    The passenger types from this roundtrip define the passenger types (and their prices) to be applied in
                    context of routes.
                                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Tot_Pck_Prc" type="xs:string" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                         Total package price. Reserved element for @ComRes only. Not for VRP purposes!
                                </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<!--offer type definition-->
	<xs:complexType name="Offer">
		<xs:annotation>
			<xs:documentation>common elements for all kinds of offers</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Id" type="xs:integer" minOccurs="0">
				<xs:annotation>
					<xs:documentation>the id of this service within the booking.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:St_Dt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>start date - start date of offer. Is optional for allotment searches and
for insurance items (because @comRes calculates it while booking)!</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:End_Dt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>end date of the accommodation stay. Is optional for allotment searches and
for insurance items (because @comRes calculates it while booking)!</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Memo" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
            Potential memos (remarks, comments) bound to the roundtrip. In this case erratas are expected to show up here.
            Which kind of memos exist and what are their meanings depends on the customer's configuration of the @ComRes system
            instance.
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Forced_To_Top" type="xs:boolean" default="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>true, if the offer was forced to the top of the list ignoring the sort criteria.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Transfer_Info" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Information about the kind of transfer that is included.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Loc" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>the resort of the item, only used for adhoc items</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Dpt" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="Is_Adhoc" type="xs:boolean" default="false">
			<xs:annotation>
				<xs:documentation>if true, indicates that the Accom is an Adhoc accom. If just the room is an adhoc room, the Accom is not an Adhoc accom (Is_Adhoc=false)</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Error" type="xs:boolean" default="false">
			<xs:annotation>
				<xs:documentation>Set to true if service has an error and can not be booked</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<!--
      complex offer definition
    -->
	<xs:element name="Complex_Offer">
		<xs:annotation>
			<xs:documentation>describes complex offers (offers consisting of multiple service choices)</xs:documentation>
		</xs:annotation>
		<xs:complexType mixed="false">
			<xs:complexContent>
				<xs:extension base="COM:Offer">
					<xs:sequence>
						<xs:element name="Desc" type="xs:string" minOccurs="0">
							<xs:annotation>
								<xs:documentation>further description of the complex offer, for example "Miniaturwunderland"</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:choice>
							<xs:annotation>
								<xs:documentation>Information about the acco-item combination (at least product code) or complex roundtrip.</xs:documentation>
							</xs:annotation>
							<xs:element ref="COM:RT_Prd">
								<xs:annotation>
									<xs:documentation>complex offer for a roundtrip product</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element ref="COM:HtlPrd">
								<xs:annotation>
									<xs:documentation>complex offer for an accom product</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
						<xs:element ref="COM:Rm_Cd" minOccurs="0">
							<xs:annotation>
								<xs:documentation>room code of the complex offer. Needed for the occupancy of the offer. For acco-item combinations, no Rm_Cd is needed, it's identical to the Rm_Cd in the first offer choice (an Accom).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Offer_Choice" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>contains the service options of the complex offer</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<!-- describes a choice of different offers. An OfferChoice contains a list of offers, of which one must be selected for booking a complex offer -->
	<xs:element name="Offer_Choice">
		<xs:annotation>
			<xs:documentation>describes a choice of different offers. An OfferChoice contains a list of offers, of which one must be
selected for booking a complex offer</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:element ref="COM:Accom" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>accomodation offers</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Item" maxOccurs="unbounded"/>
				<xs:element ref="COM:Route" maxOccurs="unbounded"/>
			</xs:choice>
			<xs:attribute name="selectedOffer" type="xs:integer">
				<xs:annotation>
					<xs:documentation>the number of the selected offer in this choice. First element has number 1, -1 indicates no selection</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="isSelectionMandatory" type="xs:boolean" default="true">
				<xs:annotation>
					<xs:documentation>indicates if a selection is mandatory in this choice.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--product definition-->
	<xs:complexType name="Prd">
		<xs:annotation>
			<xs:documentation>product definition</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Name" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The name of this product</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Prom">
				<xs:annotation>
					<xs:documentation>the promotion of this product</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Prd_Cd" minOccurs="0">
				<xs:annotation>
					<xs:documentation>the product code, optional for adhoc items</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Cat_Page" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>list of catalog pages where this product is described</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Promo_Cd" minOccurs="0">
				<xs:annotation>
					<xs:documentation>List of product flags, for example Topseller</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="COM:Sort_Prio" minOccurs="0"/>
			<xs:element ref="COM:Sort_No" minOccurs="0"/>
			<xs:element ref="COM:Restr" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>list of product restrictions</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--describes a package tour product, container for the booked services-->
	<xs:element name="Package">
		<xs:annotation>
			<xs:documentation>describes a package tour product, container for the booked services</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:choice maxOccurs="unbounded">
					<xs:element ref="COM:Accom" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>the accomodation in a package</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:MultiCentre" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Multi Centre in a package</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element ref="COM:Roundtrip" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>the roundtrip in a package</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
				<xs:element ref="COM:Route_List" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the flights in a package</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:PackageNo" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--definition of an agency notice-->
	<xs:element name="Agt_Notice">
		<xs:annotation>
			<xs:documentation>describes an agency notice</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Seq_Number" type="xs:integer" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the sequence number of this notice in the list of notices of a booking.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:BkgNum">
					<xs:annotation>
						<xs:documentation>the sequence number of this notice in the list of notices of a booking.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:BkgSts" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Booking status of the associated booking. Not required for modify requests.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:BkgSts_2" minOccurs="0">
					<xs:annotation>
						<xs:documentation>booking status 2, usually indicates on FIXED/ONREQUEST booking</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:ResSts" minOccurs="0">
					<xs:annotation>
						<xs:documentation>indicates the reservation status of the booking</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Is_Prebooking" minOccurs="0">
					<xs:annotation>
						<xs:documentation>indicates if this is a prebooking. If missing, assume false.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Exp_No" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number of the expedient who has created the notice. Not required for modify requests.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Creator">
					<xs:annotation>
						<xs:documentation>the creator of the notice.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="AGENCY">
								<xs:annotation>
									<xs:documentation>If created by the agency.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="ORGANIZER">
								<xs:annotation>
									<xs:documentation>If created by the organizer.</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Msg_Code" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Code classification for the agency not ices, for example XY</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Msg_Desc" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Description for the character codee, for example KX Maske ausfüllen</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Text" type="xs:string">
					<xs:annotation>
						<xs:documentation>The notice text, may contain  line separator characters. CDATA-encoded</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Lst_Name_First_Trvlr" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Lastname of the first active traveler. Not required for modify requests.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Date" type="xs:dateTime">
					<xs:annotation>
						<xs:documentation>the creation date and time of this notice.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Prt_On_Conf" type="xs:boolean" default="false">
					<xs:annotation>
						<xs:documentation>Flag to indicate weather the notice shall be printed on the travel confirmation</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Prt_On_Trvl_Doc" type="xs:boolean" default="false">
					<xs:annotation>
						<xs:documentation>Flag to indicate weather the notice shall be printed on the travel documents</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:St_Dt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Earliest Startdate of a acco/roundtrip/package service in the booking. Not required for modify requests.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Is_Closed" type="xs:boolean">
					<xs:annotation>
						<xs:documentation>Flag to indicate that this notice is closed by the agent.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--defines one payment item-->
	<xs:element name="Payment">
		<xs:annotation>
			<xs:documentation>defines one payment</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Pay_Type" type="xs:string">
					<xs:annotation>
						<xs:documentation>type of this payment, e.g DEPOSIT, VOUCHER, BALANCE</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Due_Dt">
					<xs:annotation>
						<xs:documentation>due date of the payment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amt">
					<xs:annotation>
						<xs:documentation>the amout of the payment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:CurISO">
					<xs:annotation>
						<xs:documentation>currency of the payment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Pay" minOccurs="0">
					<xs:annotation>
						<xs:documentation>kind of payment that was used for this payment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Pay_Seq" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Sequence</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--date range definition-->
	<xs:element name="Date_Range">
		<xs:annotation>
			<xs:documentation>defines a date range as days before/after together with a date</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="days" type="xs:integer" use="required">
				<xs:annotation>
					<xs:documentation>days before (smaller than 0) or after (bigger than 0) the associated date</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--defines booking restrictions-->
	<xs:element name="Restr">
		<xs:annotation>
			<xs:documentation>defines booking restrictions</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Included" type="xs:boolean" use="required">
				<xs:annotation>
					<xs:documentation>specifies if the restriction includes or excludes what's specified with level and code.
For example included=false and ACCOM=PMI12345 excludes PMI12345 from the element to which the restriction applies.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Level" use="required">
				<xs:annotation>
					<xs:documentation>the level on which the restriction is defined</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="AIRPORT"/>
						<xs:enumeration value="COUNTRY"/>
						<xs:enumeration value="REGION"/>
						<xs:enumeration value="RESORT"/>
						<xs:enumeration value="ACCOM"/>
						<xs:enumeration value="CARRIER"/>
						<xs:enumeration value="PROM"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Code" type="xs:string" use="required">
				<xs:annotation>
					<xs:documentation>code of the data item</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--definition of a seat in an aircraft-->
	<xs:element name="Seat">
		<xs:annotation>
			<xs:documentation>definition of one seat in an aircraft</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SeatAttr" type="COM:SeatAttribute" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Seat attributes, e.g. Aisle</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="StPrc" type="COM:Prc" minOccurs="0">
					<xs:annotation>
						<xs:documentation>seat price</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Pax" minOccurs="0">
					<xs:annotation>
						<xs:documentation>passenger having booked this seat</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Row" type="xs:integer" use="optional">
				<xs:annotation>
					<xs:documentation>Row where the seat is.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Col" use="required">
				<xs:annotation>
					<xs:documentation>Column, where the seat is, e.g. A</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Sts" use="optional">
				<xs:annotation>
					<xs:documentation>Seat status - available, occupied or reserved by a pax on the booking</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="AVAILABLE"/>
						<xs:enumeration value="OCCUPIED"/>
						<xs:enumeration value="RESERVED"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="PrcCat" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>The @comRes price category determines selling price</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--definition of a seatmap-->
	<xs:element name="Seat_Map">
		<xs:annotation>
			<xs:documentation>definition of a seatmap</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Col" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Decribes attributes that are common to a column.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ColAttr" type="COM:SeatAttribute" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
						<xs:attribute name="Id" use="required">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:pattern value="[A-Z]"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
				<xs:element name="Row" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Decribes one row in an aircraft. There are multiple seats in each row.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="RowAttr" type="COM:SeatAttribute" minOccurs="0" maxOccurs="unbounded"/>
							<xs:element ref="COM:Seat" maxOccurs="unbounded"/>
						</xs:sequence>
						<xs:attribute name="No" type="xs:integer" use="required"/>
					</xs:complexType>
				</xs:element>
				<xs:element ref="COM:Seat" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:SeatMapSec"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--definition of the seat reservation for one person-->
	<xs:element name="Seat_Res_Entry">
		<xs:annotation>
			<xs:documentation>seat reservation for one person</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Pax">
					<xs:annotation>
						<xs:documentation>the passenger, for which a reservation shall be made.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Seat" minOccurs="0">
					<xs:annotation>
						<xs:documentation>the seat for which a reservation shall be made. If this
                            element is missing, the current seat reservation for this pax shall be
                            canceled. If the pax already has a seat reservation, this reservation is
                            rebooked.
                        </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--price of the seat reservation-->
	<xs:element name="Seat_Res_Prc" type="COM:Prc">
		<xs:annotation>
			<xs:documentation>price of the seat reservation</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--search category definition-->
	<xs:element name="Search_Category">
		<xs:annotation>
			<xs:documentation>search category definition. If multiple attributes are defined within
one Search_Category element, the attributes shall have an and-relationship.
For example category="CATALOG" Class="SPA" shall only match offers having the category CATALOG AND the class SPA.
If more than one category, class or child_price is specified, the shall have an or-relationship. For example
category="CATALOG" and category="YIELD" means to search for offers with category CATALOG or offers with category YIELD.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Category" use="optional">
				<xs:annotation>
					<xs:documentation>category (attribute on a promotion) in @comRes</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Class" use="optional">
				<xs:annotation>
					<xs:documentation>class (attribute of the static accomodation) in @comRes.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Exclude"/>
		</xs:complexType>
	</xs:element>
	<!-- child price -->
	<xs:element name="Child_Price_Reduction">
		<xs:annotation>
			<xs:documentation>child price reducations for which the search shall be performed.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Cd" use="required">
						<xs:simpleType>
							<xs:restriction base="xs:string"/>
						</xs:simpleType>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Srch_Attr_Cd">
		<xs:annotation>
			<xs:documentation>
        Accomodation Search Attribute
        e.g. Family hotel
        Centrally located
        Near Beach
        Swimming Pool
      </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="8"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!--definition of a promotion group-->
	<xs:element name="Prom_Grp">
		<xs:annotation>
			<xs:documentation>definition of a promotion group</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Code" type="xs:string" use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<!--definition of the product flags-->
	<xs:element name="Promo_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>List of product flags, for example TOP, SPE, AKT, EXK</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Seat_Res_Route">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Route"/>
				<xs:element ref="COM:Seat_Res_Entry" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="SeatAttribute">
		<xs:attribute name="Name" type="xs:string" use="required"/>
		<xs:attribute name="Desc" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:element name="SeatMapSec">
		<xs:annotation>
			<xs:documentation>Specifies, to which sectors of a route the seat map belongs</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SecId" type="xs:string" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="RouteCd" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<!--Definition for Items Sets-->
	<xs:simpleType name="Set_Type">
		<xs:annotation>
			<xs:documentation>The type of the item set.
The main functionality of an item set is determined by the Set Type

SET TYPE
Admin: Used to store amendment and cancellation fees etc.
Extra: Used for destination-related optional extras (e.g. excursions, theme park tickets etc).
Insurance: Used to handle insurance premiums.
Transfer: Used for one-way and round-trip transfers.
Transport: Used to handle compulsory transport fees such as taxes, fuel surcharges etc. These are displayed on the flight availability screens in the taxes field.
Car: This Sell Type is for future use.
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ADMIN"/>
			<xs:enumeration value="EXTRA"/>
			<xs:enumeration value="INSURANCE"/>
			<xs:enumeration value="TRANSFER"/>
			<xs:enumeration value="TRANSPORT"/>
			<xs:enumeration value="CAR"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Set_Type2">
		<xs:annotation>
			<xs:documentation>The type of the item set.
The main functionality of an item set is determined by the Set Type

SET TYPE
Admin: Used to store amendment and cancellation fees etc.
Extra: Used for destination-related optional extras (e.g. excursions, theme park tickets etc).
Insurance: Used to handle insurance premiums.
Transfer: Used for one-way and round-trip transfers.
Transport: Used to handle compulsory transport fees such as taxes, fuel surcharges etc. These are displayed on the flight availability screens in the taxes field.
Car: This Sell Type is for future use.
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ADMIN"/>
			<xs:enumeration value="EXTRA"/>
			<xs:enumeration value="INSURANCE"/>
			<xs:enumeration value="TRANSFER"/>
			<xs:enumeration value="TRANSPORT"/>
			<xs:enumeration value="CAR"/>
			<xs:enumeration value="ALL"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Item_Capture">
		<xs:annotation>
			<xs:documentation>Determines whether the date / time information must be specied when bookings items from this set
        Valid options are:
None: Select this if you do not need to capture any date/time information at time of booking.
Start Date: Select this if a date must be specified when booking Items from this Set (e.g. for excursions, to specify the date on which the excursion is required).
Start/End Dates: This selection is only available for Set Type ‘Insurance’ or ‘Extra’.  When booking, the user must select both the Start Date for the Item, and the number of days for which it is required.
Start Time: This selection is only available for Set Type ‘Transfer’, where it is the only availablechoice.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="Start_Date"/>
				<xs:enumeration value="Start_End_Date"/>
				<xs:enumeration value="Start_Time"/>
				<xs:enumeration value="None"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Item_Set">
		<xs:annotation>
			<xs:documentation>Groups a set of similar items of the same item set type in a promotion.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Item_Capture" minOccurs="0">
					<xs:annotation>
						<xs:documentation>specifies which dates are needed for booking</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Ser_Id" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Service ID from previous InfoBooking this Item set was found for</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Min" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Minimum number of items to be booked from the item set  </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Max" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Maximum number of items to be booked from this item set</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Item_Type" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The type of the item, e.g. SPOR (Sport) or AUSF (Ausflug/Excursion).
Required in the master data export.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Item" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>list of all extra offers</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Sell_Type" type="xs:string" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Sell_Type, for example Land for the item set type Transport</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Rate_Tp" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Code"/>
			<xs:attribute name="Name" type="xs:string" use="optional"/>
			<xs:attribute name="Set_Type" type="COM:Set_Type">
				<xs:annotation>
					<xs:documentation>This is the type of the Item_Set, for example EXTRA or TRANSFER</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--Definition of Items-->
	<xs:element name="Item_Setup">
		<xs:annotation>
			<xs:documentation>A single Item configuration data</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="COM:Prd">
					<xs:sequence>
						<xs:element ref="COM:StartOutDays" minOccurs="0">
							<xs:annotation>
								<xs:documentation>weekdays at which the item may start
            </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Min_Pax" type="xs:integer" minOccurs="0">
							<xs:annotation>
								<xs:documentation>min. number of pax</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Max_Pax" type="xs:integer" minOccurs="0">
							<xs:annotation>
								<xs:documentation>max. number of pax</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Min_Dur" type="xs:integer" minOccurs="0">
							<xs:annotation>
								<xs:documentation>min. duration</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Max_Dur" type="xs:integer" minOccurs="0">
							<xs:annotation>
								<xs:documentation>max. duration</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:DepartType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Used for transfers only, describes the departure (location, flight no, etc.)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:ArriveType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Used for transfers only, describes the arrival (location, flight no, etc.)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:JnyTyp" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Journey Type for transfers, oneway or return</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Loc_Mtd" minOccurs="0">
							<xs:annotation>
								<xs:documentation>locate method. Indicates where the item is offered.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Stay_Basis" minOccurs="0">
							<xs:annotation>
								<xs:documentation>indicates if the duration is fixed or prolongable</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Rate_Tp">
							<xs:annotation>
								<xs:documentation>Rate Type. Valid values are PP - Per Person and PI - Per Item</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Item_Search_Type" maxOccurs="unbounded"/>
						<xs:element name="From_Prc" type="COM:Prc" minOccurs="0">
							<xs:annotation>
								<xs:documentation>From price for this Item</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Display_Type"/>
						<xs:element name="Ranking" type="xs:integer">
							<xs:annotation>
								<xs:documentation>the ranking of this item. Used for sorting a list of items.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Bkg_Per" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Bookable period - Periods in which the item is potentially bookable. This element is optional only for backwards compatibility reasons. Once this feature is delivered, we always expect at least one booking period.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="Location_Type">
		<xs:annotation>
			<xs:documentation>Type to define item location</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIRPORT"/>
			<xs:enumeration value="ACCOM"/>
			<xs:enumeration value="RESORT"/>
			<xs:enumeration value="OTHER"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Item_Loc" type="xs:string">
		<xs:annotation>
			<xs:documentation>Item Location. Can be a list of accommodations, resorts,  airports or Other</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--definition of an extra item, e.g. transfer, golf course-->
	<xs:element name="Item">
		<xs:annotation>
			<xs:documentation>describes Item offers</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="COM:Offer">
					<xs:sequence>
						<xs:element name="Desc" type="xs:string" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Short description of the Item</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Set_Type" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The settype of the item_set, e.g. TRANSPORT or INSURANCE</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Item_Type" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The type of the item, e.g. SPOR (Sport) or AUSF (Ausflug/Excursion)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Insurance_Answers" minOccurs="0"/>
						<xs:element name="Start_Tm" type="xs:time" minOccurs="0">
							<xs:annotation>
								<xs:documentation>start time of the service.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:choice minOccurs="0">
							<xs:sequence minOccurs="0">
								<xs:element name="Route" minOccurs="0">
									<xs:annotation>
										<xs:documentation>Holds Transfer Sector Route information</xs:documentation>
									</xs:annotation>
									<xs:complexType>
										<xs:sequence>
											<xs:element ref="COM:St_Dt" minOccurs="0"/>
											<xs:element ref="COM:End_Dt"/>
											<xs:element ref="COM:DepartType"/>
											<xs:element name="Dep_End_Time" type="xs:time"/>
											<xs:element ref="COM:ArriveType"/>
											<xs:element name="Arr_St_Time" type="xs:time"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element ref="COM:JnyTyp" minOccurs="0"/>
							</xs:sequence>
							<xs:element ref="COM:CarPark" minOccurs="0"/>
						</xs:choice>
						<xs:element ref="COM:StartOutDays" minOccurs="0">
							<xs:annotation>
								<xs:documentation/>
							</xs:annotation>
						</xs:element>
						<xs:element name="Min_Pax" type="xs:integer" minOccurs="0"/>
						<xs:element name="Max_Pax" type="xs:integer" minOccurs="0"/>
						<xs:element name="Min_Dur" type="xs:integer" minOccurs="0"/>
						<xs:element name="Max_Dur" type="xs:integer" minOccurs="0"/>
						<xs:element name="Min_Adt_Age" type="xs:integer" minOccurs="0"/>
						<xs:element name="Max_Adt_Age" type="xs:integer" minOccurs="0"/>
						<xs:element name="Min_Chd_Age" type="xs:integer" minOccurs="0"/>
						<xs:element name="Max_Chd_Age" type="xs:integer" minOccurs="0"/>
						<xs:element name="Min_Adu" type="xs:integer" minOccurs="0"/>
						<xs:element name="Max_Adu" type="xs:integer" minOccurs="0"/>
						<xs:element name="Min_Chd" type="xs:integer" minOccurs="0"/>
						<xs:element name="Max_Chd" type="xs:integer" minOccurs="0"/>
						<xs:element ref="COM:Pax_Applic" minOccurs="0"/>
						<xs:choice minOccurs="0">
							<xs:element ref="COM:Prom"/>
							<xs:element ref="COM:Prom_Grp"/>
						</xs:choice>
						<xs:element name="Supplier" minOccurs="0">
							<xs:annotation>
								<xs:documentation>For insurances, this is the supplier of the insurance.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:attribute name="Name" type="xs:string" use="optional"/>
							</xs:complexType>
						</xs:element>
						<xs:element name="Bkg_Qty" type="xs:integer" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Quantity of Items booked</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Avl" minOccurs="0"/>
						<xs:element ref="COM:Ser_Sts" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="From_Prc" type="COM:Prc_Type" minOccurs="0">
							<xs:annotation>
								<xs:documentation>the cheapest possible adult price.
For details see http://bugzilla.tui.de/show_bug.cgi?id=182500#c15</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Adt_Prc" minOccurs="0"/>
						<xs:element ref="COM:Chd_Prc" minOccurs="0"/>
						<xs:element ref="COM:Inf_Prc" minOccurs="0"/>
						<xs:element ref="COM:Tot_Prc" minOccurs="0">
							<xs:annotation>
								<xs:documentation>total price for 1 Item</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:SubServPaxs" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Persons assigned to this Item</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Prices" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  Prices for the Item.
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Assign_Default_Insurance" type="xs:boolean" default="false" minOccurs="0">
							<xs:annotation>
								<xs:documentation>if set to true, @comRes shall identify and book the default insurance for this booking.
If missing, do NOT assign an insurance. In this case, Item code will be empty.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Ref_Prd_Id" type="xs:integer" minOccurs="0">
							<xs:annotation>
								<xs:documentation>if the item is associated with a specific product, for example because it was selected in the upselling process, this element contains the referenced product.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Annual_Insurance" minOccurs="0"/>
						<xs:element name="Rate_Rule" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Indicate the Rate rule for an item, e.g. Journey.</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="JOURNEY"/>
									<xs:enumeration value="DAY"/>
									<xs:enumeration value="PERIOD"/>
									<!--Which values are there?-->
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="Literal" minOccurs="0">
							<xs:annotation>
								<xs:documentation>value of the literal of an item in @comRes. May be an reference number or a seat number</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="Code" type="xs:string">
											<xs:annotation>
												<xs:documentation>Code of the literal, for example SEAT_NO</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="Name" type="xs:string">
											<xs:annotation>
												<xs:documentation>Name of the literal, for example Sitzplatznummer</xs:documentation>
											</xs:annotation>
										</xs:attribute>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element ref="COM:Policy" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Details prices for Insurance Policy. (An insurance item can contain multiple policies at different prices).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element ref="COM:Ext_Ref_Id" minOccurs="0"/>
						<xs:element ref="COM:Adhoc_Name_List" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element ref="COM:Adhoc_Ser" minOccurs="0"/>
						<xs:element ref="COM:Adhoc_Ser_Tp" minOccurs="0"/>
						<xs:element ref="COM:MC_Method" minOccurs="0"/>
						<xs:element ref="COM:Min_Qty" minOccurs="0"/>
						<xs:element ref="COM:Max_Qty" minOccurs="0"/>
						<xs:element name="Item_Method" minOccurs="0">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="PI"/>
									<xs:enumeration value="PP"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element ref="COM:Atol_Mth" minOccurs="0"/>
						<xs:element ref="COM:Corporate_Cd" minOccurs="0"/>
						<xs:element ref="COM:ByPass_Inv_Chk" minOccurs="0"/>
					</xs:sequence>
					<xs:attribute name="Code">
						<xs:annotation>
							<xs:documentation>code. Optional for adhoc items</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="xs:string"/>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="Name" type="xs:string"/>
					<xs:attribute name="Is_Default" type="xs:boolean" default="false">
						<xs:annotation>
							<xs:documentation>if true, the item is the default  item in this context. One example is searching an insurance item for another service. One of the returned insurance items is the default insurance defined for the service.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Auto_Inc" type="xs:boolean" default="false">
						<xs:annotation>
							<xs:documentation>Item is auto included. true false. If node missing assume false</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Short_Name" type="xs:string">
						<xs:annotation>
							<xs:documentation>Item's short name</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Corporate_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Corporate code. This is used to map to client's content system</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Rate_Tp">
		<xs:annotation>
			<xs:documentation>Rate Type. Valid values are PP - Per Person and PI - Per Item</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="PP"/>
				<xs:enumeration value="PI"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Loc_Mtd">
		<xs:annotation>
			<xs:documentation>Item Locate Method</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Item_Loc" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>locate method locations</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Loc" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>location information</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Loc_Type">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="AIRPORT"/>
						<xs:enumeration value="ACCOMMODATION"/>
						<xs:enumeration value="COUNTRY"/>
						<xs:enumeration value="REGION"/>
						<xs:enumeration value="RESORT"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Item_Search_Type">
		<xs:annotation>
			<xs:documentation>Item search type i.e. Items for Packages only, Accommodation only or all. Null node means all</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="INCLUSIVE">
					<xs:annotation>
						<xs:documentation>Only valid for an inclusive or Package booking</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="WITH_ACCOM">
					<xs:annotation>
						<xs:documentation>Valid for accommodation Only</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="COMPONENT_ONLY">
					<xs:annotation>
						<xs:documentation>Can only be sold on its own</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="INC_ROUNDTRIP">
					<xs:annotation>
						<xs:documentation>Same as INCLUSIVE but for ROUNDTRIP package</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="ACCOM_ROUNDTRIP">
					<xs:annotation>
						<xs:documentation>Valid for RoundTrip only</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="WITH_FLIGHT">
					<xs:annotation>
						<xs:documentation>Valid for Flight only</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DepartType">
		<xs:annotation>
			<xs:documentation>Used for transfers only, defines the departure.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Item_Loc" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Loc" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>location information</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Car_Cd" minOccurs="0"/>
				<xs:element ref="COM:Flt_No" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Loc_Type" type="COM:Location_Type"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ArriveType">
		<xs:annotation>
			<xs:documentation>Used for transfers only, defines the arrival.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Item_Loc" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Loc" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>location information</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Car_Cd" minOccurs="0"/>
				<xs:element ref="COM:Flt_No" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Loc_Type" type="COM:Location_Type"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="EqmtAvl">
		<xs:annotation>
			<xs:documentation>describes class-independent availability information for the plane</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Begin" use="optional">
				<xs:annotation>
					<xs:documentation>Start date of availability in format DDMM for day and month information</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-3][0-9][0-1][0-9]"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Num" type="xs:integer" use="optional">
				<xs:annotation>
					<xs:documentation>Number - Number of elements available</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Agg" type="xs:boolean" use="optional" default="false">
				<xs:annotation>
					<xs:documentation>Aggregated - Defines whether this is an aggregated result. This is the case where a number of different
              results are counted up. This is applicable for flight matrix only where a) more than one flight has the same
              route on the same day or b) the route consists out of more than one sector.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Avl">
		<xs:annotation>
			<xs:documentation>Start date of the availability. Days that are not bookable (because they are not
            allowed to be booked by the provider of the service) are left out inside the list of availabilities.
            Remark:
            The availability is describing the "real" state of the service in @ComRes. Presentation specific changes
            like displaying an availability of "25" as a "*" in IRIS.plus client for external users is the client
            responsibility. The view on the allotment data is an internal user view always.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Begin" use="optional">
				<xs:annotation>
					<xs:documentation>Start date of availability in format DDMM for day and month information</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-3][0-9][0-1][0-9]"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Num" type="xs:integer" use="optional">
				<xs:annotation>
					<xs:documentation>Number - Number of elements available</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Move_Rstn" use="optional">
				<xs:annotation>
					<xs:documentation>MoveRestriction - Describes if their is a restriction for this date, that only arriving or leaving the acco is valid.
              Default is both. This attribute is applicable for accommodation availabilities only.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="MOVE_IN_ONLY">
							<xs:annotation>
								<xs:documentation>Stays inside this accommodation can only start on this day.</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="MOVE_OUT_ONLY">
							<xs:annotation>
								<xs:documentation>Stays inside this accommodation can only end up on this day.
                   Not in use for release 1, will be a feature for release 2</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="MOVE_NOT_ALLOWED">
							<xs:annotation>
								<xs:documentation>Stays can not start or end on this day</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Agg" type="xs:boolean" use="optional" default="false">
				<xs:annotation>
					<xs:documentation>Aggregated - Defines whether this is an aggregated result. This is the case where a number of different
              results are counted up. This is applicable for flight matrix only where a) more than one flight has the same
              route on the same day or b) the route consists out of more than one sector.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="State" use="optional" default="AVAILABLE">
				<xs:annotation>
					<xs:documentation>Allotment type</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="UNAVAILABLE">
							<xs:annotation>
								<xs:documentation>
                     flight/room was canceled, has taken off or is in the past
                  </xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="AVAILABLE">
							<xs:annotation>
								<xs:documentation>
                     flight/room type is available for sale, count defines the number of seats/rooms
                  </xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="SOLD_OUT">
							<xs:annotation>
								<xs:documentation>
                     tour operator contingent is sold out
                  </xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="BOOKING_STOP">
							<xs:annotation>
								<xs:documentation>
                     tour operator contingent is sold out
                  </xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="EXPIRED">
							<xs:annotation>
								<xs:documentation>
                     tour operator contingent is expired
                  </xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="OVERBOOKED">
							<xs:annotation>
								<xs:documentation>
                     tour operator contingent is overbooked (number is the number of overbooked seats/rooms?)
                  </xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="REQUEST_STOP">
							<xs:annotation>
								<xs:documentation>The service may not be requested.</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="REQUEST">
							<xs:annotation>
								<xs:documentation>The service may be requested.</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Has_Scheduled_Flight" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>true, if this availability includes at least one scheduled flight.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Arr_Cd">
		<xs:annotation>
			<xs:documentation>Arrangement code. This is made up of the Accommodation code and a unique code</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="10"/>
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Inc_Arr" default="NO_ARR">
		<xs:annotation>
			<xs:documentation>Defines the handling of arrangements in searches.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="NO_ARR">
					<xs:annotation>
						<xs:documentation>do not return arrangements in the search response</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="INCL_ARR">
					<xs:annotation>
						<xs:documentation>return arrangements as well as normal offers in the search response</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="ONLY_ARR">
					<xs:annotation>
						<xs:documentation>return ONLY arrangements in the search response</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="false">
					<xs:annotation>
						<xs:documentation>for backwards compatibility only! same as NO_ARR</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="true">
					<xs:annotation>
						<xs:documentation>for backwards compatibility only! same as INCL_ARR</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Inc_Complex_Offers" default="NO_COMPLEX_OFFERS">
		<xs:annotation>
			<xs:documentation>Include complex offers (complex roundtrips or acco-extra-combinations).</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="NO_COMPLEX_OFFERS">
					<xs:annotation>
						<xs:documentation>Do not include complex offers in response.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="INC_SELECTED_OFFER_CHOICES">
					<xs:annotation>
						<xs:documentation>Include complex offers with the offer choices and the selected choice option in response.
For example, in an Accom offer choice with two Accoms, only return the selected Accom.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="INC_ALL_OFFER_CHOICES">
					<xs:annotation>
						<xs:documentation>Include complex offers with the offer choices and the all choice option in response.
For example, in an Accom offer choice with two Accoms, return both Accoms.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Arrangement">
		<xs:annotation>
			<xs:documentation>Arrangement</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Arr_Cd"/>
				<xs:element ref="COM:Arr_Name" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Arr_Name" type="xs:string">
		<xs:annotation>
			<xs:documentation>Arrangement Name</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="JnyTyp">
		<xs:annotation>
			<xs:documentation>Journey Type for transfers, oneway or return</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="ONEWAY"/>
				<xs:enumeration value="RETURN"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Stay_Basis">
		<xs:annotation>
			<xs:documentation>Item Stay Basis</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="ONE"/>
				<xs:enumeration value="MULTIPLE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!-- definition of the stock type -->
	<xs:element name="Stock_Type">
		<xs:annotation>
			<xs:documentation>definition of the stock type. For example, R=Roundtrip, RBU=RoundtripBus, etc.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Code" type="xs:string" use="required"/>
		</xs:complexType>
		<!-- definition of the amendment_guarantee flag -->
	</xs:element>
	<xs:element name="SearchType" type="xs:string">
		<xs:annotation>
			<xs:documentation>Optional - e.g. IncTheatre - defines type of search currently on IncTheatre to include theatre prices</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Amendment_Guarantee" type="xs:boolean">
		<xs:annotation>
			<xs:documentation>if true, customer has booked an insurance (in BPCS) which allows rebookings without fees.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Item_Type">
		<xs:annotation>
			<xs:documentation>User definable code which states what type of set this is e.g. Tickets, sports, treatment etc.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Item_Type_Desc" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="COM:Locale"/>
							<xs:element name="Desc"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Code" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Display_Type">
		<xs:annotation>
			<xs:documentation>defines if the item shall be offered in the upselling workflow</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="SEARCH">
					<xs:annotation>
						<xs:documentation>SEARCH indicates that the item is only found if an active search for it is performed.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="ALWAYS">
					<xs:annotation>
						<xs:documentation>ALWAYS indicates that the item is found if it is actively searched and additionally in the upselling process.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Sort_Prio">
		<xs:annotation>
			<xs:documentation>Sort priority, currently not used in VRP.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="HIGH"/>
				<xs:enumeration value="MEDIUM"/>
				<xs:enumeration value="NONE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Sort_No" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Sort number, currently not used in VRP.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
    application event definition
  -->
	<xs:element name="ApplicationEvent">
		<xs:annotation>
			<xs:documentation>
        Collected application event information
      </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="id" type="xs:string">
				<xs:annotation>
					<xs:documentation>event id. Mandatory field.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="action" type="xs:string">
				<xs:annotation>
					<xs:documentation>action identification to be performed. Required information</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="consumerCode" type="xs:string">
				<xs:annotation>
					<xs:documentation>identification to be added by the consumer implementation to identify itself in case of a persistence login.
This could be e.g. the IP address of the machine persisting the event. As for a client creating the application event this is an optional
field whereas this is a mandatory field to be persisted into a storage system.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="eventType" type="xs:string">
				<xs:annotation>
					<xs:documentation>Identification of event type.
TYPE_UNKNOWN = 0
TYPE_BUSINESS_PROCESS_STARTED = 1
TYPE_BUSINESS_PROCESS_FINISHED = 2
TYPE_BUSINESS_PROCESS_FAILED = 3
TYPE_BUSINESS_PROCESS_CANCELLED = 4
TYPE_TRANSACTION_STARTED = 11
TYPE_TRANSACTION_FINISHED = 12
TYPE_TRANSACTION_FAILED = 13
TYPE_TRANSACTION_CANCELLED = 14
TYPE_DATA_SENT = 21
TYPE_DATA_RECEIVED = 22
TYPE_SINGLE_EVENT = 30
TYPE_HEART_BEAT_UPDATE_SIGNAL_EVENT = 40</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="producerCode" type="xs:string">
				<xs:annotation>
					<xs:documentation>producer of the event (e.g. fqcn class producing the event). Required field </xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="producerModule" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>name of the application module that created the event originally. This can be any String name as
long as it can be handled by the consumer (question of size) and is helpful to later identify the origin of the event.Optional field.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="producerTier" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>Tier in which the event was produced. See producer tier constants for details. This is an optional parameter.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="systemId" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>optional system id for which this event was produced</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="sequenceNo" type="xs:integer" use="optional">
				<xs:annotation>
					<xs:documentation>optional sequence identification</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="transactionId" type="xs:integer" use="optional">
				<xs:annotation>
					<xs:documentation>optional transaction id, identifying all events that belong together from a scope of different
events. E.g. inside a business request this is represented by the requestId. If the transaction id is missing component will try to
read it from thread local storage</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="transferVolumeInBytes" type="xs:integer" use="optional">
				<xs:annotation>
					<xs:documentation>known transferred volume in bytes (e.g. length of request and result string). This is an optional information</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="timeStampMillis" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>time the event occurred, is optional and will be set if necessary. We ignore the difficulty of
dealing with multiple time zones here, cause we want to measure the timespan not the absolute time which cannot be synchronized
system-wide.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--Flag to indicate that the related data is prebooking data-->
	<xs:element name="Is_Prebooking" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>Flag to indicate that the related data is prebooking data. If missing, false is assumed.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--Flag to indicate that the related product is of complex type (includes multiple services, for example complex roundtrips or acco-item-combinations -->
	<xs:element name="Is_ComplexProduct" type="xs:boolean">
		<xs:annotation>
			<xs:documentation>Flag to indicate that the related product is of complex type (includes multiple services, for example complex roundtrips or acco-item-combinations</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
    Tariff_Type element definition
  -->
	<xs:element name="Tariff">
		<xs:annotation>
			<xs:documentation>The 'Tariff' identifier</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Has_Touroperator_Restrictions" type="xs:boolean" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Flag to indicate whether tariff has any tour operator restrictions</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type" use="optional" default="TOUROPERATOR">
				<xs:annotation>
					<xs:documentation>tariff type</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="TOUROPERATOR"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Title" use="optional">
				<xs:annotation>
					<xs:documentation>tariff title</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Prd" type="COM:Prd">
		<xs:annotation>
			<xs:documentation>can be used to specify a product using product code and promotion</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Transfer_Info">
		<xs:complexType>
			<xs:sequence>
				<xs:choice>
					<xs:element name="Transfer_Code" type="xs:string">
						<xs:annotation>
							<xs:documentation>contains information about the kind of transfer that is included with a product. Currently known:
2100 no transfer incl.
2101 Bus transfer incl.
2102 [empty, do not display transfer information]
2121 flight transfer incl.
2131 Taxi transfer incl.
2141 train transfer incl.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Details">
						<xs:annotation>
							<xs:documentation>contains detailed information about an item of type transfer.</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element ref="COM:St_Dt" minOccurs="0"/>
								<xs:element name="St_Tm" type="COM:Time_Type" minOccurs="0">
									<xs:annotation>
										<xs:documentation>defines the start time of the transfer</xs:documentation>
									</xs:annotation>
								</xs:element>
								<xs:element ref="COM:DepartType" minOccurs="0">
									<xs:annotation>
										<xs:documentation>defines the start location of the transfer</xs:documentation>
									</xs:annotation>
								</xs:element>
								<xs:element ref="COM:End_Dt" minOccurs="0"/>
								<xs:element name="End_Tm" type="COM:Time_Type" minOccurs="0">
									<xs:annotation>
										<xs:documentation>defines the end/arrival time of the transfer</xs:documentation>
									</xs:annotation>
								</xs:element>
								<xs:element ref="COM:ArriveType" minOccurs="0">
									<xs:annotation>
										<xs:documentation>defines the arrival location of the transfer</xs:documentation>
									</xs:annotation>
								</xs:element>
								<xs:element ref="COM:Desc" minOccurs="0"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:choice>
				<xs:element ref="COM:Desc" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Dir" use="required">
				<xs:annotation>
					<xs:documentation>indicates the direction of the transfer</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="inbound">
							<xs:annotation>
								<xs:documentation>transfer to the accom/item</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="outbound">
							<xs:annotation>
								<xs:documentation>transfer when leaving the accom/item</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<!--
    StsExpDate definition
  -->
	<xs:element name="StsExpDate" type="xs:dateTime">
		<xs:annotation>
			<xs:documentation>State expiry date and time: Is applicable for option bookings only.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--
    to be removed, only needed for backwards compatibility to versions < 4.0.5
  -->
	<xs:element name="Item_Set_Type">
		<xs:annotation>
			<xs:documentation>User definable code which states what type of set this is e.g. Tickets, sports, treatment etc.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Sell_Type" type="xs:string" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Sell_Type, for example Land for the item set type Transport</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Code" type="xs:string" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Set_Type">
		<xs:annotation>
			<xs:documentation>The type of the item_set. Same as the Item_Set setType attribute, but for use inside the Item element</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="ADMIN"/>
				<xs:enumeration value="EXTRA"/>
				<xs:enumeration value="INSURANCE"/>
				<xs:enumeration value="INSURANCE_ADDON"/>
				<xs:enumeration value="TRANSFER"/>
				<xs:enumeration value="TRANSPORT"/>
				<xs:enumeration value="CAR"/>
				<xs:enumeration value="ALL"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!-- Group travel related information -->
	<xs:element name="Group_Travel">
		<xs:annotation>
			<xs:documentation>Group travel related information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Group_Indicator" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>a control code for a group travel group, for example Offen/GD1. Only used for group travels</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Group_Order_Code" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>an order code for a group travel order. Only used for group travels. Usually 8 numeric characters</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="Time_Type">
		<xs:annotation>
			<xs:documentation>Type for defining times in 24 hour format</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0,1,2][0-9]:[0-5][0-9]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="MktCd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Market for the Booking</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="RailRoute">
		<xs:annotation>
			<xs:documentation>Describes a route between two rail stations, either a physical route or a pricing route</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Dep_Stn" type="COM:StationType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Departure station, optional in request, compulsory in response. Request must have at least one of Dep_Stn or Arr_Stn</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Arr_Stn" type="COM:StationType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Arrival station, optional in request, compulsory in response. Request must have at least one of Dep_Stn or Arr_Stn</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type">
				<xs:annotation>
					<xs:documentation>Indicates the type or route, either "PHYSICAL" or "PRICING"</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="PHYSICAL"/>
						<xs:enumeration value="PRICING"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="StationType">
		<xs:sequence>
			<xs:element name="StnCd" type="xs:string">
				<xs:annotation>
					<xs:documentation>Station code eg. 8976</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StnName" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Station name eg. Aberdeen</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StnOperator" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Station operator eg. Great Western Railways</xs:documentation>
				</xs:annotation>
				<xs:complexType mixed="true">
					<xs:attribute name="OpCd" type="xs:string" use="required">
						<xs:annotation>
							<xs:documentation>Station operator code eg. GWR</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="RailDeparture">
		<xs:annotation>
			<xs:documentation>Describes a single rail movement</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:RailRoute" maxOccurs="2"/>
				<xs:element ref="COM:Rail_Dt_Tm" maxOccurs="2"/>
				<xs:element ref="COM:SubServPaxs" minOccurs="0"/>
				<xs:element ref="COM:Memo" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Ser_Sts" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Dep_Id" type="xs:string">
				<xs:annotation>
					<xs:documentation>Id of this departure, compulsory for response</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Dir" use="required">
				<xs:annotation>
					<xs:documentation>Direction, either "OUTBOUND" or "RETURN"</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="OUTBOUND"/>
						<xs:enumeration value="RETURN"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Rail_Dt_Tm">
		<xs:annotation>
			<xs:documentation>Date (and optional time) for rail</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Date" type="xs:date"/>
				<xs:element name="Time" type="xs:time" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="DirType">
				<xs:annotation>
					<xs:documentation>Direction type, can be ARRIVAL or DEPARTURE</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ARRIVAL">
							<xs:annotation>
								<xs:documentation>This is the flight time for the arrival</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="DEPARTURE">
							<xs:annotation>
								<xs:documentation>This is the flight time for the departure</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="RailJourney">
		<xs:annotation>
			<xs:documentation>Describes a rail journey for which a price can or has been obtained ie. single or return</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:RailDeparture" maxOccurs="2"/>
				<xs:choice>
					<xs:element ref="COM:Prom"/>
					<xs:element ref="COM:Prom_Grp"/>
				</xs:choice>
				<xs:element ref="COM:RailFare" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Prices" minOccurs="0"/>
				<xs:element name="Ref_Prd_Id" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Indicates whether the rail journey is attached to another component such as an accommodation by giving the Id of that component</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Jny_Id" type="xs:string">
				<xs:annotation>
					<xs:documentation>Journey Id, compulsory in response</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="RailFare">
		<xs:annotation>
			<xs:documentation>Describes a rail fare</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Adt_Prc" minOccurs="0"/>
				<xs:element ref="COM:Chd_Prc" minOccurs="0"/>
				<xs:element ref="COM:Inf_Prc" minOccurs="0"/>
				<xs:element name="RouteRestriction" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The route restriction eg "ANY PERMITTED"</xs:documentation>
					</xs:annotation>
					<xs:complexType mixed="true">
						<xs:attribute name="Code" type="xs:string"/>
					</xs:complexType>
				</xs:element>
				<xs:element name="TOC" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The Train Operating Company eg. Great Western Railways</xs:documentation>
					</xs:annotation>
					<xs:complexType mixed="true">
						<xs:attribute name="Code">
							<xs:annotation>
								<xs:documentation>Eg. "GWR"</xs:documentation>
							</xs:annotation>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Class">
				<xs:annotation>
					<xs:documentation>The class for this fare, can be either "FIRST" or "STANDARD". If not present in request, assume all classes</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="FIRST"/>
						<xs:enumeration value="STANDARD"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="CurISO" type="xs:string">
				<xs:annotation>
					<xs:documentation>Currency for this fare</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Search_Context">
		<xs:annotation>
			<xs:documentation>Tells the item search to base it’s search on a booking in memory.
        Will be used following an InfoBookingRequest.
      </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Ser_Id" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Ser_Id" type="xs:string" nillable="true">
		<xs:annotation>
			<xs:documentation>Service Ids of services to search for items for. An empty node can be provided which will search for items for
          all services on the booking.
      </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Policy">
		<xs:annotation>
			<xs:documentation>Details prices for Insurance Policy. (An insurance item can contain multiple policies at different prices).</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Adt_Prc" minOccurs="0"/>
				<xs:element ref="COM:Chd_Prc" minOccurs="0"/>
				<xs:element ref="COM:Inf_Prc" minOccurs="0"/>
				<xs:element ref="COM:Tot_Prc" minOccurs="0"/>
				<xs:element name="Age_Profile" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Price for an age range</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Age_From" type="xs:integer"/>
							<xs:element name="Age_To" type="xs:integer"/>
							<xs:element name="Age_Prc" type="COM:Prc_Type"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element ref="COM:Policy_No" minOccurs="0"/>
				<xs:element ref="COM:Bkg_Dt" minOccurs="0"/>
				<xs:element ref="COM:Grace_Exp_Dt" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Code" use="required">
				<xs:annotation>
					<xs:documentation>The class for this fare, can be either "FIRST" or "STANDARD". If not present in request, assume all classes</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="4"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Name" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation>Currency for this fare</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="ReturnServiceBreakDown" type="xs:boolean"/>
	<xs:element name="ServiceBreakDown">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Rates" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Rates">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:DayRates" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Code" use="required">
				<xs:annotation>
					<xs:documentation/>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="DayRates">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Price" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Id" use="required">
				<xs:annotation>
					<xs:documentation/>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="PriceDetail">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Rt_Rule"/>
				<xs:element ref="COM:Stay"/>
				<xs:element ref="COM:Matrix_Det"/>
				<xs:element ref="COM:ChdAges"/>
				<xs:element name="Prc_Edition" type="COM:Prc_Type"/>
				<xs:element ref="COM:Effective_Dt_Tm"/>
				<xs:element ref="COM:CurISO"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Rt_Rule">
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Stay">
		<xs:simpleType>
			<xs:restriction base="xs:integer"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Matrix_Det">
		<xs:complexType>
			<xs:attribute name="Code">
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Name">
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="ChdAges">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:ChdAge"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ChdAge">
		<xs:simpleType>
			<xs:restriction base="xs:integer"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Effective_Dt_Tm" type="xs:string">
		<xs:annotation>
			<xs:documentation>
      Flight time definition as local time in format xs:dateTime, like
      2008-01-01T12:00:00.000+02:00
    </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="ReqServ">
		<xs:annotation>
			<xs:documentation>Request Service</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Id" type="xs:string">
					<xs:annotation>
						<xs:documentation>Service Id from Display response</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Action">
					<xs:annotation>
						<xs:documentation>Action required ie. confirm or deny the requested service</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="CONFIRM"/>
							<xs:enumeration value="DENY"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SuppRef" type="xs:string">
					<xs:annotation>
						<xs:documentation>Supplier reference</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SuppCon" type="xs:string">
					<xs:annotation>
						<xs:documentation>Supplier contact</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Text" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Free format comment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CommType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Comms type</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="None"/>
							<xs:enumeration value="Fax"/>
							<xs:enumeration value="Email"/>
							<xs:enumeration value="Phone"/>
							<xs:enumeration value="Telex"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AgtContact">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Details" type="xs:string" minOccurs="0"/>
				<xs:element name="OverrideEmail" type="COM:Email_Type" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="LastMinuteDiscount" type="xs:boolean" default="false"/>
	<xs:element name="Adt_Fuel" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>Fuel price for adults</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Chd_Fuel" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>Fuel price for children</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Inf_Fuel" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>Fuel price for infants</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="AtcomresBkgVersion" type="xs:string">
		<xs:annotation>
			<xs:documentation>the current version of this booking in @comRes. This version string - if contained in a response - will be sent to @comRes in requests that modify the booking. If the version string in the request does not match the version that @comRes currently has, the amendment is aborted because a concurrent update is assumed.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Flt_Extra_Cat">
		<xs:annotation>
			<xs:documentation>Flight Extras Category</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Flt_Extra" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Code" use="required">
				<xs:annotation>
					<xs:documentation>Flight Extra Category Code. </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Name" type="xs:string"/>
			<xs:attribute name="Method" use="required">
				<xs:annotation>
					<xs:documentation>Method. If OTHER then passenger can book multiple otherwise the passenger can only book one of each</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="BAG"/>
						<xs:enumeration value="OTH"/>
						<xs:enumeration value="MEAL"/>
						<xs:enumeration value="SEAT"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Flt_Extra">
		<xs:annotation>
			<xs:documentation>Flight Extra</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Class" minOccurs="0"/>
				<xs:element ref="COM:Book_Mth" minOccurs="0"/>
				<xs:element ref="COM:Baggage" minOccurs="0"/>
				<xs:element name="Min_Age" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Min passenger age before this flight extra can be booked.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Max_Chd_Age" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Max Child Age for pricing this Flight extra</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Adt_Prc" minOccurs="0"/>
				<xs:element ref="COM:Chd_Prc" minOccurs="0"/>
				<xs:element ref="COM:Qty" minOccurs="0"/>
				<xs:element ref="COM:SubServPaxs" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Passengers booked on this flight extra</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Prices" minOccurs="0"/>
				<xs:element ref="COM:Composes" minOccurs="0"/>
				<xs:element ref="COM:Atol_Mth" minOccurs="0"/>
				<xs:element ref="COM:Corporate_Cd" minOccurs="0"/>
				<xs:element ref="COM:APD_Prices" minOccurs="0"/>
                <xs:element ref="COM:SrcData" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Code" type="xs:string" use="required"/>
			<xs:attribute name="Name" type="xs:string"/>
			<xs:attribute name="Selection">
				<xs:annotation>
					<xs:documentation>Selection is either MAN - Manually added to the bookingl or AUTO - Automatically added to the booking</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="MAN"/>
						<xs:enumeration value="AUTO"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Error" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>Set to true if service has an error and can not be booked</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="APD_Prices">
		<xs:annotation>
			<xs:documentation>APD Prices</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:APD_Price" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="APD_Price">
		<xs:annotation>
			<xs:documentation>APD Price</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Age_From" minOccurs="0"/>
				<xs:element ref="COM:Age_To" minOccurs="0"/>
				<xs:element ref="COM:Chd_Prc"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Age_From" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Age from</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Age_To" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Age to</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Flt_Extra_Cat_List">
		<xs:annotation>
			<xs:documentation>List of Flight Extra Categories</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Flt_Inv_Id"/>
				<xs:element ref="COM:Flt_Extra_Cat" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Ser_Sts" minOccurs="0"/>
				<xs:element ref="COM:Memo" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Flt_Extras">
		<xs:annotation>
			<xs:documentation>List of Flight Extras to Book / Booked</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Flt_Inv_Id"/>
				<xs:element ref="COM:Flt_Extra_Cat" maxOccurs="unbounded"/>
				<xs:element ref="COM:Ser_Sts" minOccurs="0"/>
				<xs:element ref="COM:Memo" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Class">
		<xs:annotation>
			<xs:documentation>Flight Extra's class</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Book_Mth">
		<xs:annotation>
			<xs:documentation>Booking method. Values are (SER - Per Service or PAX - Per Passenger)  If SER, then all passengers on the service get the extra and if PER, then each passenger on the service can have a different Extra.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="SER"/>
				<xs:enumeration value="PAX"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Flt_Inv_Id" type="xs:string">
		<xs:annotation>
			<xs:documentation>Flight Inventory ID</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Baggage">
		<xs:annotation>
			<xs:documentation>Baggage Extra</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Base_Weight" minOccurs="0"/>
				<xs:element ref="COM:Base_Pieces" minOccurs="0"/>
				<xs:element ref="COM:Max_Weight" minOccurs="0"/>
				<xs:element ref="COM:Max_Pieces" minOccurs="0"/>
				<xs:element ref="COM:Inf_Weight" minOccurs="0"/>
				<xs:element ref="COM:Max_Weight_Per_Pax" minOccurs="0"/>
				<xs:element ref="COM:Weight" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Weight">
		<xs:annotation>
			<xs:documentation>Baggage Weight in Kg</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Piece" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Cd">
				<xs:annotation>
					<xs:documentation>Weight in Kg</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Piece">
		<xs:annotation>
			<xs:documentation>price for the number of Pieces</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Cd">
						<xs:annotation>
							<xs:documentation>Number of Peices</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Base_Weight" type="xs:float">
		<xs:annotation>
			<xs:documentation>Default Baggage Weight included in flight price </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Base_Pieces" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Default number of baggage pieces included in flight price</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Max_Weight" type="xs:float">
		<xs:annotation>
			<xs:documentation>Max Weight of a single piece of baggage</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Max_Pieces" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Max number of pieces of baggage a passenger can can</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Max_Weight_Per_Pax" type="xs:float">
		<xs:annotation>
			<xs:documentation>Max baggage weight a passenger can take in total</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Inf_Weight">
		<xs:annotation>
			<xs:documentation>Infant weight</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!--Adhoc service related nodes-->
	<xs:element name="Adhoc_Ser">
		<xs:annotation>
			<xs:documentation>Wrapper containing adhoc service related information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Notify_Tp"/>
				<xs:element ref="COM:Desc" minOccurs="0"/>
				<xs:element ref="COM:Supp_Memo" minOccurs="0"/>
				<xs:element ref="COM:Clt_Dox_Txt" minOccurs="0"/>
				<xs:element ref="COM:Vchr_Txt" minOccurs="0"/>
				<xs:element ref="COM:Int_Memo" minOccurs="0"/>
				<xs:element ref="COM:Cnx" minOccurs="0"/>
				<xs:element ref="COM:Vchr_Sts">
					<xs:annotation>
						<xs:documentation>Voucher status - PROD Produce, SUPP Suppress, MUL Multiple</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Adhoc_Trv_Dox">
					<xs:annotation>
						<xs:documentation>Travel documention - STD - Standard, MAN - Manual edit</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Rate_Tp"/>
				<xs:element ref="COM:Clt_Dox">
					<xs:annotation>
						<xs:documentation>Client Dox PROD - Produce or SUP - Suppress, DEF Default</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Ntfy_Supp" minOccurs="0"/>
				<xs:element ref="COM:Act_Supp" minOccurs="0"/>
				<xs:element ref="COM:Agt_Band"/>
				<xs:element ref="COM:Ser_His" minOccurs="0"/>
				<xs:element ref="COM:Tkt_Tp" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Notify_Tp">
		<xs:annotation>
			<xs:documentation>Notify Type - NONE - None, SERP - Sell and Report, MANI - Manifest, REQ - Request</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="NONE"/>
				<xs:enumeration value="SERP"/>
				<xs:enumeration value="MANI"/>
				<xs:enumeration value="REQ"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Supp_Memo">
		<xs:annotation>
			<xs:documentation>External / supplier memo</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="0"/>
				<xs:maxLength value="240"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Int_Memo">
		<xs:annotation>
			<xs:documentation>Internal memo</xs:documentation>
		</xs:annotation>
