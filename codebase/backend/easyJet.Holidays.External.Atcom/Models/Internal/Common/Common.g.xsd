		<xs:annotation>
			<xs:documentation>Exchange rate</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Pay_Group">
		<xs:annotation>
			<xs:documentation>Pay group</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Code" type="xs:string"/>
			<xs:attribute name="Name" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Pay_Method">
		<xs:annotation>
			<xs:documentation>Pay method</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Code" type="xs:string"/>
			<xs:attribute name="Name" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Settle_Method">
		<xs:annotation>
			<xs:documentation>settlement method,
				Values X - Default,
				N - Payment has been authorised but not yet confirmed
				Y – Payment has been confirmed (for the two step Authorisation and
					Confirmation logic)
				U – Indicates CCA payment logic not used to take payments
				L – External card payments, including TOSCA payments and payments
					taken via the Data Hub ‘Payment Data’ request
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="X"/>
				<xs:enumeration value="N"/>
				<xs:enumeration value="Y"/>
				<xs:enumeration value="U"/>
				<xs:enumeration value="L"/>
				<xs:enumeration value=""/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Recon_Type">
		<xs:annotation>
			<xs:documentation>
				Values CARD – Card, CASH – Cash, BSC – BS Cheque, VOU – Voucher
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="CARD"/>
				<xs:enumeration value="CASH"/>
				<xs:enumeration value="BSC"/>
				<xs:enumeration value="BS"/>
				<xs:enumeration value="VOU"/>
				<xs:enumeration value=""/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Recon_Method">
		<xs:annotation>
			<xs:documentation>
				Values MAN - Manual, AUTO - Auto
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="MAN"/>
				<xs:enumeration value="AUTO"/>
				<xs:enumeration value=""/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Recon_Reason_Note" type="xs:string"/>
	<xs:element name="Pay_Type_Code" type="xs:string"/>
