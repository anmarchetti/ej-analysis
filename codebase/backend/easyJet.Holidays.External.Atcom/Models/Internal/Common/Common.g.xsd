	</xs:element>
	<xs:element name="Atol_Prot_Tp">
		<xs:annotation>
			<xs:documentation>Atol Protection Type. Value  PKG  Package,  FOP Flight Only Plus, FO Flight Only, NONE</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="PKG"/>
				<xs:enumeration value="FOP"/>
				<xs:enumeration value="FO"/>
				<xs:enumeration value="NONE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Atol_Prot_By">
		<xs:annotation>
			<xs:documentation>Atol Protection By.  Values : TO Tour Operator ,  , RETL Retail , 3RD  3rd Party Supplier, NONE</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="TO"/>
				<xs:enumeration value="RETL"/>
				<xs:enumeration value="3RD"/>
				<xs:enumeration value="NONE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Atol_Prot_Issuer">
		<xs:annotation>
			<xs:documentation>Atol Protection Issuer. Values : TO Tour Operator ,  , RETL Retail, NONE</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="TO"/>
				<xs:enumeration value="RETL"/>
				<xs:enumeration value="NONE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Atol_Mth">
		<xs:annotation>
			<xs:documentation>Atol Method - APP - Apply, NONE - None</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="APP"/>
				<xs:enumeration value="NONE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Incident_Sts">
		<xs:annotation>
			<xs:documentation>Incident Status
			NA - Not Applicable -- either
				a. No incidents added to reservation
				b. The last status of every incident was set to Closed

			OP - Open -- The last status of any incident on the reservation was NOT set to Closed
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="NA"/>
				<xs:enumeration value="OP"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
