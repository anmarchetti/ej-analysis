		<xs:annotation>
			<xs:documentation>External accommodation name as used by Bed Bank</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Ext_Rm_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>External Room Code as used by Bed Bank</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Ext_Rm_Name" type="xs:string">
		<xs:annotation>
			<xs:documentation>External Room description as used by Bed Bank</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Ext_BB_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>External Board basis Code as used by Bed Bank</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Ext_BB_Name" type="xs:string">
		<xs:annotation>
			<xs:documentation>External Board Basis name as used by Bed Bank</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Rate_Sell_Cur">
		<xs:annotation>
			<xs:documentation>Rate in Selling Currency</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Contract">
		<xs:annotation>
			<xs:documentation>Contract details container</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Commitment_Tp" minOccurs="0"/>
				<xs:element ref="COM:Source_Cost_Tp" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Cd"/>
			<xs:attribute name="Version"/>
			<xs:attribute name="UniqueRef"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Commitment_Tp">
		<xs:annotation>
			<xs:documentation>
				Contract Commitment Type. One of:
				FC - Full Commitment
				NC - No Commitment
				PC - Partial Commitment
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="FC"/>
				<xs:enumeration value="NC"/>
				<xs:enumeration value="PC"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Source_Cost_Tp" type="xs:string">
		<xs:annotation>
			<xs:documentation>Source Cost Type</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Override_Occ_Check" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>Override Occupancy checks. If the passengers assign to room don't meet the occupancy criteria, still allow to book</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Ext_Baggage">
		<xs:annotation>
			<xs:documentation>External flight Baggage container</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Baggage_Cd"/>
				<xs:element ref="COM:Pax_Id_List" minOccurs="0">
					<xs:annotation>
						<xs:documentation>List of passengers who have booked the default baggage. If missing, then no default baggage has been booked</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Baggage_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Baggage code e.g. HLO - Hand luggage Only, DEF - Default Baggage</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Pax_Id_List">
		<xs:annotation>
			<xs:documentation>List of passnegers who have booked the default baggage</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Pax_Id" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="PNR_Contact_Num">
		<xs:annotation>
			<xs:documentation>Mobile number that is added to the PNR</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Num" type="xs:string">
					<xs:annotation>
						<xs:documentation>Number - The number of this phone number.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AutoCancel">
		<xs:annotation>
			<xs:documentation>
				Auto cancel flag
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:AutoCancel_Date" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
							Optional , auto cancel date
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Status">
				<xs:simpleType>
					<xs:annotation>
						<xs:documentation>
							Auto cancel status
							HOLD - On Hold
							O/S - Outstanding
						</xs:documentation>
					</xs:annotation>
					<xs:restriction base="xs:string">
						<xs:enumeration value="HOLD"/>
						<xs:enumeration value="O/S"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="AutoCancel_Date" type="xs:dateTime">
		<xs:annotation>
			<xs:documentation>
				Auto cancel date
			</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="CheckPassengerTypes" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>If DOB changed, check if passenger types (e.g. infant, child) changed, default false</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Suppress_Service_Errors" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>For Retail Browser, flag to suppress error messages related to services, default false</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Supplier">
		<xs:annotation>
			<xs:documentation>Supplier</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Code" type="xs:string"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Agt_Mth">
		<xs:annotation>
			<xs:documentation>
				Returned if Trk@From='retailbrowser' or 'AtcomWeb'
				valid values are:
				LOC, STD, DIR, COL
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="LOC"/>
				<xs:enumeration value="STD"/>
				<xs:enumeration value="DIR"/>
				<xs:enumeration value="COL"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Rate_Full_Fare_Pay_Pax_Qty" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Rate Full Fare Paying Pax Quantity</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Rate_Full_Fare_Pay_Pax_Fg">
		<xs:annotation>
			<xs:documentation>
				Rate Full Fare Paying Pax Flag. One of:
				P = Per Person
				R = Per Room
				N = Not a Full Fare Paying Pax
			</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="P"/>
				<xs:enumeration value="R"/>
				<xs:enumeration value="N"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>
