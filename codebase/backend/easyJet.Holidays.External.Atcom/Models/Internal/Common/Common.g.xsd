			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Pay_Mth">
						<xs:annotation>
							<xs:documentation>L if a  Lodge Card was used to pay for the 3rd party flight.
			 V if a Virtual Card was used to pay for the 3rd party flight
		</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:enumeration value="L"/>
								<xs:enumeration value="V"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="Virt_Card_Tp" type="xs:string">
						<xs:annotation>
							<xs:documentation>Virtual Card Type. Only present if Pay_Mth = 'V'</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Card_No" type="xs:string">
						<xs:annotation>
							<xs:documentation>Card number uused to pay by.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Card_Name" type="xs:string">
						<xs:annotation>
							<xs:documentation>card holder's name</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ByPass_Ext" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>Bypass the booking of the service in the external system. default is false.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Comparison_Price">
		<xs:annotation>
			<xs:documentation>Total price of the service in another currency</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:CurISO"/>
				<xs:element ref="COM:Amt"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Facility_List">
		<xs:annotation>
			<xs:documentation>List of Room Facilities</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Facility" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Facility">
		<xs:annotation>
			<xs:documentation>Single Room Facility</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Code"/>
			<xs:attribute name="Name"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Locked_User_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Last user who locked / unlocked the reseravtion</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Locked_Date" type="xs:dateTime">
		<xs:annotation>
			<xs:documentation>date / Time the booking was locked or unlocked</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Reservation_Locked">
		<xs:annotation>
			<xs:documentation>Information about wthere or not a reservation is locked or not</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence minOccurs="0">
				<xs:annotation>
					<xs:documentation>When locking / unlocking, only need status</xs:documentation>
				</xs:annotation>
				<xs:element ref="COM:Locked_Date"/>
				<xs:element ref="COM:Locked_User_Cd"/>
			</xs:sequence>
			<xs:attribute name="Sts" default="UNLOCKED">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="LOCKED"/>
						<xs:enumeration value="UNLOCKED"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="RouteCd">
		<xs:annotation>
			<xs:documentation>Route code consisting of the departure airport/arrival airport + flight sequence character information.
         If possible, this information is to be re-send in booking requests.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="COM:RouteCd"/>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Dep_Air_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Departure airport 3 letter code:IATA specific 3 letter code for the departure airport of this route.
        City as well as station codes are not acceptable in this field. See e.g. http://www.airlinecodes.co.uk/</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Arr_Air_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Arrival Airport 3 LC - IATA specific 3 letter code for the arrival airport of this route.
        City as well as station codes are not acceptable in this field. See e.g. http://www.airlinecodes.co.uk/</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="BkgId" type="xs:string">
		<xs:annotation>
			<xs:documentation>unique id for booking inside the system. Can be left empty inside an InfoBooking and a BookingRequest.
           For all requests and responses that refer to an already existing booking this id must be filled.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="FirstName" type="xs:string">
		<xs:annotation>
			<xs:documentation>first name of person</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="MiddleName">
		<xs:annotation>
			<xs:documentation>Middle names</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="LastName" type="xs:string">
		<xs:annotation>
			<xs:documentation>last name/surname of person</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Title" type="xs:string">
		<xs:annotation>
			<xs:documentation>Title of this person e.g. Dr., Prof., Prof.Dr. ...</xs:documentation>
		</xs:annotation>
	</xs:element>
