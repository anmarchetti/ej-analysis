			<xs:documentation>Max mileage included</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Prc" type="COM:Prc_Type">
		<xs:annotation>
			<xs:documentation>
               Price amount applied.
             The price per passenger is (  Qty * Prc.Amt / PricePaxs.size ).
            </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Car_Rental">
		<xs:annotation>
			<xs:documentation>Car Rental Information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="COM:Offer">
					<xs:sequence>
						<xs:element ref="COM:Pickup"/>
						<xs:element ref="COM:Dropoff"/>
						<xs:element ref="COM:Prom"/>
						<xs:choice>
							<xs:element ref="COM:Free_Cars" minOccurs="0" maxOccurs="unbounded"/>
							<xs:element ref="COM:Car_Rental_Det" minOccurs="0" maxOccurs="unbounded"/>
						</xs:choice>
						<xs:element ref="COM:Ref_Prd_Id" minOccurs="0"/>
						<xs:element ref="COM:Atol_Mth" minOccurs="0"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Time" type="xs:time">
		<xs:annotation>
			<xs:documentation>Time</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Inv_Min_Chd_Age" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Min child inventory age</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Inv_Max_Chd_Age">
		<xs:annotation>
			<xs:documentation>Max child inventory age</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Prc_Min_Chd_Age" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Min child price age</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Prc_Max_Chd_Age">
		<xs:annotation>
			<xs:documentation>Max child price age</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Free_Car_Rental_Poss" type="xs:boolean">
		<xs:annotation>
			<xs:documentation>Free Car rental may be possible for this accommodation</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Car_Type">
		<xs:annotation>
			<xs:documentation>Car Type</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Code" type="xs:string">
						<xs:annotation>
							<xs:documentation>Car type Code</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Name" type="xs:string">
						<xs:annotation>
							<xs:documentation>Car Type name</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Car_Sub_Type">
		<xs:annotation>
			<xs:documentation>Car Sub Type</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Code"/>
					<xs:attribute name="Name"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Free_Cars">
		<xs:annotation>
			<xs:documentation>List of Free cars and upgrades from the free cars</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Car_Rental_Det" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="Sequence" use="required">
				<xs:annotation>
					<xs:documentation>1 = 1st free car, 2 = 2nd free car etc.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:minInclusive value="1"/>
						<xs:maxInclusive value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Car_Rental_Det">
		<xs:annotation>
			<xs:documentation>Car Rental Details</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Car"/>
				<xs:element ref="COM:Car_Type" minOccurs="0"/>
				<xs:element ref="COM:Car_Sub_Type" minOccurs="0"/>
				<xs:element ref="COM:CDW" minOccurs="0"/>
				<xs:element ref="COM:PAI" minOccurs="0"/>
				<xs:element ref="COM:Loc_Tax" minOccurs="0"/>
				<xs:element ref="COM:Min_Age" minOccurs="0"/>
				<xs:element ref="COM:Max_Mileage" minOccurs="0"/>
				<xs:element ref="COM:Seats" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number of seats in the car</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Prc" minOccurs="0"/>
				<xs:element ref="COM:Main_Driver" minOccurs="0"/>
				<xs:element ref="COM:Named_Driver" minOccurs="0"/>
				<xs:element ref="COM:SubServPaxs" minOccurs="0"/>
				<xs:element ref="COM:Prices" minOccurs="0"/>
				<xs:element ref="COM:Adhoc_Ser" minOccurs="0"/>
				<xs:element ref="COM:Ext_Ref_Id" minOccurs="0"/>
				<xs:element ref="COM:Free_Car" minOccurs="0"/>
				<xs:element ref="COM:Ser_Sts" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="COM:Corporate_Cd" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Base_Prd">
		<xs:annotation>
			<xs:documentation>Base product. Accom code offering free car</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Prd_Cd"/>
				<xs:element ref="COM:Prom"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="FeeAmt">
		<xs:annotation>
			<xs:documentation>Credit card fee</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="-?\d{1,7}.\d{2}|.{0}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Source">
		<xs:annotation>
			<xs:documentation>Source Code</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Cd" type="xs:string"/>
					<xs:attribute name="Name" type="xs:string"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Sub_Source">
		<xs:annotation>
			<xs:documentation>Sub Source Code</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Cd" type="xs:string"/>
					<xs:attribute name="Name" type="xs:string"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Ser_His">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Bkg_Dt_Tm"/>
				<xs:element ref="COM:Bkg_User"/>
				<xs:element ref="COM:Bkg_Agt_Cd" minOccurs="0"/>
				<xs:element ref="COM:Amd_Dt_Tm" minOccurs="0"/>
				<xs:element ref="COM:Amd_User" minOccurs="0"/>
				<xs:element ref="COM:Amd_Agt_Cd" minOccurs="0"/>
				<xs:element ref="COM:Cnx_Dt_Tm" minOccurs="0"/>
				<xs:element ref="COM:Cnx_User" minOccurs="0"/>
				<xs:element ref="COM:Cnx_Agt_Cd" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Tkt_Tp">
		<xs:annotation>
			<xs:documentation>Ticket Type</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Alt_Sup_Ref">
		<xs:annotation>
			<xs:documentation>Alternative Supplier Reference number</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Route_Cat">
		<xs:annotation>
			<xs:documentation>Route Category</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Code"/>
					<xs:attribute name="Name"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Ref_Prd_Id" type="xs:integer">
		<xs:annotation>
			<xs:documentation>Link current service to parent service</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Free_Chd_Poss" type="xs:boolean">
		<xs:annotation>
			<xs:documentation>Free Child place may be possible</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Annual_Insurance" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>Annual insurance indicator</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Prd_Cd_3rdPty" type="xs:string">
		<xs:annotation>
			<xs:documentation>3rd party product code</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Supp_Pay_Sched">
		<xs:annotation>
			<xs:documentation>Supplier Payment Schedule</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Dpt"/>
				<xs:element ref="COM:Supp_Bal"/>
				<xs:element ref="COM:TO_Comm_Amt" minOccurs="0"/>
				<xs:element name="Vat_On_Comm" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Vat on Commission</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Calc_Supp_Pay_Sched">
		<xs:annotation>
			<xs:documentation>CFalculated Supplier Payment Schedule</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Dpt"/>
				<xs:element ref="COM:Supp_Bal"/>
				<xs:element name="TO_Comm_Amt" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Tour Operator Commission amount</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Vat_On_Comm" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Vat on Commission</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Supp_Bal">
		<xs:annotation>
			<xs:documentation>Suppler balance </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:CurISO" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Currency to be applied
      </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Amt" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Amount to be paid to Supplier</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="COM:Due_Dt" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Calc_PayData">
		<xs:annotation>
			<xs:documentation>Calculated dep and balance due dates and amounts</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Dpt" minOccurs="0" maxOccurs="2"/>
				<xs:element ref="COM:Bkg_Prc_Inc"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Fast_Seller" default="S">
		<xs:annotation>
			<xs:documentation>Fast Seller  F= Fast, S = Slow</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="F"/>
				<xs:enumeration value="S"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Status">
		<xs:annotation>
			<xs:documentation>Status</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Free_Car" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>Free Car Indicator</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Bkg_Level_Discount" type="xs:string">
		<xs:annotation>
			<xs:documentation>Information about a tactical discount that may be applied to teh booking</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Pending" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>If true, then amendment / canx fee applied to current transaction</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Retain_Insurance" type="xs:boolean" default="true">
		<xs:annotation>
			<xs:documentation>retain the cancelled insurance service. Default is true </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="MultiCentre">
		<xs:annotation>
			<xs:documentation>Multi Centre</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="COM:Offer">
					<xs:sequence>
						<xs:element ref="COM:MC_Prd"/>
						<xs:element ref="COM:Rm_Cd" maxOccurs="unbounded"/>
						<xs:element ref="COM:Offer_Choice" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element ref="COM:Routing_Id" minOccurs="0"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Prc_Mth" default="PP">
		<xs:annotation>
			<xs:documentation>Price method - PP Per person, RM - Room Price</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="PP"/>
				<xs:enumeration value="PR"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Cycle_Dt">
		<xs:annotation>
			<xs:documentation>Flight Cycle Date in format YYYY-MM-DD</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Insurance_Answers">
		<xs:annotation>
			<xs:documentation>List of answers to insurance questions</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Insurance_Answer" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Insurance_Answer">
		<xs:annotation>
			<xs:documentation>Insurance answer</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:boolean">
					<xs:attribute name="Code" type="xs:string">
						<xs:annotation>
							<xs:documentation>Question code e.g. INS_A01</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Acc_Prc_Zero_Fg" type="xs:boolean">
		<xs:annotation>
			<xs:documentation>Accommodation service has no prices</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Acc_Cost_Zero_Fg" type="xs:boolean">
		<xs:annotation>
			<xs:documentation>Accommodation service has no costs</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="MC_Prd">
		<xs:annotation>
			<xs:documentation>Multi Centre Product</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:MC_Code"/>
				<xs:element ref="COM:Prom" minOccurs="0"/>
				<xs:element ref="COM:Itin_Cd" minOccurs="0"/>
				<xs:element ref="COM:Itin_Name" minOccurs="0"/>
				<xs:element ref="COM:St_Dt" minOccurs="0"/>
				<xs:element ref="COM:End_Dt" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Itin_Cd" type="xs:string">
		<xs:annotation>
			<xs:documentation>Multi Centre Itineray Code. ( Note this will be an ID)</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Itin_Name" type="xs:string">
		<xs:annotation>
			<xs:documentation>Multi Centre Itineray name</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="MC_Code" type="xs:string">
		<xs:annotation>
			<xs:documentation>Multi Centre Code</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Fetch_Cost" type="xs:boolean" default="false">
		<xs:annotation>
			<xs:documentation>return Costs. Used in InfoBooking Request. default is false</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Chk_Inv" type="xs:boolean" default="true">
		<xs:annotation>
			<xs:documentation>Check Inventory. Used in InfoBooking Request. Default is true</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Cost_Dt" type="xs:date">
		<xs:annotation>
			<xs:documentation>
Date when the cost was applied.
 If missing, use current date    </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Bkg_Dt" type="xs:date">
		<xs:annotation>
			<xs:documentation>Booking Date</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Grace_Exp_Dt" type="xs:date">
		<xs:annotation>
			<xs:documentation>Grace Period Expiry Date</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Policy_No" type="xs:string">
		<xs:annotation>
			<xs:documentation>Policy Number</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Composes">
		<xs:annotation>
			<xs:documentation>Flight Extra Bundle composes of</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COM:Flt_Extra" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
