	<xs:element name="Ext_Bkg_Sts">
		<xs:annotation>
			<xs:documentation>Externakl Booking status
        BOOKING - Confirmed
        OPTION - Option
        CANCELLED - Cancelled
        QUOTE - Quote
      </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="BOOKING">
					<xs:annotation>
						<xs:documentation>Depending on Res_Sts either fixed booked or on request booked.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="OPTION">
					<xs:annotation>
						<xs:documentation>Booking is to be booked as an option reservation or was booked as an option (depending on the perspective).</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="CANCELED">
					<xs:annotation>
						<xs:documentation>The booking was canceled and cannot be modified in terms of services, participants or relationships between both anymore.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="QUOTE">
					<xs:annotation>
						<xs:documentation>Internal state of @ComRes for a persistent but not reserved state of service. The allotments of the services
          are not changed for quotes.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
