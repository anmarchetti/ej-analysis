<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" 
		targetNamespace="AtComRes/ModifyMemoRequest" xmlns:ns1="AtComRes/ModifyMemoRequest" 
		xmlns:p2="AtComRes/Common"> 
		<xs:import namespace="AtComRes/Common" schemaLocation="../Common/Common.xsd"/>

  <xs:element name="ModifyMemoRequest">
    <xs:annotation>
        <xs:documentation>Request to modify the booking memos of a packagetour booking.</xs:documentation>
    </xs:annotation>
	    <xs:complexType>
			<xs:complexContent>
				<xs:extension base="p2:AtcomresBaseRequest">
 					<xs:sequence>
 					    <xs:element ref="p2:BkgNum" minOccurs="1" maxOccurs="1">
			  				<xs:annotation>
			     				<xs:documentation>Booking to which the memos belong</xs:documentation>
			  				</xs:annotation>
						</xs:element>
					    <xs:element ref="p2:Memo" minOccurs="0" maxOccurs="unbounded">
					      	<xs:annotation>
				     			<xs:documentation>Memo information to be updated.</xs:documentation>
				  			</xs:annotation>
			   			</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
    	</xs:complexType>
  </xs:element>
</xs:schema>



