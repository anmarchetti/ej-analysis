{
  "LambdaSettings": {
    "Market": "UK",
    "Language": "en",
    "SQS": {
      "QueueUrl": "https://sqs.eu-west-1.amazonaws.com/149716644794/web-ci-cheapest-month-sync.fifo",
      "ChunkSize": 10
    }
  },
  "AWS": {
    "Region": "eu-west-1",
    "SQS": {
      "Client": {
        "Region": "eu-west-1"
      }
    },
    "Storage": {
      "Client": {
        "Region": "eu-west-1"
      }
    },
    "Routes": {
      "Tables": {
        "Dates": "web-ci-routes-date",
        "Version": "web-ci-routes-ver",
        "To": "web-ci-routes-to"
      }
    }
  },
  "Atcom": {
    "MarketBrands": {
      "defaults": {
        "Brands": {
          "UK": "F",
          "CH": "S",
          "DE": "D",
          "FR": "R"
        }
      },
      "fph": {
        "Brands": {
          "UK": "W",
          "CH": "X",
          "DE": "Y",
          "FR": "Z"
        }
      }
    }
  },
  "Language": {
    "DefaultLanguage": "en",
    "MarketMasterLanguageMap": {
      "CH": "fr-CH",
      "UK": "en",
      "DE": "de-DE",
      "FR": "fr-FR"
    },
    "MarketLanguages": {
      "UK": [
        "en"
      ]
    }
  },
  "Cache": {
    "ExpirationSeconds": {
      "MarketSettings": 3600 // 1 hour
    },
    "Buckets": {
      "MarketSettings": "MarketSettings"
    }
  },
  "CmsSettings": {
    "Host": "https://cd-ci.webdev.ejholidays.ejcloud.net/",
    "Api": {
      "DestinationCountries": "api/DestinationsSearch/GetAllCountries",
      "Airports": "api/Airports/Get",
      "GetAllMarketSettings": "api/SiteSettings/GetAllMarketSettings",
      "GetTopByAirportCodes": "api/DestinationsSearch/GetDestinationsByAirportCodes"
    },
    "ContentPath": {
      "MapsInfo": "{site}/Data/Maps/Maps Info",
      "FilterSettings": "{site}/Settings/Filter Settings",
      "PriceJumpSettings": "{site}/Settings/Price Jump Settings",
      "SponsoredHotelsSettings": "{site}/Settings/Sponsored Hotels",
      "OtherRoutesSettings": "{site}/Settings/Other Routes Settings",
      "SmartSeerSettings": "{site}/Settings/SmartSeer",
      "DiscountSettings": "{site}/Settings/Discount Settings",
      "LockedAccountSettings": "{site}/Settings/Locked Account Settings",
      "SpecialRequestSettings": "{site}/Settings/Special Request Settings",
      "CreditBookingSettings": "{site}/Settings/Credit Booking Settings",
      "AllowedTradeAgentNamesSettings": "{site}/Settings/Allowed Trade Agent Names Settings",
      "SessionSettings": "{site}/Settings/Session Settings",
      "Benefits": "{site}/Data/Ancillaries/Benefits",
      "AircraftTypes": "{site}/Data/Aircraft Types",
      "SeatMapSettings": "{site}/Settings/Ancillaries/Seat Map Settings",
      "AmendBookingSettings": "{site}/Settings/Amend Booking Settings",
      "PriceLimitSettings": "{site}/Settings/Price Limit Settings",
      "CustomerDetailsFormSettings": "{site}/Settings/Customer Details Form Settings",
      "PromoCodeSettings": "{site}/Settings/Promo Code Settings",
      "Luggage": "{site}/Data/Ancillaries/Luggage",
      "LuggageSettings": "{site}/Settings/Ancillaries/Luggage Settings"
    }
  },
  "EnvironmentBehaviour": {
    "MaxConnectionsPerServer": 1024,
    "ByPassServerCertificateValidation": true
  }
}