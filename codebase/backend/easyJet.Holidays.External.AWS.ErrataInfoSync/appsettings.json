{
  "Lambda": {
    "FailOnEmptyErrata": false,
    "AwsSecretManagerServiceUrl": "https://secretsmanager.eu-west-1.amazonaws.com",
    "AtcomDbSecretName": "Web/Atcom/PPD/Db",
    "RawLanguageMap": "EN:en;FR:fr-CH;DE:de-CH"
  },
  "Aws": {
    "Storage": {
      "Client": {
        "Region": "eu-west-1"
      },
      "Tables": {
        "ErrataInfo": "web-ci-hotel-errata",
        "FlightErrataInfo": "web-ci-flight-errata"
      }
    },
    "Errata": {
      "ChunkSize": 25,
      "ChunkDelayMs": 50,
      "LanguageMap": {
        // to be filled from Lambda.RawLanguageMap, due to the types mismatching left and right in the legacy code.
      }
    }
  },
  "Cache": {
    "WaitLockTimeoutMilliSeconds": 30000,
    "ExpirationSeconds": {
      "GetDestinationsByCodes": 3600 // 1 hour
    },
    "Buckets": {
      "GetDestinationsByCodes": "GetDestinationsByCodes"
    }
  },
  "AtcomDb": {
    "ConnectionString": "stored in secrets manager"
  },
  "Cms": {
    "Host": "https://cd-ci.webdev.ejholidays.ejcloud.net",
    "Api": {
      "DestinationCountries": "api/DestinationsSearch/GetAllCountries",
      "GetDestinationsByCodes": "api/DestinationsSearch/GetDestinationsByCodes"
    },
    "ContentPath": {}
  },
  "EnvironmentBehaviour": {
    "MaxConnectionsPerServer": 1024,
    "Performance": {
      "UseDisposableHttpClient": false
    }
  }
}
