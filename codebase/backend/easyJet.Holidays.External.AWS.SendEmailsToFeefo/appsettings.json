{
    "Logging": {
        "LogLevel": {
            "System.Net.Http.HttpClient": "Warning"
        }
    },
    "LambdaSettings": {
        "AwsSecretManagerServiceUrl": "https://secretsmanager.eu-west-1.amazonaws.com",
        "Delay": 100,
        "SampleRate": 0.2,
        "FeefoSecretName": "Web/Feefo/Api",
        "TokensTable": "web-ci-auth-token-cache"
    },
    "Csat": {
        "CsatUrl": "https://customer-data-api.webdev.ejholidays.ejcloud.net/customer/market-research"
    },
    "ApiSettings": {
        "UseVerboseHttpLogging": true
    },
    "EnvironmentBehaviour": {
        "MaxConnectionsPerServer": 1024,
        "Performance": {
            "UseDisposableHttpClient": false,
            "HotelsCacheUseSingleEntry": true
        }
    },
    "AWS": {
        "Profile": "default",
        "Storage": {
            "Client": {
                "Region": "eu-west-1"
            }
        }
    }
}