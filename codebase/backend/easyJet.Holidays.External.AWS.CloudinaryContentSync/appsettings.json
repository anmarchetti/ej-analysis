{
    "Logging": {
        "LogLevel": {
            "System.Net.Http.HttpClient": "Warning"
        }
    },
    "LambdaSettings": {
        "CloudinarySettingsName": "Web/Cloudinary/Dev",
        "AwsSecretManagerServiceUrl": "https://secretsmanager.eu-west-1.amazonaws.com"
    },
    "ApiSettings": {
        "UseVerboseHttpLogging": true
    },
    "EnvironmentBehaviour": {
        "MaxConnectionsPerServer": 1024,
        "ByPassServerCertificateValidation": true
    },
    "AWS": {
        "S3": {
            "Client": {
                "Region": "eu-west-1"
            }
        }
    }
}