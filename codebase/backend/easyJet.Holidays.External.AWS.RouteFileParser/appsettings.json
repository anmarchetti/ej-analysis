{
  "Lambda": {
    "ToTableName": "web-ci-routes-to",
    "FromTableName": "web-ci-routes-from",
    "DatesTableName": "web-ci-routes-date",
    "VersionTableName": "web-ci-routes-ver",
    "MorningFlightTime": 500,
    "SettingsUri": "https://cd-ci.webdev.ejholidays.ejcloud.net/api/SiteSettings/GetAllMarketSettings" // refactor to use standard CMS settings
  },
  "AWS": {
    "Storage": {
      "Client": {
        "Region": "eu-west-1"
      }
    }
  },
  "EnvironmentBehaviour": {
    "Performance": {
      "UseDisposableHttpClient": false
    }
  },
  "Cms": {
    "Api": {
      "Headers": {
        "User-Agent": "HolidaysRouteFileParserAWSLambda/1.0"
      },
      "TimeoutMilliSeconds": 100000
    }
  }
}
