{
  "Lambda": {
    "Table": {
      "TableName": "web-book-live-price",
      "Region": "eu-west-1",
      "ChunkSize": 25
    },
    "RecordExpiryDays": 10
  },
  "AWS": {
    "Storage": {
      "Client": {
        "Region": "eu-west-1"
      }
    },
    "S3": {
      "Buckets": {
        "TouristTaxRules": "ejh-web-dev-tourist-tax-rules"
      }
    }
  },
  "EnvironmentBehaviour": {
    "MaxConnectionsPerServer": 1024,
    "Performance": {
      "FacilitiesFilterDisabled": false,
      "UseDisposableHttpClient": true
    }
  },
  "Atcom": {
    "TimeoutMilliSeconds": 100000,
    "DuplicationBoardSuffix": "-",
    "Booking": {
      "Host": "https://fake-host.com",
      "BaseUrl": "/fake_section"
    },
    "Search": {
      "Uk": {
        "Host": "https://ezy-tst-cac.atcoretec.com",
        "BaseUrl": "/ezytstuk/avcache3_g"
      },
      "Ch": {
        "Host": "https://ezy-tst-cac.atcoretec.com",
        "BaseUrl": "/ezytstch/avcache3_g"
      },
      "De": {
        "Host": "https://ezy-tst-cac.atcoretec.com",
        "BaseUrl": "/ezytst/de/avcache3_g"
      },
      "Fr": {
        "Host": "https://ezy-tst-cac.atcoretec.com",
        "BaseUrl": "/ezytst/fr/avcache3_g"
      }
    },
    "EndpointTemplate": {
      "Search": "s_tp=3&h_tp=P&tpf=Y&direct=N&names=1&fc_pp=N&{0}&cty=1&paylocal=D",
      "BrandParam": "brnd={0}",
      "NRefParam": "nref={0}"
    },
    "MarketBrands": {
      "defaults": {
        "Brands": {
          "UK": "F",
          "CH": "S",
          "DE": "D",
          "FR": "R"
        }
      },
      "fph": {
        "Brands": {
          "UK": "W",
          "CH": "X",
          "DE": "Y",
          "FR": "Z"
        }
      }
    },
    "Transfers": {
      "Types": {
        "SyntheticNoTransfer": "DEFAULT",
        "DefaultNoTransferCode": "H",
        "Shared": [
          "S",
          "SS"
        ],
        "Private": [
          "P",
          "PP"
        ],
        "NoTransfer": [
          "H",
          "R",
          "NS",
          "NP"
        ]
      }
    },
    "RoomSystemsSettings": {
      // Priorities should contain a value, specified for DefaultSystem in order to work correctly
      "Priorities": {
        "TGX": 0,
        "Static": 1
      },
      "SystemToDiscard": "HB3"
    }
  },
  "Cache": {
    "Buckets": {
      "CMSReferenceData": "CMSReferenceData",
      "MarketSettings": "MarketSettings",
      "FacilitiesCache": "FacilitiesCache",
      "SearchCache": "SearchCache",
      "CmsGiataMappings": "CmsGiataMappings",
      "PromotionCollections": "PromotionCollections",
      "CmsHotels": "CmsHotels",
      "TouristTaxRules": "TouristTaxRules",
      "ExchangeRates": "ExchangeRates",
      "Luggage": "Luggage"
    },
    "ExpirationSeconds": {
      "CMSReferenceData": 3600,
      "MarketSettings": 3600,
      "FacilitiesCache": 3600,
      "SearchCache": 3600,
      "CmsGiataMappings": 3600,
      "PromotionCollections": 3600,
      "CmsHotels": 3600,
      "TouristTaxRules": 3600,
      "ExchangeRates": 3600,
      "Luggage": 300
    }
  },
  "Cms": {
    "Host": "https://cd-ci.webdev.ejholidays.ejcloud.net",
    "Api": {
      "Headers": {
        "User-Agent": "HolidaysLivePriceSyncAWSLambda/1.0"
      },
      "GetAccommodationCodeToGiataMapping": "api/ReferenceData/GetAccommodationToGiataMapping",
      "GetAllMarketSettings": "api/SiteSettings/GetAllMarketSettings",
      "GetAllThemes": "api/ReferenceData/GetHotelThemes",
      "Content": "api/Content/ByPath",
      "GetLuggage": "api/Luggage/Get",
      "GetLivePrice": "api/LivePrice/Get",
      "GetAllHotelCodes": "api/ReferenceData/GetAllHotelCodes",
      "GetAllFilters": "api/DestinationsSearchFilters/GetAllFilters",
      "Transfers": "api/ReferenceData/GetAllTransfers",
      "TimeoutMilliSeconds": 100000
    },
    "ContentPath": {
      "PriceLimitSettings": "{site}/Settings/Price Limit Settings",
      "Luggage": "{site}/Data/Ancillaries/Luggage",
      "LuggageSettings": "{site}/Settings/Ancillaries/Luggage Settings",
      "DiscountSettings": "{site}/Settings/Discount Settings",
      "ComplimentarySettings": "{site}/Settings/Ancillaries/Complimentary Settings",
      "PromotionsCollectionsConfig": "{site}/Data/Promotion Collections",
      "TouristTaxSettings": "{site}/Settings/Tourist Tax Settings"
    }
  },
  "Search": {
    "DefaultFlexibleDays": 3,
    "SerchTypes": [
      {
        "Key": "Normal",
        "Value": "S"
      }
    ]
  },
  "Language": {
    "DefaultLanguage": "en",
    "MarketMasterLanguageMap": {
      "CH": "fr-CH",
      "UK": "en",
      "DE": "de-DE",
      "FR": "fr-FR"
    },
    "MarketLanguages": {
      "CH": [
        "fr-CH",
        "de-CH"
      ],
      "UK": [
        "en"
      ],
      "DE": [
        "de-DE"
      ],
      "FR": [
        "fr-FR"
      ]
    }
  }
}
