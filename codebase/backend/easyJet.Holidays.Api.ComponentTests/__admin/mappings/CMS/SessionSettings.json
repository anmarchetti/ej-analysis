{
    "Title": "Session settings: /api/content/bypath",
    "Request": {
        "Path": {
            "Matchers": [
                {
                    "Name": "WildcardMatcher",
                    "Pattern": "/api/content/bypath",
                    "IgnoreCase": true
                }
            ]
        },
        "Params": [
            {
                "Name": "path",
                "Matchers": [
                    {
                        "Name": "WildcardMatcher",
                        "Pattern": "{site}/Settings/Session Settings"
                    }
                ]
            }
        ],
        "Methods": [ "Get" ]
    },
    "Response": {
        "Headers": { "Content-Type": "application/json; charset=utf-8" },
        "StatusCode": 200,
        "BodyAsJson": {
            "SessionTimeout": "45",
            "TimerPopupTimeout": "10"
        }
    }
}