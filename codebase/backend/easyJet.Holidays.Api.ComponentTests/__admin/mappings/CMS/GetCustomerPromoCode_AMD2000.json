{
    "Title": "Customer promocode for AMD2000",
    "Request": {
        "Path": {
            "Matchers": [
                {
                    "Name": "WildcardMatcher",
                    "Pattern": "/api/Promotion/GetCustomerPromoCode",
                    "IgnoreCase": true
                }
            ]
        },
        "Body": {
            "Matcher": {
                "Name": "ExactMatcher",
                "Pattern": "AtcomPromoCode=AMD2000&MarketCode=UK"
            }
        },
        "Methods": [ "Post" ]
    },
    "Response": {
        "Headers": { "Content-Type": "application/json; charset=utf-8" },
        "StatusCode": 200,
        "BodyAsJson": "AMD"
    }
}
