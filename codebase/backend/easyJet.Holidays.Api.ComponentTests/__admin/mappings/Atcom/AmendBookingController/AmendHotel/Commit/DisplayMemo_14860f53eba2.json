{
    "Title": "Display memo response mapping.",
    "Request": {
        "Path": {
            "Matchers": [
                {
                    "Name": "WildcardMatcher",
                    "Pattern": "/EZYDMO/VRPWebservice/AniteGateway/AniteGateway.aspx",
                    "IgnoreCase": true
                }
            ]
        },
        "Body": {
            "Matcher": {
                "Name": "XPathMatcher",
                "Pattern": "/*:DisplayMemoRequest/*:BkgNum/*:BkgId[text()='14860f53eba2']"
            }
        },
        "Methods": ["Post"]
    },
    "Response": {
        "Headers": { "Content-Type": "text/xml; charset=utf-8" },
        "StatusCode": 200,
        "BodyAsFile": "__admin/files/Atcom/AmendController/AmendHotel/Commit/DisplayMemo_{{XPath.SelectNode request.body \"/*:DisplayMemoRequest/*:BkgNum/*:BkgId/text()\"}}.xml",
        "UseTransformer": true,
        "UseTransformerForBodyAsFile": true
    }
}
