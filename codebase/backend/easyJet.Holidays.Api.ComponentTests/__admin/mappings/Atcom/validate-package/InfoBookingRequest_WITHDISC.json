{
    "Title": "InfoBookingRequest successfull response for WITHDISC(with discount)",
    "Request": {
        "Path": {
            "Matchers": [
                {
                    "Name": "WildcardMatcher",
                    "Pattern": "/EZYDMO/VRPWebservice/AniteGateway/AniteGateway.aspx",
                    "IgnoreCase": true
                }
            ]
        },
        "Body": {
            "Matcher": {
                "Name": "XPathMatcher",
                "Pattern": "//*:Acc_Cd/text()='WITHDISC' and //*:Disc_Code/text()='SUN50'"
            }
        },
        "Methods": [ "Post" ]
    },
    "Response": {
        "Headers": { "Content-Type": "text/xml; charset=utf-8" },
        "StatusCode": 200,
        "BodyAsFile": "__admin/files/Atcom/InfoBookingResponse_WITHDISC.xml"
    }
}
