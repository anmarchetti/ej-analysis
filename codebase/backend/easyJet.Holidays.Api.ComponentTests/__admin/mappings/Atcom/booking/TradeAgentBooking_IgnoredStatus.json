{
    "Title": "Valid DisplayResponse for trade agent with status, that is ignored by settings (have a look at appsettings.json)",
    "Request": {
        "Path": {
            "Matchers": [
                {
                    "Name": "WildcardMatcher",
                    "Pattern": "/EZYDMO/VRPWebservice/AniteGateway/AniteGateway.aspx",
                    "IgnoreCase": true
                }
            ]
        },
        "Body": {
            "Matcher": {
                "Name": "XPathMatcher",
                "Pattern": "/*:DisplayRequest/*:BkgNum/*:BkgId/text()='IgnoredBySettings'"
            }
        },
        "Methods": [ "Post" ]
    },
    "Response": {
        "Headers": { "Content-Type": "text/xml; charset=utf-8" },
        "StatusCode": 200,
        "BodyAsFile": "__admin/files/Atcom/TradeAgentBooking_IgnoredStatus.xml"
    }
}