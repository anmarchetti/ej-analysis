{
  "Title": "auth token for feefo requests",
  "Request": {
    "Path": {
      "Matchers": [
        {
          "Name": "WildcardMatcher",
          "Pattern": "/api/oauth/v2/token",
          "IgnoreCase": true
        }
      ]
    },
    "Methods": [ "Post" ]
  },
  "Response": {
    "Headers": { "Content-Type": "text/xml; charset=utf-8" },
    "StatusCode": 200,
    "BodyAsJson": {
      "access_token": "some.Token.forTesting",
      "expires_in": 36000,
      "token_type": "bearer"
    }
  }
}
