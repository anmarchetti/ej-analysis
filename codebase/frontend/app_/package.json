  "scripts": {
    "lint": "eslint src scripts",
    "lint:errors": "eslint src scripts --quiet",
    "lint:ci": "eslint --output-file eslint_report.json --format json src scripts",
    "bootstrap": "ts-node --project tsconfig.scripts.json scripts/bootstrap.ts",
    "scaffold": "ts-node --project tsconfig.scripts.json scripts/scaffold-component.ts",
    "build": "npm run bootstrap && next build",
    "build:production": "npm run build && tsc --project tsconfig.server.json",
    "build:postbuild": "rimraf ./build && shx mkdir -p ./build && shx cp .env.octopus ./.next && shx cp -r ./.next ./build/ && shx cp package.json package-lock.json next.config.js ./build/ && cd ./build && npm ci",
    "build:postbuild-appd": "cd ./build && npm i appdynamics@24.4.1",
    "build:postbuild-cleanup": "cd ./build && rimraf ./.next/cache/* ./node_modules/@next/swc-*",
    "start:built": "cross-env NODE_ENV=production NODE_PATH=./.next NODE_EXTRA_CA_CERTS=C:/certificates/SIFRoot.cer node .next/backend/index.js",
    "start:dev": "npm run decrypt-env && npm run bootstrap && cross-env NODE_PATH=./src NODE_EXTRA_CA_CERTS=C:/certificates/SIFRoot.cer ts-node-dev --inspect=9229 --watch --project tsconfig.server.json src/backend/index.ts",
    "start:dev:watch": "npm-run-all --parallel start:dev start:watch-components",
    "start:https-proxy": "wait-port localhost:3000 && local-ssl-proxy --source 3001 --target 3000",
    "start:dev-proxy": "npm-run-all --parallel start:dev start:https-proxy",
    "start:production": "npm run decrypt-env && npm-run-all --serial build:production start:built",
    "start:watch-components": "ts-node --project tsconfig.scripts.json scripts/generate-component-factory.ts --watch",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --no-cache",
    "test:ci": "jest --ci --silent --config jest.ci.config.js",
    "typecheck": "tsc --noEmit",
    "stylelint": "npx stylelint \"**/*.scss\"",
    "decrypt-env": "node scripts/env-crypto-tool/env-crypto-tool.js decrypt",
    "encrypt-env": "node scripts/env-crypto-tool/env-crypto-tool.js encrypt"
  }
}