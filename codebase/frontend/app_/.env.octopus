# Secret token is used for Experience Editor (`/api/editing/render`)
JSS_EDITING_SECRET=#{Holidays.Web.JssEditingSecret}

# Prefix for all assets served from next.js
ASSET_PREFIX=/holidays

# Prefix for all static files served by next.js (! the real path for static files will be ASSET_PREFIX + STATIC_PREFIX)
STATIC_PREFIX=/static

# Rendering host URL used to build an absolute assetPrefix so that CSS chunks
# loaded inside Sitecore Experience Editor resolve against the correct origin.
RENDERING_HOST_URL=#{Holidays.Web.RenderingHostUrl}

# Special header for identifying whether traffic hits Blue or Green environment
X_WEB_HOST_HEADER=#{Holidays.Web.XWebHostHeader}

NEXT_IMAGE_CACHE=#{Holidays.Web.NextImageCache}

NEXTAUTH_URL=#{Holidays.Web.NextAuthUrl}

NEXTAUTH_SECRET=#{Holidays.Web.NextAuthSecret}

REDHATSSO_REDIRECT_URL=#{Holidays.Web.RedHatSsoRedirectUrl}

NEXT_PUBLIC_MEASUREMENT_ID=#{Holidays.Web.NextPublicMeasurementId}

NEXT_PUBLIC_API_SECRET=#{Holidays.Web.NextPublicApiSecret}